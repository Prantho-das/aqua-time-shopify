<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <meta name="theme-color" content="#173b57">
    <link rel="canonical" href="{{ canonical_url }}">
    
    <!-- Preconnect & Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title | replace: 'aqua-time', 'Air to Water Generators' | replace: 'Aqua-Time', 'Air to Water Generators' }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name | replace: 'aqua-time', 'Air to Water Generators' | replace: 'Aqua-Time', 'Air to Water Generators' }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Open Graph / SEO Meta -->
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | default: shop.name }}">
    <meta property="og:type" content="website">
    <meta property="og:description" content="{{ page_description | default: shop.description | escape }}">
    {%- if page_image -%}
      <meta property="og:image" content="http:{{ page_image | image_url }}">
      <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
    {%- endif -%}

    <!-- Tailwind CSS Script -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#eff9fd',
                100: '#d9f1fc',
                200: '#bae6fd',
                300: '#7dd3fc',
                400: '#43a5ff',
                500: '#088ae3',
                600: '#088ae3',
                700: '#0776c4',
                800: '#173b57',
                900: '#0e1c36',
              },
              navy: {
                800: '#173b57',
                900: '#0e1c36',
                950: '#071120',
              }
            },
            fontFamily: {
              sans: ['Plus Jakarta Sans', 'sans-serif'],
              heading: ['Outfit', 'sans-serif'],
            }
          }
        }
      }
    </script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest" defer></script>

    <!-- Theme Stylesheet -->
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="bg-white text-[#0e1c36] antialiased selection:bg-brand-600 selection:text-white">
    <a class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-white focus:text-brand-600" href="#MainContent">
      Skip to content
    </a>

    {% section 'header' %}

    <main id="MainContent" role="main" tabindex="-1"{% if request.page_type == 'policy' %} class="shopify-policy-page min-h-screen bg-[#f8fcfd] pb-16"{% endif %}>
      {% if request.page_type == 'policy' %}
        <div class="border-b border-[#d9f1fc] bg-[#f8fcfd]/70 py-3.5">
          <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center gap-2 text-xs font-semibold text-[#4a6177]">
              <a href="/" class="hover:text-[#088ae3] transition-colors">Home</a>
              <span>/</span>
              <span class="text-[#173b57] font-bold">{{ page_title }}</span>
            </div>
          </div>
        </div>
      {% endif %}
      {{ content_for_layout }}
      {% if request.page_type == 'policy' %}
        <script>
          (function() {
            var isRefund = window.location.pathname.indexOf('refund-policy') !== -1;
            if (isRefund) {
              var rte = document.querySelector('.shopify-policy__body .rte');
              if (rte && !rte.textContent.includes('Return Processing Fee')) {
                rte.innerHTML = '<h2>Warranty &amp; Refund Policy</h2>' +
                  '<h3>1. Warranty Coverage Details</h3>' +
                  '<p>Air to Water Generators stands behind the craftsmanship of every system. Your HydroCell™ unit is backed by our standard 1-Year Warranty on the whole unit, plus extended 3-Year coverage on core mechanical and refrigeration components.</p>' +
                  '<ul>' +
                  '<li><strong>Whole Unit Coverage (1 Year):</strong> Applies to all electronics, control panels, sensors, and structural housing against manufacturing flaws when operated under recommended temperature and humidity conditions.</li>' +
                  '<li><strong>Core Parts Coverage (3 Years):</strong> Covers the compressor, condenser coils, evaporator coils, internal water tanks, and circulating fans. Defective components are replaced free of charge. Diagnostic and installation labor is not included.</li>' +
                  '</ul>' +
                  '<hr>' +
                  '<h3>2. Return &amp; Refund Policy</h3>' +
                  '<p>We offer a 7-day return period for unopened units. Because atmospheric water generators are precision indoor hygiene and hydration appliances, safety regulations require specific return criteria:</p>' +
                  '<ul>' +
                  '<li><strong>Return Window:</strong> Return requests must be initiated within 7 calendar days of tracked delivery confirmation.</li>' +
                  '<li><strong>Condition:</strong> Units must be unopened, brand new in their original factory packaging with all internal foam, seals, power cords, and accessory kits intact.</li>' +
                  '<li><strong>Opened Units:</strong> Opened or water-tested units cannot be accepted for return due to sanitary and cross-contamination standards for drinking water appliances.</li>' +
                  '<li><strong>Damage on Arrival:</strong> Any transit damage or defect upon arrival must be reported within 48 hours of delivery with photos of the damaged unit and outer packaging.</li>' +
                  '<li><strong>Return Processing Fee:</strong> A return processing fee ($200 to $500 depending on model) applies to all authorized returns to cover restocking, certified inspection, and freight handling.</li>' +
                  '<li><strong>Support Response:</strong> To initiate a return, contact our support team at <a href="mailto:contact@airtowatergenerators.com">contact@airtowatergenerators.com</a> or via our <a href="/pages/contact">contact form</a>. Our team responds to all return inquiries within 1 business day with Return Merchandise Authorization (RMA) instructions.</li>' +
                  '</ul>' +
                  '<hr>' +
                  '<h3>3. Exclusions &amp; Limitations</h3>' +
                  '<p>The warranty does not cover:</p>' +
                  '<ul>' +
                  '<li>Routine consumable items, including periodic water filter replacement cartridges and UV lamps.</li>' +
                  '<li>Damage caused by accidents, unauthorized modifications, unapproved repair attempts, or outdoor exposure outside specified operating thresholds.</li>' +
                  '<li>Failure resulting from improper electrical supply, power surges, or lack of standard filter replacements as guided by on-screen maintenance notifications.</li>' +
                  '<li>Diagnostic, removal, or re-installation labor costs.</li>' +
                  '</ul>' +
                  '<hr>' +
                  '<h3>4. Contact &amp; Support</h3>' +
                  '<p>For warranty claims, parts requests, or return authorizations:</p>' +
                  '<p>' +
                  '<strong>Email:</strong> <a href="mailto:contact@airtowatergenerators.com">contact@airtowatergenerators.com</a><br>' +
                  '<strong>Mailing Address:</strong> 1401 Lavaca St, Austin, TX 78703<br>' +
                  '<strong>Contact Form:</strong> <a href="/pages/contact">https://airtowatergenerators.com/pages/contact</a>' +
                  '</p>';
              }
            }
          })();
        </script>
      {% endif %}
    </main>

    {% section 'footer' %}
    {% section 'quick-order-modal' %}

    <!-- Theme Scripts -->
    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
