<section id="contact-expert" class="py-16 sm:py-20 lg:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      
      <!-- Contact Details -->
      <div class="lg:col-span-5 space-y-8">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-widest text-[#0084d6] bg-[#e0f2fe] uppercase mb-3">
            Get In Touch
          </span>
          <h1 class="font-heading text-3xl sm:text-4xl font-extrabold text-[#0e1c36] tracking-tight">
            Talk to An Expert
          </h1>
          <p class="mt-4 text-sm text-[#596780] leading-relaxed">
            Whether you are exploring atmospheric water generation for your home, business, commercial facility, or remote off-grid operation, our dedicated technical team is here to guide you through system sizing and specifications.
          </p>
        </div>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-[#f0f9ff] text-[#0084d6] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Headquarters</span>
              <p class="font-bold text-sm text-[#0e1c36] mt-0.5">Air to Water Generators</p>
              <p class="text-xs text-[#596780]">Houston, TX, USA</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-[#f0f9ff] text-[#0084d6] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Direct Phone Support</span>
              <a href="tel:2133352121" class="font-bold text-sm text-[#0084d6] hover:underline block mt-0.5">(213) 335-2121</a>
              <span class="text-[11px] text-[#596780]">Mon–Fri: 8:00 AM – 6:00 PM CST</span>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-[#f0f9ff] text-[#0084d6] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Email Inquiries</span>
              <a href="mailto:contactus@watergen.com" class="font-bold text-sm text-[#0084d6] hover:underline block mt-0.5">contactus@watergen.com</a>
              <span class="text-[11px] text-[#596780]">Fast technical response within 24 hours</span>
            </div>
          </div>
        </div>

        <!-- Social Media Channels -->
        <div class="pt-6 border-t border-slate-100">
          <span class="text-xs font-bold text-[#0e1c36] uppercase tracking-wider block mb-3">Connect With Us</span>
          <div class="flex flex-wrap gap-2.5">
            <a href="https://www.linkedin.com/company/water-generators/" target="_blank" rel="noopener" class="px-3.5 py-1.5 rounded-lg border border-[#e1eff8] bg-[#f8fcfd] text-xs font-bold text-[#596780] hover:text-[#0084d6] hover:border-[#0084d6] transition-all">
              LinkedIn
            </a>
            <a href="https://www.facebook.com/a2watergenerators" target="_blank" rel="noopener" class="px-3.5 py-1.5 rounded-lg border border-[#e1eff8] bg-[#f8fcfd] text-xs font-bold text-[#596780] hover:text-[#0084d6] hover:border-[#0084d6] transition-all">
              Facebook
            </a>
            <a href="https://www.instagram.com/watergenerators" target="_blank" rel="noopener" class="px-3.5 py-1.5 rounded-lg border border-[#e1eff8] bg-[#f8fcfd] text-xs font-bold text-[#596780] hover:text-[#0084d6] hover:border-[#0084d6] transition-all">
              Instagram
            </a>
            <a href="https://www.tiktok.com/@watergenerators" target="_blank" rel="noopener" class="px-3.5 py-1.5 rounded-lg border border-[#e1eff8] bg-[#f8fcfd] text-xs font-bold text-[#596780] hover:text-[#0084d6] hover:border-[#0084d6] transition-all">
              TikTok
            </a>
            <a href="https://share.google/vD7mnrJa1jZeTicZO" target="_blank" rel="noopener" class="px-3.5 py-1.5 rounded-lg border border-[#e1eff8] bg-[#f8fcfd] text-xs font-bold text-[#596780] hover:text-[#0084d6] hover:border-[#0084d6] transition-all">
              Google Profile
            </a>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="lg:col-span-7">
        <div class="bg-[#f8fcfd] rounded-2xl border border-[#e1eff8] p-6 sm:p-10 shadow-sm">
          <h2 class="font-heading text-2xl font-bold text-[#0e1c36] mb-6">Send an Inquiry</h2>

          {% form 'contact', class: 'space-y-4' %}
            {% if form.posted_successfully? %}
              <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-xs font-bold">
                ✓ Thank you! Your message has been received. Our water specialist will follow up shortly.
              </div>
            {% endif %}

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-[#0e1c36] mb-1">Your Name *</label>
                <input type="text" name="contact[name]" required placeholder="John Doe" class="w-full bg-white border border-[#e1eff8] rounded-xl px-4 py-3 text-xs text-[#0e1c36] focus:outline-none focus:border-[#0084d6]">
              </div>
              <div>
                <label class="block text-xs font-bold text-[#0e1c36] mb-1">Email Address *</label>
                <input type="email" name="contact[email]" required placeholder="john@example.com" class="w-full bg-white border border-[#e1eff8] rounded-xl px-4 py-3 text-xs text-[#0e1c36] focus:outline-none focus:border-[#0084d6]">
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-[#0e1c36] mb-1">Phone Number</label>
                <input type="tel" name="contact[phone]" placeholder="(213) 000-0000" class="w-full bg-white border border-[#e1eff8] rounded-xl px-4 py-3 text-xs text-[#0e1c36] focus:outline-none focus:border-[#0084d6]">
              </div>
              <div>
                <label class="block text-xs font-bold text-[#0e1c36] mb-1">Intended Application</label>
                <select name="contact[application]" class="w-full bg-white border border-[#e1eff8] rounded-xl px-4 py-3 text-xs text-[#0e1c36] focus:outline-none focus:border-[#0084d6]">
                  <option value="Residential">Residential / Home</option>
                  <option value="Commercial">Commercial / Office</option>
                  <option value="Industrial">Industrial / Energy</option>
                  <option value="Emergency">Emergency / Off-Grid</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-[#0e1c36] mb-1">Message or Questions</label>
              <textarea name="contact[body]" rows="4" placeholder="Tell us about your water needs, daily demand, or location..." class="w-full bg-white border border-[#e1eff8] rounded-xl px-4 py-3 text-xs text-[#0e1c36] focus:outline-none focus:border-[#0084d6]"></textarea>
            </div>

            <button type="submit" class="w-full bg-[#0084d6] hover:bg-[#006bb0] text-white font-bold py-4 rounded-xl text-xs uppercase tracking-wider shadow hover:shadow-md transition-all">
              SUBMIT INQUIRY
            </button>
          {% endform %}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Expert",
  "settings": [],
  "presets": [
    {
      "name": "Contact Expert"
    }
  ]
}
{% endschema %}
