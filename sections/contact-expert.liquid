<div class="contact-page bg-white">
  
  <!-- Hero Section Header matching Case Studies & Lab Report -->
  <section class="relative bg-gradient-to-b from-[#eff9fd] via-[#f8fcfd] to-white pt-20 pb-12 sm:pt-28 sm:pb-16 text-center border-b border-[#d9f1fc]/60">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-block text-xs font-bold uppercase tracking-[0.22em] text-[#088ae3] bg-[#eff9fd] px-4 py-1.5 rounded-full mb-3">
        {{ section.settings.eyebrow | default: 'Engineering & Support Team' }}
      </span>
      <h1 class="font-heading text-3xl sm:text-5xl lg:text-6xl font-extrabold text-[#173b57] tracking-tight leading-[1.08]">
        {{ section.settings.heading | default: "We're here to help you deploy water from air." }}
      </h1>
      <p class="mt-4 sm:mt-5 text-[15px] sm:text-lg text-[#4a6177] leading-relaxed max-w-xl mx-auto">
        {{ section.settings.subheading | default: 'Whether sizing a residential unit or planning a commercial/off-grid installation, our dedicated technical team provides verified system specifications and engineering guidance.' }}
      </p>
    </div>
  </section>

  <!-- Main 2-Column Contact Suite -->
  <section class="py-12 sm:py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
        
        <!-- Left Column: Direct Channels & Trust -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="space-y-4">
            <h2 class="font-heading text-2xl font-extrabold text-[#173b57]">
              Direct Contact Channels
            </h2>
            <p class="text-sm text-[#4a6177] leading-relaxed">
              Reach our US-based atmospheric water specialists directly for quotes, system sizing, warranty assistance, or wholesale inquiries.
            </p>
          </div>

          <!-- Channel Cards -->
          <div class="space-y-4">
            
            <!-- Phone Card -->
            <div class="p-5 rounded-2xl bg-[#f8fcfd] border border-[#d9f1fc] flex items-start gap-4 hover:border-[#088ae3]/40 transition-colors">
              <div class="w-11 h-11 rounded-xl bg-[#eff9fd] text-[#088ae3] flex items-center justify-center shrink-0 mt-0.5">
                {% render 'icon', name: 'phone', class: 'w-5 h-5' %}
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-bold text-[#4a6177] uppercase tracking-wider block">Direct Phone Support</span>
                <a href="tel:2133352121" class="font-heading font-extrabold text-base sm:text-lg text-[#173b57] hover:text-[#088ae3] transition-colors block">
                  (213) 335-2121
                </a>
                <p class="text-xs text-[#4a6177]">Mon–Fri: 8:00 AM – 6:00 PM CST · Immediate assistance</p>
              </div>
            </div>

            <!-- Email Card -->
            <div class="p-5 rounded-2xl bg-[#f8fcfd] border border-[#d9f1fc] flex items-start gap-4 hover:border-[#088ae3]/40 transition-colors">
              <div class="w-11 h-11 rounded-xl bg-[#eff9fd] text-[#088ae3] flex items-center justify-center shrink-0 mt-0.5">
                {% render 'icon', name: 'mail', class: 'w-5 h-5' %}
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-bold text-[#4a6177] uppercase tracking-wider block">Email Inquiries</span>
                <a href="mailto:contactus@watergen.com" class="font-heading font-extrabold text-base text-[#173b57] hover:text-[#088ae3] transition-colors block break-all">
                  contactus@watergen.com
                </a>
                <p class="text-xs text-[#4a6177]">Guaranteed technical response within 2 business hours</p>
              </div>
            </div>

            <!-- HQ Card -->
            <div class="p-5 rounded-2xl bg-[#f8fcfd] border border-[#d9f1fc] flex items-start gap-4 hover:border-[#088ae3]/40 transition-colors">
              <div class="w-11 h-11 rounded-xl bg-[#eff9fd] text-[#088ae3] flex items-center justify-center shrink-0 mt-0.5">
                {% render 'icon', name: 'map-pin', class: 'w-5 h-5' %}
              </div>
              <div class="space-y-1">
                <span class="text-[11px] font-bold text-[#4a6177] uppercase tracking-wider block">Headquarters & Logistics</span>
                <span class="font-heading font-extrabold text-base text-[#173b57] block">Air to Water Generators</span>
                <p class="text-xs text-[#4a6177]">Houston, TX, USA · Nationwide Insured Freight Shipping</p>
              </div>
            </div>

          </div>

          <!-- Social Verification Badges -->
          <div class="pt-4 border-t border-[#d9f1fc]">
            <span class="text-xs font-bold text-[#173b57] uppercase tracking-wider block mb-3">Official Verified Profiles</span>
            <div class="flex flex-wrap gap-2">
              <a href="https://www.linkedin.com/company/water-generators/" target="_blank" rel="noopener" class="px-3.5 py-1.5 rounded-xl border border-[#d9f1fc] bg-[#f8fcfd] text-xs font-bold text-[#4a6177] hover:text-[#088ae3] hover:border-[#088ae3] transition-all">
                LinkedIn
              </a>
              <a href="https://www.facebook.com/a2watergenerators" target="_blank" rel="noopener" class="px-3.5 py-1.5 rounded-xl border border-[#d9f1fc] bg-[#f8fcfd] text-xs font-bold text-[#4a6177] hover:text-[#088ae3] hover:border-[#088ae3] transition-all">
                Facebook
              </a>
              <a href="https://www.instagram.com/watergenerators" target="_blank" rel="noopener" class="px-3.5 py-1.5 rounded-xl border border-[#d9f1fc] bg-[#f8fcfd] text-xs font-bold text-[#4a6177] hover:text-[#088ae3] hover:border-[#088ae3] transition-all">
                Instagram
              </a>
              <a href="https://share.google/vD7mnrJa1jZeTicZO" target="_blank" rel="noopener" class="px-3.5 py-1.5 rounded-xl border border-[#d9f1fc] bg-[#f8fcfd] text-xs font-bold text-[#4a6177] hover:text-[#088ae3] hover:border-[#088ae3] transition-all">
                Google Profile ↗
              </a>
            </div>
          </div>

        </div>

        <!-- Right Column: Interactive Assessment Form -->
        <div class="lg:col-span-7">
          <div class="bg-[#f8fcfd] rounded-3xl border border-[#d9f1fc] p-6 sm:p-10 shadow-sm space-y-6">
            
            <div class="space-y-2">
              <span class="inline-block text-xs font-bold uppercase tracking-wider text-[#088ae3] bg-[#eff9fd] px-3 py-1 rounded-full">
                Fast Inquiry & Assessment
              </span>
              <h3 class="font-heading text-2xl sm:text-3xl font-extrabold text-[#173b57]">
                Request a System Sizing Assessment
              </h3>
              <p class="text-xs sm:text-sm text-[#4a6177]">
                Fill out the quick form below. An engineer will analyze your location's humidity envelope and recommend the optimal model.
              </p>
            </div>

            {% form 'contact', class: 'space-y-4' %}
              {% if form.posted_successfully? %}
                <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-2xl text-xs font-bold flex items-center gap-2">
                  <span>✓</span>
                  <span>Thank you! Your assessment request has been received. An atmospheric water engineer will contact you within 2 business hours.</span>
                </div>
              {% endif %}

              {% if form.errors %}
                <div class="p-4 bg-rose-50 border border-rose-200 text-rose-700 rounded-2xl text-xs">
                  {{ form.errors | default_errors }}
                </div>
              {% endif %}

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-[#173b57] mb-1.5">Full Name *</label>
                  <input type="text" name="contact[name]" required placeholder="John Doe" class="w-full bg-white border border-[#d9f1fc] rounded-xl px-4 py-3 text-xs text-[#173b57] focus:outline-none focus:border-[#088ae3] focus:ring-1 focus:ring-[#088ae3]">
                </div>
                <div>
                  <label class="block text-xs font-bold text-[#173b57] mb-1.5">Email Address *</label>
                  <input type="email" name="contact[email]" required placeholder="john@example.com" class="w-full bg-white border border-[#d9f1fc] rounded-xl px-4 py-3 text-xs text-[#173b57] focus:outline-none focus:border-[#088ae3] focus:ring-1 focus:ring-[#088ae3]">
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-[#173b57] mb-1.5">Phone Number</label>
                  <input type="tel" name="contact[phone]" placeholder="(213) 000-0000" class="w-full bg-white border border-[#d9f1fc] rounded-xl px-4 py-3 text-xs text-[#173b57] focus:outline-none focus:border-[#088ae3] focus:ring-1 focus:ring-[#088ae3]">
                </div>
                <div>
                  <label class="block text-xs font-bold text-[#173b57] mb-1.5">Location / State *</label>
                  <input type="text" name="contact[location]" required placeholder="City, State (e.g. Austin, TX)" class="w-full bg-white border border-[#d9f1fc] rounded-xl px-4 py-3 text-xs text-[#173b57] focus:outline-none focus:border-[#088ae3] focus:ring-1 focus:ring-[#088ae3]">
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-[#173b57] mb-1.5">Intended Application</label>
                  <select name="contact[application]" class="w-full bg-white border border-[#d9f1fc] rounded-xl px-4 py-3 text-xs text-[#173b57] focus:outline-none focus:border-[#088ae3]">
                    <option>Residential / Home Kitchen</option>
                    <option>Office / Corporate Break Room</option>
                    <option>Cabin / Off-Grid Property</option>
                    <option>Emergency & Disaster Preparedness</option>
                    <option>Commercial / Institutional Facility</option>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-bold text-[#173b57] mb-1.5">Estimated Daily Demand</label>
                  <select name="contact[water_demand]" class="w-full bg-white border border-[#d9f1fc] rounded-xl px-4 py-3 text-xs text-[#173b57] focus:outline-none focus:border-[#088ae3]">
                    <option>1–5 Gallons / Day (Standard Standalone)</option>
                    <option>5–15 Gallons / Day (Multi-Unit Setup)</option>
                    <option>20–50+ Gallons / Day (Commercial Facility)</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold text-[#173b57] mb-1.5">Project Details / Questions</label>
                <textarea name="contact[body]" rows="3" placeholder="Tell us about your installation space, current water setup, or specific goals..." class="w-full bg-white border border-[#d9f1fc] rounded-xl px-4 py-3 text-xs text-[#173b57] focus:outline-none focus:border-[#088ae3] focus:ring-1 focus:ring-[#088ae3]"></textarea>
              </div>

              <button type="submit" class="w-full btn-primary py-3.5 text-xs font-bold uppercase tracking-wider shadow-lg shadow-[#088ae3]/20 flex items-center justify-center gap-2">
                <span>Submit Water Assessment Request</span>
                <span>→</span>
              </button>

              <div class="flex items-center justify-center gap-4 pt-1 text-[11px] text-[#4a6177]">
                <span>🔒 100% Confidential</span>
                <span>•</span>
                <span>Zero Obligation</span>
                <span>•</span>
                <span>Free Sizing Report</span>
              </div>
            {% endform %}

          </div>
        </div>

      </div>

      <!-- Bottom Trust Assurance Bar -->
      <div class="mt-16 pt-10 border-t border-[#d9f1fc] grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
        <div class="space-y-1">
          <span class="font-heading font-extrabold text-base text-[#173b57] block">1-Year Warranty</span>
          <p class="text-xs text-[#4a6177]">Comprehensive parts and dedicated support</p>
        </div>
        <div class="space-y-1">
          <span class="font-heading font-extrabold text-base text-[#088ae3] block">ISO 17025 Tested</span>
          <p class="text-xs text-[#4a6177]">Certified PFAS-free & mineralized alkaline</p>
        </div>
        <div class="space-y-1">
          <span class="font-heading font-extrabold text-base text-[#173b57] block">Nationwide Freight</span>
          <p class="text-xs text-[#4a6177]">Fast insured delivery to your location</p>
        </div>
        <div class="space-y-1">
          <span class="font-heading font-extrabold text-base text-[#088ae3] block">Phone Support</span>
          <p class="text-xs text-[#4a6177]">Real human assistance at (213) 335-2121</p>
        </div>
      </div>

    </div>
  </section>

</div>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Engineering & Support Team"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We're here to help you deploy water from air."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Whether sizing a residential unit or planning a commercial/off-grid installation, our dedicated technical team provides verified system specifications and engineering guidance."
    }
  ],
  "presets": [
    {
      "name": "Contact Page"
    }
  ]
}
{% endschema %}
