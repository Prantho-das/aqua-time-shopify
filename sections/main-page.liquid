<section class="main-page-section bg-white">
  
  <!-- Breadcrumb -->
  <div class="border-b border-[#d9f1fc] bg-[#f8fcfd]/70 py-3.5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-xs font-semibold text-[#4a6177]">
        <a href="/" class="hover:text-[#088ae3] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#173b57] font-bold">{{ page.title }}</span>
      </div>
    </div>
  </div>

  <!-- Page Hero Banner -->
  <div class="relative bg-gradient-to-b from-[#eff9fd] via-[#f8fcfd] to-white border-b border-[#d9f1fc] py-14 sm:py-20 overflow-hidden">
    <div class="absolute inset-0 opacity-40 pointer-events-none bg-[radial-gradient(#088ae3_1px,transparent_1px)] [background-size:24px_24px]"></div>
    
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-widest text-[#088ae3] bg-white border border-[#d9f1fc] uppercase shadow-sm">
        {{ section.settings.badge | default: "Aqua-Time Official" }}
      </span>

      <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#173b57] tracking-tight">
        {{ page.title }}
      </h1>

      {% if section.settings.subtitle != blank %}
        <p class="text-sm sm:text-base text-[#4a6177] max-w-2xl mx-auto leading-relaxed">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}
    </div>
  </div>

  <!-- Page Body Content -->
  <div class="py-12 sm:py-16 lg:py-20 bg-[#f8fcfd]/60 border-b border-[#d9f1fc]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {% if page.content != blank %}
        <div class="bg-white rounded-3xl border border-[#d9f1fc] p-8 sm:p-12 lg:p-14 shadow-sm">
          <div class="page-content-wrapper text-[#4a6177] text-sm sm:text-base leading-relaxed space-y-6">
            {{ page.content }}
          </div>
        </div>
      {% else %}
        <div class="bg-white border border-[#d9f1fc] rounded-3xl p-8 sm:p-12 text-center space-y-4 shadow-sm">
          <div class="w-14 h-14 rounded-2xl bg-[#eff9fd] text-[#088ae3] flex items-center justify-center mx-auto">
            {% render 'icon', name: 'info', class: 'w-7 h-7' %}
          </div>
          <h3 class="font-heading font-extrabold text-xl text-[#173b57]">Information Update</h3>
          <p class="text-sm text-[#4a6177] max-w-md mx-auto leading-relaxed">
            Content for this section is currently being updated. For immediate support, inquiries, or documentation, please contact our support team.
          </p>
          <div class="pt-2">
            <a href="/pages/contact" class="btn-primary inline-flex items-center gap-2 py-3 px-6 text-xs font-bold uppercase tracking-wider">
              <span>Contact Support</span>
              {% render 'icon', name: 'arrow-right', class: 'w-4 h-4' %}
            </a>
          </div>
        </div>
      {% endif %}

    </div>
  </div>

  <style>
    .page-content-wrapper h1,
    .page-content-wrapper h2,
    .page-content-wrapper h3,
    .page-content-wrapper h4 {
      color: #173b57;
      font-family: 'Outfit', sans-serif;
      font-weight: 800;
      margin-top: 1.75rem;
      margin-bottom: 0.75rem;
      line-height: 1.3;
    }
    .page-content-wrapper h2 { font-size: 1.5rem; }
    .page-content-wrapper h3 { font-size: 1.25rem; }
    .page-content-wrapper h4 { font-size: 1.1rem; }
    .page-content-wrapper p {
      margin-bottom: 1.25rem;
      line-height: 1.8;
      color: #4a6177;
    }
    .page-content-wrapper ul,
    .page-content-wrapper ol {
      margin-left: 1.5rem;
      margin-bottom: 1.25rem;
      space-y: 0.5rem;
    }
    .page-content-wrapper ul { list-style-type: disc; }
    .page-content-wrapper ol { list-style-type: decimal; }
    .page-content-wrapper li {
      margin-bottom: 0.35rem;
      color: #4a6177;
    }
    .page-content-wrapper strong {
      color: #173b57;
      font-weight: 700;
    }
    .page-content-wrapper a {
      color: #088ae3;
      text-decoration: underline;
      font-weight: 600;
    }
    .page-content-wrapper a:hover {
      color: #0776c4;
    }
    .page-content-wrapper blockquote {
      border-left: 4px solid #088ae3;
      background: #eff9fd;
      padding: 1rem 1.25rem;
      border-radius: 0 1rem 1rem 0;
      font-style: italic;
      color: #173b57;
      margin: 1.5rem 0;
    }
    .page-content-wrapper table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      border-radius: 1rem;
      overflow: hidden;
      border: 1px solid #d9f1fc;
    }
    .page-content-wrapper th,
    .page-content-wrapper td {
      padding: 0.75rem 1rem;
      border: 1px solid #d9f1fc;
      text-align: left;
    }
    .page-content-wrapper th {
      background-color: #eff9fd;
      color: #173b57;
      font-weight: 700;
    }
  </style>

</section>

{% schema %}
{
  "name": "Page Banner & Content",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Aqua-Time Official"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Official resources, verified documentation, and guidelines for atmospheric water generation."
    }
  ],
  "presets": [
    {
      "name": "Page Banner & Content"
    }
  ]
}
{% endschema %}
