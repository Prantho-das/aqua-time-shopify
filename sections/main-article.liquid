<article class="article-section bg-white py-10 sm:py-16">
  
  <!-- Breadcrumb -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
    <div class="flex items-center gap-2 text-xs font-semibold text-[#4a6177]">
      <a href="/" class="hover:text-[#088ae3] transition-colors">Home</a>
      <span>/</span>
      <a href="{{ blog.url }}" class="hover:text-[#088ae3] transition-colors">{{ blog.title }}</a>
      <span>/</span>
      <span class="text-[#173b57] font-bold line-clamp-1">{{ article.title }}</span>
    </div>
  </div>

  <!-- Article Header -->
  <header class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4 mb-10">
    <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-widest text-[#088ae3] bg-[#eff9fd] border border-[#d9f1fc] uppercase">
      {{ article.tags.first | default: 'AWG Research & Insights' }}
    </span>
    <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#173b57] tracking-tight leading-tight">
      {{ article.title }}
    </h1>
    <div class="flex items-center justify-center gap-4 text-xs text-[#4a6177] pt-2">
      <span class="font-bold text-[#173b57]">By {{ article.author | default: 'Aqua-Time Team' }}</span>
      <span>•</span>
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
    </div>
  </header>

  <!-- Featured Image -->
  {% if article.image %}
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
      <div class="aspect-[21/9] rounded-3xl overflow-hidden shadow-md border border-[#d9f1fc]">
        <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title }}" class="w-full h-full object-cover" loading="eager">
      </div>
    </div>
  {% endif %}

  <!-- Article Content -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="prose max-w-none text-[#4a6177] text-base leading-relaxed space-y-6">
      {{ article.content }}
    </div>

    <!-- Article Footer / Share -->
    <div class="mt-12 pt-8 border-t border-[#d9f1fc] flex items-center justify-between">
      <a href="{{ blog.url }}" class="inline-flex items-center gap-2 text-xs font-bold text-[#088ae3] hover:text-[#0776c4] uppercase tracking-wider">
        {% render 'icon', name: 'arrow-right', class: 'w-4 h-4 rotate-180' %}
        <span>Back to {{ blog.title }}</span>
      </a>
      <a href="/pages/contact" class="btn-primary py-2.5 px-5 text-xs font-bold">
        <span>Talk to an Expert</span>
      </a>
    </div>
  </div>

</article>

{% schema %}
{
  "name": "Article Content",
  "settings": [],
  "presets": [
    {
      "name": "Article Content"
    }
  ]
}
{% endschema %}
