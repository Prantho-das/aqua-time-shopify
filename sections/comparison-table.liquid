<section id="comparison" class="section-spacing bg-[#f8fcfd] border-y border-[#e2f0f9]">
  <div class="container">
    
    <div class="max-w-2xl mb-10">
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#173b57]">
        {{ section.settings.heading | default: 'An honest comparison' }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="text-[#4a6177] text-[15px] mt-3 leading-relaxed max-w-xl">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    <div class="bg-white rounded-2xl border border-[#e2f0f9] overflow-hidden">
      <div class="sm:hidden px-4 py-2 text-xs text-[#088ae3] font-semibold bg-[#f8fcfd] border-b border-[#e2f0f9]">
        Swipe to compare all sources
      </div>
      
      <div class="overflow-x-auto">
        <table class="w-full min-w-[700px] text-left border-collapse text-sm">
          <thead>
            <tr class="bg-[#f8fcfd] border-b border-[#e2f0f9]">
              <th class="py-3.5 px-5 font-heading font-bold text-[#173b57] w-1/4"></th>
              <th class="py-3.5 px-5 font-heading font-bold text-[#088ae3] bg-[#eff9fd] border-x border-[#d9f1fc] w-1/4">
                <span class="flex items-center gap-2">
                  {% render 'icon', name: 'droplet', class: 'w-4 h-4 text-[#088ae3]' %}
                  AWG
                </span>
              </th>
              <th class="py-3.5 px-5 font-heading font-semibold text-[#4a6177] w-1/6">Municipal</th>
              <th class="py-3.5 px-5 font-heading font-semibold text-[#4a6177] w-1/6">Well</th>
              <th class="py-3.5 px-5 font-heading font-semibold text-[#4a6177] w-1/6">Bottled</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e2f0f9] text-[#4a6177]">
            {% for block in section.blocks %}
              <tr class="hover:bg-[#f8fcfd] transition-colors" {{ block.shopify_attributes }}>
                <td class="py-3.5 px-5 font-semibold text-[#173b57]">{{ block.settings.feature }}</td>
                <td class="py-3.5 px-5 font-semibold text-[#088ae3] bg-[#eff9fd]/50 border-x border-[#d9f1fc]/60">{{ block.settings.awg }}</td>
                <td class="py-3.5 px-5">{{ block.settings.municipal }}</td>
                <td class="py-3.5 px-5">{{ block.settings.well }}</td>
                <td class="py-3.5 px-5">{{ block.settings.bottled }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-6 p-5 rounded-xl bg-white border border-[#e2f0f9] flex items-start gap-3">
      <div class="w-8 h-8 rounded-lg bg-[#eff9fd] text-[#088ae3] flex items-center justify-center shrink-0 mt-0.5">
        {% render 'icon', name: 'info', class: 'w-4 h-4' %}
      </div>
      <p class="text-sm text-[#4a6177] leading-relaxed max-w-3xl">
        {{ section.settings.conclusion_note | default: 'No single water source is best for every situation. Municipal systems remain highly practical where reliable infrastructure exists, while wells can be appropriate where suitable groundwater is available. Atmospheric water generation becomes especially interesting when water independence, distributed production, resilience, remote access, or reduced dependence on delivered water becomes a priority.' }}
      </p>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "An honest comparison" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "How atmospheric water generation compares with conventional water sources across critical operational criteria." },
    { "type": "textarea", "id": "conclusion_note", "label": "Conclusion Note", "default": "No single water source is best for every situation. Municipal systems remain highly practical where reliable infrastructure exists, while wells can be appropriate where suitable groundwater is available. Atmospheric water generation becomes especially interesting when water independence, distributed production, resilience, remote access, or reduced dependence on delivered water becomes a priority." }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Table Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature Name", "default": "Source" },
        { "type": "text", "id": "awg", "label": "AWG Value", "default": "Ambient air" },
        { "type": "text", "id": "municipal", "label": "Municipal", "default": "Surface/groundwater" },
        { "type": "text", "id": "well", "label": "Well", "default": "Groundwater" },
        { "type": "text", "id": "bottled", "label": "Bottled", "default": "Varies" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        { "type": "row", "settings": { "feature": "Source", "awg": "Ambient air", "municipal": "Surface / groundwater", "well": "Groundwater", "bottled": "Varies (bottling plant)" } },
        { "type": "row", "settings": { "feature": "Produced on-site", "awg": "Yes", "municipal": "No", "well": "Yes", "bottled": "No" } },
        { "type": "row", "settings": { "feature": "Requires plumbing", "awg": "None for standup model", "municipal": "Yes", "well": "Yes", "bottled": "No" } },
        { "type": "row", "settings": { "feature": "Climate dependent", "awg": "Yes (humidity and temp)", "municipal": "Generally no", "well": "Generally no", "bottled": "No" } },
        { "type": "row", "settings": { "feature": "Requires electricity", "awg": "Yes (≈5–9 kWh/gal)", "municipal": "Infrastructure dependent", "well": "Usually (pump)", "bottled": "No at point of use" } },
        { "type": "row", "settings": { "feature": "Treatment", "awg": "Multi-barrier (system dependent)", "municipal": "Utility managed", "well": "Property dependent", "bottled": "Supplier managed" } },
        { "type": "row", "settings": { "feature": "Storage", "awg": "Yes (internal and external)", "municipal": "Yes", "well": "Yes", "bottled": "Yes" } }
      ]
    }
  ]
}
{% endschema %}
