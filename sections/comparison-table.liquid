<section id="comparison" class="py-16 bg-[#f8fbfe] border-y border-slate-100 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-2xl space-y-3.5 mb-10 reveal-init">
      <span class="text-[11px] font-extrabold tracking-widest text-brand-600 uppercase">{{ section.settings.badge | default: 'TECHNOLOGY COMPARISON' }}</span>
      
      <h2 class="font-heading text-3xl sm:text-4xl font-extrabold text-[#0e1c36] leading-tight">
        {{ section.settings.heading_line1 | default: 'How AWG Outperforms' }}<br>
        {{ section.settings.heading_line2 | default: 'Every Alternative.' }}
      </h2>

      <p class="text-[#596780] text-sm leading-relaxed">
        {{ section.settings.description | default: 'See why atmospheric water generation delivers superior purity, lower operating costs, and true resilience compared to conventional drinking water sources.' }}
      </p>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/90 shadow-md overflow-hidden reveal-init delay-100 p-1 sm:p-0">
      <div class="sm:hidden px-3 pt-3 pb-1 flex items-center justify-between text-[11px] text-brand-600 font-bold bg-sky-50/70 border-b border-slate-100 rounded-t-xl">
        <span class="flex items-center gap-1.5">
          {% render 'icon', name: 'chevrons-left-right', class: 'w-3.5 h-3.5' %}
          Swipe table to compare
        </span>
        <span class="text-slate-400 font-normal text-[10px]">5 Columns</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[640px] text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200">
              <th class="py-4 px-5 font-heading font-extrabold text-[#0e1c36] uppercase tracking-wider w-1/4">Key Feature</th>
              <th class="py-4 px-5 font-heading font-extrabold text-brand-600 bg-sky-50/60 uppercase tracking-wider w-1/4 border-x border-sky-100">
                <span class="flex items-center gap-1.5">
                  {% render 'icon', name: 'droplet', class: 'w-4 h-4 text-brand-600' %}
                  AWG Technology
                </span>
              </th>
              <th class="py-4 px-4 font-heading font-bold text-slate-700 uppercase tracking-wider w-1/6">5-Gal Jug Delivery</th>
              <th class="py-4 px-4 font-heading font-bold text-slate-700 uppercase tracking-wider w-1/6">Reverse Osmosis</th>
              <th class="py-4 px-4 font-heading font-bold text-slate-700 uppercase tracking-wider w-1/6">Tap Water</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-600">
            {% for block in section.blocks %}
              <tr class="hover:bg-slate-50/50" {{ block.shopify_attributes }}>
                <td class="py-3.5 px-5 font-bold text-[#0e1c36]">{{ block.settings.feature }}</td>
                <td class="py-3.5 px-5 font-semibold text-brand-600 bg-sky-50/30 border-x border-sky-100">{{ block.settings.awg }}</td>
                <td class="py-3.5 px-4">{{ block.settings.jug }}</td>
                <td class="py-3.5 px-4">{{ block.settings.ro }}</td>
                <td class="py-3.5 px-4">{{ block.settings.tap }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "TECHNOLOGY COMPARISON"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "How AWG Outperforms"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading Line 2",
      "default": "Every Alternative."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "See why atmospheric water generation delivers superior purity, lower operating costs, and true resilience compared to conventional drinking water sources."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Table Row",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature Name",
          "default": "Water Source"
        },
        {
          "type": "text",
          "id": "awg",
          "label": "AWG Value",
          "default": "100% Atmospheric Air"
        },
        {
          "type": "text",
          "id": "jug",
          "label": "5-Gal Jug Value",
          "default": "Municipal / Well Trucks"
        },
        {
          "type": "text",
          "id": "ro",
          "label": "Reverse Osmosis Value",
          "default": "Municipal Plumbing"
        },
        {
          "type": "text",
          "id": "tap",
          "label": "Tap Water Value",
          "default": "Aging Pipe Grid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "feature": "Water Source",
            "awg": "100% Atmospheric Air",
            "jug": "Municipal / Well Trucks",
            "ro": "Municipal Plumbing",
            "tap": "Aging Pipe Grid"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Purity & Treatment",
            "awg": "HEPA + UV-C + Alkaline Minerals",
            "jug": "Microplastic Leaching Risk",
            "ro": "Acidic / Mineral Stripped",
            "tap": "Chlorine, Lead, PFAS Risk"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Cost Per Gallon",
            "awg": "~$0.08 / Gal (Electric)",
            "jug": "$1.20 - $2.50 / Gal",
            "ro": "$0.25 - $0.50 + Wastewater",
            "tap": "Low direct ($0.01)"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Environmental Footprint",
            "awg": "Zero plastic, zero water wasted",
            "jug": "Plastic jugs, trucking emissions",
            "ro": "Wastes 3-4 gallons per gallon produced",
            "tap": "Chemical water processing"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Disaster Independence",
            "awg": "100% Self-Sustaining (Solar/Gen)",
            "jug": "Disrupted by road closures",
            "ro": "Fails without water line pressure",
            "tap": "Fails during boil notices & cuts"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Installation Required",
            "awg": "None (Plug & Play)",
            "jug": "Heavy 42 lb lifting each week",
            "ro": "Under-sink plumbing required",
            "tap": "Municipal connection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
