<section class="blog-section bg-white">
  
  <!-- Breadcrumb -->
  <div class="border-b border-[#d9f1fc] bg-[#f8fcfd]/70 py-3.5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-xs font-semibold text-[#4a6177]">
        <a href="/" class="hover:text-[#088ae3] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#173b57] font-bold">{{ blog.title | default: 'Blog & Articles' }}</span>
      </div>
    </div>
  </div>

  <!-- Hero Header -->
  <div class="relative bg-gradient-to-b from-[#eff9fd] via-[#f8fcfd] to-white border-b border-[#d9f1fc] py-14 sm:py-20 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-3">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-widest text-[#088ae3] bg-white border border-[#d9f1fc] uppercase shadow-sm">
        Insights & Technology
      </span>
      <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#173b57] tracking-tight">
        {{ blog.title | default: 'Latest Articles & Water Insights' }}
      </h1>
      <p class="text-sm sm:text-base text-[#4a6177] max-w-2xl mx-auto">
        Discover the science, climate research, and engineering breakthroughs powering atmospheric water generation.
      </p>
    </div>
  </div>

  <!-- Blog Articles Grid -->
  <div class="py-12 sm:py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {% paginate blog.articles by 9 %}
        {% if blog.articles.size > 0 %}
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for article in blog.articles %}
              <article class="bg-white rounded-3xl border border-[#d9f1fc] overflow-hidden shadow-sm hover:shadow-md hover:border-[#088ae3]/60 transition-all flex flex-col group">
                {% if article.image %}
                  <a href="{{ article.url }}" class="block aspect-[16/10] overflow-hidden bg-[#eff9fd]">
                    <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
                  </a>
                {% else %}
                  <div class="aspect-[16/10] bg-gradient-to-br from-[#eff9fd] to-[#d9f1fc] flex items-center justify-center text-[#088ae3]">
                    {% render 'icon', name: 'sparkles', class: 'w-12 h-12 opacity-50' %}
                  </div>
                {% endif %}

                <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-4">
                  <div class="space-y-2.5">
                    <div class="flex items-center gap-3 text-xs text-[#4a6177]">
                      <span class="font-bold text-[#088ae3] uppercase tracking-wider text-[11px] bg-[#eff9fd] px-2.5 py-0.5 rounded-full border border-[#d9f1fc]">
                        {{ article.tags.first | default: 'AWG Insights' }}
                      </span>
                      <span>{{ article.published_at | date: '%b %d, %Y' }}</span>
                    </div>

                    <h2 class="font-heading font-extrabold text-xl text-[#173b57] group-hover:text-[#088ae3] transition-colors line-clamp-2 leading-snug">
                      <a href="{{ article.url }}">{{ article.title }}</a>
                    </h2>

                    <p class="text-xs sm:text-sm text-[#4a6177] line-clamp-3 leading-relaxed">
                      {{ article.excerpt_or_content | strip_html | truncate: 140 }}
                    </p>
                  </div>

                  <div class="pt-3 border-t border-[#d9f1fc] flex items-center justify-between">
                    <a href="{{ article.url }}" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#088ae3] group-hover:text-[#0776c4] tracking-wider uppercase">
                      <span>Read Article</span>
                      {% render 'icon', name: 'arrow-right', class: 'w-3.5 h-3.5' %}
                    </a>
                    <span class="text-[11px] text-[#4a6177]">By {{ article.author | default: 'Aqua-Time' }}</span>
                  </div>
                </div>
              </article>
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <div class="mt-12 flex justify-center">
              {{ paginate | default_pagination }}
            </div>
          {% endif %}
        {% else %}
          <!-- Empty State with Featured Preview Cards -->
          <div class="space-y-8">
            <div class="text-center py-6">
              <span class="text-xs font-bold uppercase tracking-widest text-[#088ae3]">Fresh Insights Coming Soon</span>
              <p class="text-sm text-[#4a6177] mt-1">Our research team publishes weekly studies on drinking water independence.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div class="bg-white rounded-3xl border border-[#d9f1fc] p-6 shadow-sm space-y-3">
                <span class="text-[11px] font-bold text-[#088ae3] bg-[#eff9fd] px-3 py-1 rounded-full uppercase">Purity Guide</span>
                <h3 class="font-heading font-bold text-lg text-[#173b57]">Understanding PFAS Forever Chemicals in Tap Water</h3>
                <p class="text-xs text-[#4a6177] leading-relaxed">How atmospheric water generation bypasses aging municipal plumbing lines and contaminated groundwater aquifers.</p>
                <a href="/pages/water-quality" class="inline-flex items-center gap-1 text-xs font-bold text-[#088ae3] pt-2">Learn more →</a>
              </div>

              <div class="bg-white rounded-3xl border border-[#d9f1fc] p-6 shadow-sm space-y-3">
                <span class="text-[11px] font-bold text-[#088ae3] bg-[#eff9fd] px-3 py-1 rounded-full uppercase">Climate Research</span>
                <h3 class="font-heading font-bold text-lg text-[#173b57]">How Relative Humidity Affects Daily Water Output</h3>
                <p class="text-xs text-[#4a6177] leading-relaxed">Detailed climate envelopes and humidity production dynamics for condensation-based water makers.</p>
                <a href="/pages/how-it-works" class="inline-flex items-center gap-1 text-xs font-bold text-[#088ae3] pt-2">View chart →</a>
              </div>

              <div class="bg-white rounded-3xl border border-[#d9f1fc] p-6 shadow-sm space-y-3">
                <span class="text-[11px] font-bold text-[#088ae3] bg-[#eff9fd] px-3 py-1 rounded-full uppercase">Cost Analysis</span>
                <h3 class="font-heading font-bold text-lg text-[#173b57]">The True Cost of 5-Gallon Bottled Water Deliveries</h3>
                <p class="text-xs text-[#4a6177] leading-relaxed">Breakdown of delivery fuel fees, jug deposits, plastic disposal costs vs on-site kilowatt generation.</p>
                <a href="/products/hydrocell-standup" class="inline-flex items-center gap-1 text-xs font-bold text-[#088ae3] pt-2">See machine →</a>
              </div>
            </div>
          </div>
        {% endif %}
      {% endpaginate %}
    </div>
  </div>

</section>

{% schema %}
{
  "name": "Blog Posts List",
  "settings": [],
  "presets": [
    {
      "name": "Blog Posts List"
    }
  ]
}
{% endschema %}
