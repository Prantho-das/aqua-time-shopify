<section id="purification-process" class="py-16 sm:py-20 lg:py-24 bg-[#f8fcfd] border-y border-[#d9f1fc]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-widest text-[#088ae3] bg-[#eff9fd] border border-[#d9f1fc] uppercase mb-3 shadow-sm">
        {{ section.settings.badge | default: 'Eight Stages Between Air to Glass' }}
      </span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#173b57] tracking-tight">
        {{ section.settings.heading | default: 'From Air To Glass: The Purification Process' }}
      </h2>
      <p class="mt-4 text-sm sm:text-base text-[#4a6177] leading-relaxed max-w-2xl mx-auto">
        {{ section.settings.description | default: 'Every drop produced by our Atmospheric Water Generators undergoes an advanced cycle: 8 stages of filtration and UV light, then light mineralization for taste.' }}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {%- assign default_stages = "01|Air Filter|Traps dust, pollen, and large atmospheric particulates before moisture collection.|wind|Dust & Airborne Particulates,02|UV Light (Lower)|UV light treats collected water before filtration.|sun|Lower Tank Treatment,03|Softening Filter|Removes excess hardness minerals to optimize internal efficiency and mouthfeel.|sparkles|Hardness & Scale Reduction,04|Sediment Filter|Multi-layer physical micro-filtration removing particles down to 5 microns.|filter|Micro-particulates (>5µm),05|Ultrafiltration Membrane|Ultra-fine membrane that blocks sub-micron particles.|shield-check|Sub-micron solids (>0.01µm),06|Pre-Carbon Filter|High-density activated carbon block absorbs chlorine, pesticides, odors, and VOCs.|activity|Chlorine, VOCs & Taste,07|Electropositive Matrix|Advanced charged membrane capturing fine particles and trace organics.|zap|Microbial & Trace Organics,08|UV Light (Upper)|UV light treats the water again before dispensing.|droplets|Instant Dispense Purity" | split: "," -%}

      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="bg-white rounded-3xl p-6 sm:p-7 border border-[#d9f1fc] shadow-sm hover:shadow-md hover:border-[#088ae3]/60 transition-all group flex flex-col justify-between" {{ block.shopify_attributes }}>
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-heading font-black text-2xl text-[#088ae3]/30 group-hover:text-[#088ae3] transition-colors">
                  {{ block.settings.stage_number }}
                </span>
                <div class="w-10 h-10 rounded-2xl bg-[#eff9fd] group-hover:bg-[#088ae3] text-[#088ae3] group-hover:text-white transition-colors flex items-center justify-center font-bold">
                  {% render 'icon', name: 'shield-check', class: 'w-5 h-5' %}
                </div>
              </div>
              <h3 class="font-heading text-lg font-bold text-[#173b57] mb-2 group-hover:text-[#088ae3] transition-colors">
                {{ block.settings.title }}
              </h3>
              <p class="text-xs sm:text-sm text-[#4a6177] leading-relaxed">
                {{ block.settings.description }}
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-[#d9f1fc] flex items-center gap-1.5 text-[11px] font-bold text-[#088ae3]">
              <span>Target:</span>
              <span class="text-[#173b57] font-medium">{{ block.settings.target }}</span>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% for item in default_stages %}
          {% assign parts = item | split: "|" %}
          <div class="bg-white rounded-3xl p-6 sm:p-7 border border-[#d9f1fc] shadow-sm hover:shadow-md hover:border-[#088ae3]/60 transition-all group flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-heading font-black text-2xl text-[#088ae3]/30 group-hover:text-[#088ae3] transition-colors">
                  {{ parts[0] }}
                </span>
                <div class="w-10 h-10 rounded-2xl bg-[#eff9fd] group-hover:bg-[#088ae3] text-[#088ae3] group-hover:text-white transition-colors flex items-center justify-center font-bold">
                  {% render 'icon', name: parts[3], class: 'w-5 h-5' %}
                </div>
              </div>
              <h3 class="font-heading text-lg font-bold text-[#173b57] mb-2 group-hover:text-[#088ae3] transition-colors">
                {{ parts[1] }}
              </h3>
              <p class="text-xs sm:text-sm text-[#4a6177] leading-relaxed">
                {{ parts[2] }}
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-[#d9f1fc] flex items-center gap-1.5 text-[11px] font-bold text-[#088ae3]">
              <span>Target:</span>
              <span class="text-[#173b57] font-medium">{{ parts[4] }}</span>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div class="mt-6 text-center text-xs sm:text-sm font-semibold text-[#173b57] bg-white rounded-2xl py-3.5 px-6 border border-[#d9f1fc] shadow-xs max-w-2xl mx-auto">
      After filtration, water is lightly mineralized with sodium and potassium (about 50 TDS).
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href="/pages/water-quality" class="text-center px-6 py-3 rounded-xl border border-[#088ae3] text-[#088ae3] hover:bg-[#eff9fd] text-xs font-bold transition-all">
        VIEW LAB REPORTS
      </a>
      <button class="open-quote-modal text-center px-7 py-3 rounded-xl btn-primary text-xs font-bold transition-all" aria-haspopup="dialog">
        ORDER HYDROCELL™
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purification 8-Stage",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Eight Stages Between Air to Glass"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Air To Glass: The Purification Process"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every drop produced by our Atmospheric Water Generators undergoes an advanced 8-stage physical, molecular, and ultraviolet purification cycle for ultra-clean, mineralized alkaline water."
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Purification Stage",
      "settings": [
        {
          "type": "text",
          "id": "stage_number",
          "label": "Stage Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Stage Title",
          "default": "Air Filter"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Traps dust, pollen, and large particulates before moisture extraction."
        },
        {
          "type": "text",
          "id": "target",
          "label": "Target Contaminant",
          "default": "Dust & Particulates"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purification 8-Stage"
    }
  ]
}
{% endschema %}
