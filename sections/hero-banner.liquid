<section id="home" class="relative overflow-hidden min-h-[640px] lg:min-h-[740px] flex items-center pt-10 pb-16 sm:pt-16 sm:pb-24 lg:pt-20 lg:pb-28">
  
  <div class="absolute inset-0 z-0" id="hero-bg-slider">
    <div class="hero-slide absolute inset-0 transition-opacity duration-[1200ms] ease-in-out opacity-100">
      <img src="{{ 'hero-banner-03.jpg' | asset_url }}" alt="Atmospheric Water Generator" class="w-full h-full object-cover object-[75%_center] sm:object-center" fetchpriority="high" loading="eager">
    </div>
    <div class="hero-slide absolute inset-0 transition-opacity duration-[1200ms] ease-in-out opacity-0 pointer-events-none">
      <img src="{{ 'hero-banner-01.jpg' | asset_url }}" alt="Air to Water Technology" class="w-full h-full object-cover object-[75%_center] sm:object-center" loading="lazy">
    </div>
    <div class="hero-slide absolute inset-0 transition-opacity duration-[1200ms] ease-in-out opacity-0 pointer-events-none">
      <img src="{{ 'hero-banner-02.jpg' | asset_url }}" alt="Clean Water Generation" class="w-full h-full object-cover object-[75%_center] sm:object-center" loading="lazy">
    </div>
    
    <div class="absolute inset-0 bg-gradient-to-r from-white via-white/95 to-white/20 sm:w-[85%] lg:w-[65%] pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-white/50 via-transparent to-transparent pointer-events-none"></div>
  </div>

  <div class="container relative z-10 w-full">
    <div class="max-w-2xl space-y-5">
      
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/90 backdrop-blur-sm border border-[#e2f0f9]">
        <span class="text-[11px] font-bold tracking-wide text-[#088ae3]">{{ section.settings.badge_tag | default: 'Atmospheric Water Machine' }}</span>
        <span class="w-1 h-1 rounded-full bg-slate-300"></span>
        <span class="inline-flex items-center gap-1.5 text-emerald-700 text-[11px] font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          {{ section.settings.stock_tag | default: 'In stock · Ships immediately' }}
        </span>
      </div>

      <h1 class="font-heading text-[2rem] sm:text-[2.75rem] lg:text-[3.25rem] font-extrabold text-[#173b57] leading-[1.1]">
        <span class="block text-[#4a6177] text-base sm:text-xl font-semibold mb-1 tracking-normal font-heading">{{ section.settings.pre_heading | default: 'Air to Water Generators' }}</span>
        {{ section.settings.heading_line1 | default: 'Generate Water From the Air in Your' }}
        <span id="hero-rotating-word" data-words="{{ section.settings.rotating_words | default: 'Home, Office, Kitchen, Shop, Cabin, Factory, Break Room' }}" class="text-[#088ae3]">Home</span>.
      </h1>

      <div class="max-w-lg space-y-1">
        <p class="text-[#173b57] text-[15px] sm:text-base font-semibold">
          {{ section.settings.tagline | default: 'No plumbing. No plastic bottles. No problem.' }}
        </p>
        <p class="text-[#088ae3] text-sm font-semibold">
          {{ section.settings.sub_tagline | default: 'Up to 5.5 gallons a day from the air' }}
        </p>
      </div>

      <div class="inline-flex flex-wrap items-center gap-3 bg-white border border-[#e2f0f9] px-4 py-2.5 rounded-xl">
        <div class="flex items-baseline gap-2">
          <span class="text-2xl font-extrabold text-[#173b57] font-heading">{{ section.settings.price | default: '$1,495' }}</span>
          <span class="line-through text-slate-400 text-sm font-medium">{{ section.settings.compare_price | default: '$1,995' }}</span>
        </div>
        <span class="bg-emerald-600 text-white text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wide">
          {{ section.settings.save_tag | default: '$500 off' }}
        </span>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1">
        <button class="open-quote-modal btn-primary">
          {{ section.settings.btn_primary_text | default: 'Order your generator' }}
        </button>
        
        <a href="/pages/contact" class="btn-secondary">
          {% render 'icon', name: 'phone-call', class: 'w-4 h-4 text-[#088ae3]' %}
          {{ section.settings.btn_secondary_text | default: 'Talk to an expert' }}
        </a>

        <a href="/pages/lab-report" class="text-[#4a6177] hover:text-[#088ae3] text-[13px] font-semibold px-2 py-3 transition-colors">
          {{ section.settings.btn_tertiary_text | default: 'Read lab report' }}
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-5 border-t border-[#e2f0f9]">
        {% for block in section.blocks %}
          <div class="flex items-start gap-2" {{ block.shopify_attributes }}>
            <div class="w-5 h-5 text-[#088ae3] shrink-0 mt-0.5">
              {% render 'icon', name: block.settings.icon, class: 'w-5 h-5 text-[#088ae3]' %}
            </div>
            <div>
              <div class="font-semibold text-xs text-[#173b57]">{{ block.settings.title }}</div>
              <div class="text-[11px] text-[#4a6177] leading-snug">{{ block.settings.description }}</div>
            </div>
          </div>
        {% endfor %}
      </div>

    </div>
  </div>

  <div class="absolute bottom-6 right-8 z-20 hidden sm:flex items-center gap-2 bg-white/80 backdrop-blur-sm px-3 py-1.5 rounded-full border border-white/60" id="hero-slider-dots">
    <button class="w-2 h-2 rounded-full bg-[#088ae3] transition-all hero-dot active" data-slide="0" aria-label="Slide 1"></button>
    <button class="w-2 h-2 rounded-full bg-slate-300 hover:bg-[#088ae3] transition-all hero-dot" data-slide="1" aria-label="Slide 2"></button>
    <button class="w-2 h-2 rounded-full bg-slate-300 hover:bg-[#088ae3] transition-all hero-dot" data-slide="2" aria-label="Slide 3"></button>
  </div>
</section>

<script>
  (function() {
    var slides = document.querySelectorAll('#hero-bg-slider .hero-slide');
    var dots = document.querySelectorAll('#hero-slider-dots .hero-dot');
    if (!slides.length) return;
    var current = 0, timer;
    function go(i) {
      slides.forEach(function(s, idx) {
        s.style.opacity = idx === i ? '1' : '0';
        s.style.pointerEvents = idx === i ? 'auto' : 'none';
      });
      dots.forEach(function(d, idx) {
        d.style.background = idx === i ? '#088ae3' : '#cbd5e1';
        d.style.width = idx === i ? '16px' : '8px';
      });
      current = i;
    }
    function next() { go((current + 1) % slides.length); }
    function start() { timer = setInterval(next, 5500); }
    dots.forEach(function(d, idx) {
      d.addEventListener('click', function() { clearInterval(timer); go(idx); start(); });
    });
    start();
  })();
</script>

