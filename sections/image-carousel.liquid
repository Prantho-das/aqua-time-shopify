<section id="press-carousel" class="py-7 sm:py-8 bg-[#f8fcfd] border-y border-[#d9f1fc] overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-5">
      <span class="text-[10.5px] sm:text-[11px] font-extrabold tracking-[0.2em] text-[#4a6177] uppercase">
        AS FEATURED IN
      </span>
    </div>

    <!-- Infinite Scrolling Logo Marquee -->
    <div class="relative w-full overflow-hidden [mask-image:_linear-gradient(to_right,transparent_0,_black_128px,_black_calc(100%-128px),transparent_100%)]">
      <div class="flex items-center gap-12 sm:gap-16 md:gap-20 w-max animate-logo-marquee py-2">
        
        <!-- WSJ -->
        <div class="flex items-center opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <span class="font-serif font-black text-lg sm:text-xl text-[#0e1c36] tracking-tight">THE WALL STREET JOURNAL.</span>
        </div>

        <!-- Nasdaq -->
        <div class="flex items-center gap-1.5 opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <span class="font-heading font-black text-xl sm:text-2xl text-[#088ae3] italic tracking-tighter">/ Nasdaq</span>
        </div>

        <!-- CBS -->
        <div class="flex items-center gap-1.5 opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <div class="w-5 h-5 rounded-full border-2 border-[#0e1c36] flex items-center justify-center font-bold text-[9px]">●</div>
          <span class="font-heading font-black text-lg sm:text-xl text-[#0e1c36] tracking-wider">CBS</span>
        </div>

        <!-- TIME -->
        <div class="flex items-center opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <span class="font-serif font-black text-xl sm:text-2xl text-[#0e1c36] tracking-[0.15em]">TIME</span>
        </div>

        <!-- HuffPost -->
        <div class="flex items-center opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <span class="font-heading font-extrabold text-lg sm:text-xl text-[#0e1c36] italic tracking-tight">IHUFFPOSTI</span>
        </div>

        <!-- Reuters -->
        <div class="flex items-center gap-1.5 opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <span class="text-amber-600 text-base font-black">☸</span>
          <span class="font-heading font-bold text-base sm:text-lg text-[#0e1c36] tracking-wider">REUTERS</span>
        </div>

        <!-- Bloomberg -->
        <div class="flex items-center opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <span class="font-heading font-black text-lg sm:text-xl text-[#0e1c36] tracking-tight">Bloomberg</span>
        </div>

        <!-- Forbes -->
        <div class="flex items-center opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <span class="font-serif font-black text-lg sm:text-xl text-[#0e1c36] tracking-wider">Forbes</span>
        </div>

        <!-- Duplicate for Infinite Loop -->
        <!-- WSJ -->
        <div class="flex items-center opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <span class="font-serif font-black text-lg sm:text-xl text-[#0e1c36] tracking-tight">THE WALL STREET JOURNAL.</span>
        </div>

        <!-- Nasdaq -->
        <div class="flex items-center gap-1.5 opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <span class="font-heading font-black text-xl sm:text-2xl text-[#088ae3] italic tracking-tighter">/ Nasdaq</span>
        </div>

        <!-- CBS -->
        <div class="flex items-center gap-1.5 opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <div class="w-5 h-5 rounded-full border-2 border-[#0e1c36] flex items-center justify-center font-bold text-[9px]">●</div>
          <span class="font-heading font-black text-lg sm:text-xl text-[#0e1c36] tracking-wider">CBS</span>
        </div>

        <!-- TIME -->
        <div class="flex items-center opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <span class="font-serif font-black text-xl sm:text-2xl text-[#0e1c36] tracking-[0.15em]">TIME</span>
        </div>

        <!-- HuffPost -->
        <div class="flex items-center opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <span class="font-heading font-extrabold text-lg sm:text-xl text-[#0e1c36] italic tracking-tight">IHUFFPOSTI</span>
        </div>

        <!-- Reuters -->
        <div class="flex items-center gap-1.5 opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <span class="text-amber-600 text-base font-black">☸</span>
          <span class="font-heading font-bold text-base sm:text-lg text-[#0e1c36] tracking-wider">REUTERS</span>
        </div>

        <!-- Bloomberg -->
        <div class="flex items-center opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <span class="font-heading font-black text-lg sm:text-xl text-[#0e1c36] tracking-tight">Bloomberg</span>
        </div>

        <!-- Forbes -->
        <div class="flex items-center opacity-65 hover:opacity-100 transition-opacity grayscale hover:grayscale-0 cursor-default">
          <span class="font-serif font-black text-lg sm:text-xl text-[#0e1c36] tracking-wider">Forbes</span>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  @keyframes logoMarquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-logo-marquee {
    animation: logoMarquee 28s linear infinite;
  }
  .animate-logo-marquee:hover {
    animation-play-state: paused;
  }
</style>

