<section id="faq" class="section-spacing bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="mb-10 text-center sm:text-left">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-[#088ae3] bg-[#eff9fd] px-3 py-1 rounded-full mb-2.5">
        Help & Clarity
      </span>
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#173b57]">
        {{ section.settings.heading | default: 'Frequently asked questions' }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="text-[#4a6177] text-[15px] mt-2.5 leading-relaxed">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    <div class="space-y-3">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="faq-item border border-[#d9f1fc] rounded-2xl overflow-hidden bg-[#f8fcfd] hover:border-[#088ae3]/40 transition-colors" {{ block.shopify_attributes }}>
            <button class="faq-toggle w-full flex items-center justify-between p-4 sm:p-5 text-left font-heading font-bold text-[15px] text-[#173b57]" aria-expanded="false" aria-controls="faq-content-{{ forloop.index }}">
              <span>{{ block.settings.question }}</span>
              <span class="faq-icon transition-transform duration-200 text-[#088ae3] shrink-0 ml-3">
                {% render 'icon', name: 'chevron-down', class: 'w-4 h-4' %}
              </span>
            </button>
            <div id="faq-content-{{ forloop.index }}" class="faq-content hidden px-5 pb-5 text-sm text-[#4a6177] leading-relaxed border-t border-[#d9f1fc] pt-3 bg-white">
              {{ block.settings.answer }}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="faq-item border border-[#d9f1fc] rounded-2xl overflow-hidden bg-[#f8fcfd] hover:border-[#088ae3]/40 transition-colors">
          <button class="faq-toggle w-full flex items-center justify-between p-4 sm:p-5 text-left font-heading font-bold text-[15px] text-[#173b57]" aria-expanded="false" aria-controls="faq-def-1">
            <span>How much water does it make per day?</span>
            <span class="faq-icon transition-transform duration-200 text-[#088ae3] shrink-0 ml-3">
              {% render 'icon', name: 'chevron-down', class: 'w-4 h-4' %}
            </span>
          </button>
          <div id="faq-def-1" class="faq-content hidden px-5 pb-5 text-sm text-[#4a6177] leading-relaxed border-t border-[#d9f1fc] pt-3 bg-white">
            Up to about 5 gallons per day at 80% RH and 86°F. RH 80 to 90%, 77 to 86°F: about 4.0 to 6.7 gal/day. RH 50 to 80%, 68 to 86°F: about 1.8 to 5.3 gal/day. RH 30 to 50%, 68 to 86°F: about 1.0 to 2.4 gal/day. For best results, run overnight and place where indoor humidity is highest.
          </div>
        </div>

        <div class="faq-item border border-[#d9f1fc] rounded-2xl overflow-hidden bg-[#f8fcfd] hover:border-[#088ae3]/40 transition-colors">
          <button class="faq-toggle w-full flex items-center justify-between p-4 sm:p-5 text-left font-heading font-bold text-[15px] text-[#173b57]" aria-expanded="false" aria-controls="faq-def-2">
            <span>Is the water safe?</span>
            <span class="faq-icon transition-transform duration-200 text-[#088ae3] shrink-0 ml-3">
              {% render 'icon', name: 'chevron-down', class: 'w-4 h-4' %}
            </span>
          </button>
          <div id="faq-def-2" class="faq-content hidden px-5 pb-5 text-sm text-[#4a6177] leading-relaxed border-t border-[#d9f1fc] pt-3 bg-white">
            Yes. Independent lab testing shows HydroCell water meets U.S. EPA standards, with PFAS, lead and microplastics not detected, and the unit is CE and IEC tested. Water is condensed from the air, run through 8-stage filtration with dual UV, and lightly mineralized.
          </div>
        </div>

        <div class="faq-item border border-[#d9f1fc] rounded-2xl overflow-hidden bg-[#f8fcfd] hover:border-[#088ae3]/40 transition-colors">
          <button class="faq-toggle w-full flex items-center justify-between p-4 sm:p-5 text-left font-heading font-bold text-[15px] text-[#173b57]" aria-expanded="false" aria-controls="faq-def-3">
            <span>What maintenance is required?</span>
            <span class="faq-icon transition-transform duration-200 text-[#088ae3] shrink-0 ml-3">
              {% render 'icon', name: 'chevron-down', class: 'w-4 h-4' %}
            </span>
          </button>
          <div id="faq-def-3" class="faq-content hidden px-5 pb-5 text-sm text-[#4a6177] leading-relaxed border-t border-[#d9f1fc] pt-3 bg-white">
            Wipe dust from the air intake. Replace the filter kits roughly every 6 months. Routine cleaning. The unit reminds you when to replace filters; resets are on-screen.
          </div>
        </div>

        <div class="faq-item border border-[#d9f1fc] rounded-2xl overflow-hidden bg-[#f8fcfd] hover:border-[#088ae3]/40 transition-colors">
          <button class="faq-toggle w-full flex items-center justify-between p-4 sm:p-5 text-left font-heading font-bold text-[15px] text-[#173b57]" aria-expanded="false" aria-controls="faq-def-4">
            <span>How much power does it use?</span>
            <span class="faq-icon transition-transform duration-200 text-[#088ae3] shrink-0 ml-3">
              {% render 'icon', name: 'chevron-down', class: 'w-4 h-4' %}
            </span>
          </button>
          <div id="faq-def-4" class="faq-content hidden px-5 pb-5 text-sm text-[#4a6177] leading-relaxed border-t border-[#d9f1fc] pt-3 bg-white">
            Water production about 300W; hot tank about 500W when heating. That's about 1.6 kWh per gallon, roughly $0.29 a gallon at the U.S. average electricity rate, plus two filter kits a year. Cold-only operation for more efficient power use.
          </div>
        </div>

        <div class="faq-item border border-[#d9f1fc] rounded-2xl overflow-hidden bg-[#f8fcfd] hover:border-[#088ae3]/40 transition-colors">
          <button class="faq-toggle w-full flex items-center justify-between p-4 sm:p-5 text-left font-heading font-bold text-[15px] text-[#173b57]" aria-expanded="false" aria-controls="faq-def-5">
            <span>Shipping, financing and warranty?</span>
            <span class="faq-icon transition-transform duration-200 text-[#088ae3] shrink-0 ml-3">
              {% render 'icon', name: 'chevron-down', class: 'w-4 h-4' %}
            </span>
          </button>
          <div id="faq-def-5" class="faq-content hidden px-5 pb-5 text-sm text-[#4a6177] leading-relaxed border-t border-[#d9f1fc] pt-3 bg-white">
            Ships directly from our certified partner facilities. Typical delivery 7 to 10 days with tracking. Financing from about $100/month via Shop Pay and Affirm (subject to approval). Warranty: 1-Year Warranty · 3-Year Core Parts (compressor, condenser, evaporator, water tanks, fans). Defective components are replaced free of charge; labor is not included. Unopened units can be returned within 7 days of delivery. See our Warranty & Refund Policy.
          </div>
        </div>
      {% endif %}
    </div>

  </div>
</section>



{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Everything you need to know about generating pure drinking water from ambient air." }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How much water does it make per day?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Up to about 5 gallons per day at 80% RH and 86°F." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "How do I set it up?", "answer": "Plug into a standard outlet. Power on and let it fill. No plumbing. Setup time about 5 minutes. Depending on location, takes up to 24 hours to fill completely (about 5 gallons of storage). Optional first-use flush: fill, let it reach three-quarters full, then drain the two rear outlets once." } },
        { "type": "faq_item", "settings": { "question": "How much water does it make per day?", "answer": "Up to about 5 gallons per day at 80% RH and 86°F. RH 80 to 90%, 77 to 86°F: about 4.0 to 6.7 gal/day. RH 50 to 80%, 68 to 86°F: about 1.8 to 5.3 gal/day. RH 30 to 50%, 68 to 86°F: about 1.0 to 2.4 gal/day. For best results, run overnight and place where indoor humidity is highest." } },
        { "type": "faq_item", "settings": { "question": "What does the water taste like?", "answer": "Clean, fresh, lightly mineralized. Cold or hot on demand. \"This is the best water I've ever tasted.\" Kansas City customer." } },
        { "type": "faq_item", "settings": { "question": "Is the water safe?", "answer": "Yes. Independent lab testing shows HydroCell water meets U.S. EPA standards, with PFAS, lead and microplastics not detected, and the unit is CE and IEC tested. Water is condensed from the air, run through 8-stage filtration with dual UV, and lightly mineralized." } },
        { "type": "faq_item", "settings": { "question": "What maintenance is required?", "answer": "Wipe dust from the air intake. Replace the filter kits roughly every 6 months. Routine cleaning. The unit reminds you when to replace filters; resets are on-screen." } },
        { "type": "faq_item", "settings": { "question": "How much power does it use?", "answer": "Water production about 300W; hot tank about 500W when heating. That's about 1.6 kWh per gallon, roughly $0.29 a gallon at the U.S. average electricity rate, plus two filter kits a year. Cold-only operation for more efficient power use." } },
        { "type": "faq_item", "settings": { "question": "How loud is it?", "answer": "Indoor-appliance quiet. Fan and compressor sounds similar to a modern refrigerator in cooling mode. Place on a level surface." } },
        { "type": "faq_item", "settings": { "question": "Shipping, financing and warranty?", "answer": "Ships directly from our certified partner facilities. Typical delivery 7 to 10 days with tracking. Financing from about $100/month via Shop Pay and Affirm (subject to approval). Warranty: 1-Year Warranty · 3-Year Core Parts (compressor, condenser, evaporator, water tanks, fans). Defective components are replaced free of charge; labor is not included. Unopened units can be returned within 7 days of delivery. See our Warranty & Refund Policy." } },
        { "type": "faq_item", "settings": { "question": "Manufacturing tests and certifications?", "answer": "Proven manufacturing (CE and IEC). Built to leading international standards and third-party verified by CGS Test and BST Labs. Water you can trust: independent testing shows HydroCell water meets U.S. EPA standards; PFAS, lead and microplastics were not detected. Performance as advertised: output is tested, validated and published in the temperature and humidity table. Everyday safeguards: closed stainless tanks, multi-stage filtration with dual UV, automatic recirculation, on-screen maintenance reminders." } }
      ]
    }
  ]
}
{% endschema %}
