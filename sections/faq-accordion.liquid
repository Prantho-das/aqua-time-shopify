<section id="faq" class="section-spacing bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="mb-10">
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#173b57]">
        {{ section.settings.heading | default: 'Frequently asked questions' }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="text-[#4a6177] text-[15px] mt-3 leading-relaxed">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    <div class="space-y-2">
      {% for block in section.blocks %}
        <div class="faq-item border border-[#e2f0f9] rounded-xl overflow-hidden bg-white hover:border-[#d9f1fc] transition-colors" {{ block.shopify_attributes }}>
          <button class="faq-toggle w-full flex items-center justify-between p-4 sm:p-5 text-left font-heading font-semibold text-[15px] text-[#173b57]" aria-expanded="false" aria-controls="faq-content-{{ forloop.index }}">
            <span>{{ block.settings.question }}</span>
            <span class="faq-icon transition-transform duration-200 text-[#088ae3] shrink-0 ml-3">
              {% render 'icon', name: 'chevron-down', class: 'w-4 h-4' %}
            </span>
          </button>
          <div id="faq-content-{{ forloop.index }}" class="faq-content hidden px-5 pb-5 text-sm text-[#4a6177] leading-relaxed border-t border-[#e2f0f9] pt-3">
            {{ block.settings.answer }}
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Everything you need to know about generating pure drinking water from ambient air." }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How much water will I get?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Up to 5.5 gal/day depending on your climate. Most owners pour 1 to 3 pitchers." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "How much water will I get?", "answer": "Up to 5.5 gal/day depending on your climate. Most owners pour 1 to 3 pitchers." } },
        { "type": "faq_item", "settings": { "question": "How loud is it?", "answer": "You'll hear it in the room, not the next room. Many owners run it overnight." } },
        { "type": "faq_item", "settings": { "question": "What does it cost to run?", "answer": "≈5 to 9 kWh per gallon plus filters. Your rate sets the price; see the math above." } },
        { "type": "faq_item", "settings": { "question": "Does it heat the room?", "answer": "It vents warm air like a large dehumidifier. Summer: run overnight. Winter: free heat." } },
        { "type": "faq_item", "settings": { "question": "What are the filters?", "answer": "Two, swapped every 3 months, under 2 minutes, no tools. $99 per 6-month box." } },
        { "type": "faq_item", "settings": { "question": "What if it breaks?", "answer": "1-year warranty, real phone support: (213) 335-2121. Terms on the product page." } },
        { "type": "faq_item", "settings": { "question": "Can I return it?", "answer": "30-day money-back guarantee from the day it arrives." } },
        { "type": "faq_item", "settings": { "question": "What does it taste like?", "answer": "Alkaline, mineralized. 93% of surveyed owners rate the taste good or excellent." } }
      ]
    }
  ]
}
{% endschema %}
