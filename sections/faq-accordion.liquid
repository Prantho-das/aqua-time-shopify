<section id="faq" class="section-spacing bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="mb-10 text-center sm:text-left">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-[#088ae3] bg-[#eff9fd] px-3 py-1 rounded-full mb-2.5">
        Help & Clarity
      </span>
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#173b57]">
        {{ section.settings.heading | default: 'Frequently asked questions' }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="text-[#4a6177] text-[15px] mt-2.5 leading-relaxed">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    <div class="space-y-3">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="faq-item border border-[#d9f1fc] rounded-2xl overflow-hidden bg-[#f8fcfd] hover:border-[#088ae3]/40 transition-colors" {{ block.shopify_attributes }}>
            <button class="faq-toggle w-full flex items-center justify-between p-4 sm:p-5 text-left font-heading font-bold text-[15px] text-[#173b57]" aria-expanded="false" aria-controls="faq-content-{{ forloop.index }}">
              <span>{{ block.settings.question }}</span>
              <span class="faq-icon transition-transform duration-200 text-[#088ae3] shrink-0 ml-3">
                {% render 'icon', name: 'chevron-down', class: 'w-4 h-4' %}
              </span>
            </button>
            <div id="faq-content-{{ forloop.index }}" class="faq-content hidden px-5 pb-5 text-sm text-[#4a6177] leading-relaxed border-t border-[#d9f1fc] pt-3 bg-white">
              {{ block.settings.answer }}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Built-in Questions when blocks not yet assigned -->
        <div class="faq-item border border-[#d9f1fc] rounded-2xl overflow-hidden bg-[#f8fcfd] hover:border-[#088ae3]/40 transition-colors">
          <button class="faq-toggle w-full flex items-center justify-between p-4 sm:p-5 text-left font-heading font-bold text-[15px] text-[#173b57]" aria-expanded="false" aria-controls="faq-def-1">
            <span>How much water does an atmospheric water generator produce daily?</span>
            <span class="faq-icon transition-transform duration-200 text-[#088ae3] shrink-0 ml-3">
              {% render 'icon', name: 'chevron-down', class: 'w-4 h-4' %}
            </span>
          </button>
          <div id="faq-def-1" class="faq-content hidden px-5 pb-5 text-sm text-[#4a6177] leading-relaxed border-t border-[#d9f1fc] pt-3 bg-white">
            Standard residential standalone units generate up to 5.5 gallons (20 liters) per day depending on ambient humidity and temperature. Commercial units scale from 50 to 5,000+ liters daily.
          </div>
        </div>

        <div class="faq-item border border-[#d9f1fc] rounded-2xl overflow-hidden bg-[#f8fcfd] hover:border-[#088ae3]/40 transition-colors">
          <button class="faq-toggle w-full flex items-center justify-between p-4 sm:p-5 text-left font-heading font-bold text-[15px] text-[#173b57]" aria-expanded="false" aria-controls="faq-def-2">
            <span>Does it require plumbing or drain line installation?</span>
            <span class="faq-icon transition-transform duration-200 text-[#088ae3] shrink-0 ml-3">
              {% render 'icon', name: 'chevron-down', class: 'w-4 h-4' %}
            </span>
          </button>
          <div id="faq-def-2" class="faq-content hidden px-5 pb-5 text-sm text-[#4a6177] leading-relaxed border-t border-[#d9f1fc] pt-3 bg-white">
            No. Our standalone and countertop machines are 100% plug-and-produce. Simply plug into a standard 110V electrical wall outlet and the machine begins extracting atmospheric humidity.
          </div>
        </div>

        <div class="faq-item border border-[#d9f1fc] rounded-2xl overflow-hidden bg-[#f8fcfd] hover:border-[#088ae3]/40 transition-colors">
          <button class="faq-toggle w-full flex items-center justify-between p-4 sm:p-5 text-left font-heading font-bold text-[15px] text-[#173b57]" aria-expanded="false" aria-controls="faq-def-3">
            <span>What are the operating costs and electrical consumption?</span>
            <span class="faq-icon transition-transform duration-200 text-[#088ae3] shrink-0 ml-3">
              {% render 'icon', name: 'chevron-down', class: 'w-4 h-4' %}
            </span>
          </button>
          <div id="faq-def-3" class="faq-content hidden px-5 pb-5 text-sm text-[#4a6177] leading-relaxed border-t border-[#d9f1fc] pt-3 bg-white">
            Electricity consumption averages ≈5 to 9 kWh per gallon of water generated. At typical US electricity rates ($0.14/kWh), cost is approximately $0.08 to $0.15 per gallon — far less than delivered bottled water.
          </div>
        </div>

        <div class="faq-item border border-[#d9f1fc] rounded-2xl overflow-hidden bg-[#f8fcfd] hover:border-[#088ae3]/40 transition-colors">
          <button class="faq-toggle w-full flex items-center justify-between p-4 sm:p-5 text-left font-heading font-bold text-[15px] text-[#173b57]" aria-expanded="false" aria-controls="faq-def-4">
            <span>Is the air-generated water safe and purified?</span>
            <span class="faq-icon transition-transform duration-200 text-[#088ae3] shrink-0 ml-3">
              {% render 'icon', name: 'chevron-down', class: 'w-4 h-4' %}
            </span>
          </button>
          <div id="faq-def-4" class="faq-content hidden px-5 pb-5 text-sm text-[#4a6177] leading-relaxed border-t border-[#d9f1fc] pt-3 bg-white">
            Yes. Every drop undergoes an 8-stage physical, molecular, and ultraviolet purification cycle including HEPA air filtration, carbon blocks, UV-C sterilization, and alkaline mineralization. Third-party testing confirms zero detectable PFAS or heavy metals.
          </div>
        </div>

        <div class="faq-item border border-[#d9f1fc] rounded-2xl overflow-hidden bg-[#f8fcfd] hover:border-[#088ae3]/40 transition-colors">
          <button class="faq-toggle w-full flex items-center justify-between p-4 sm:p-5 text-left font-heading font-bold text-[15px] text-[#173b57]" aria-expanded="false" aria-controls="faq-def-5">
            <span>What maintenance and filter changes are required?</span>
            <span class="faq-icon transition-transform duration-200 text-[#088ae3] shrink-0 ml-3">
              {% render 'icon', name: 'chevron-down', class: 'w-4 h-4' %}
            </span>
          </button>
          <div id="faq-def-5" class="faq-content hidden px-5 pb-5 text-sm text-[#4a6177] leading-relaxed border-t border-[#d9f1fc] pt-3 bg-white">
            Filter cartridges are easily swapped in under 2 minutes with no tools required. Air filters are replaced every 6 months, and water mineralizing cartridges annually.
          </div>
        </div>
      {% endif %}
    </div>

  </div>
</section>



{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Everything you need to know about generating pure drinking water from ambient air." }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How much water will I get?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Up to 5.5 gal/day depending on your climate. Most owners pour 1 to 3 pitchers." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "How much water will I get?", "answer": "Up to 5.5 gal/day depending on your climate. Most owners pour 1 to 3 pitchers." } },
        { "type": "faq_item", "settings": { "question": "How loud is it?", "answer": "You'll hear it in the room, not the next room. Many owners run it overnight." } },
        { "type": "faq_item", "settings": { "question": "What does it cost to run?", "answer": "≈5 to 9 kWh per gallon plus filters. Your rate sets the price; see the math above." } },
        { "type": "faq_item", "settings": { "question": "Does it heat the room?", "answer": "It vents warm air like a large dehumidifier. Summer: run overnight. Winter: free heat." } },
        { "type": "faq_item", "settings": { "question": "What are the filters?", "answer": "Two, swapped every 3 months, under 2 minutes, no tools. $99 per 6-month box." } },
        { "type": "faq_item", "settings": { "question": "What if it breaks?", "answer": "1-year warranty, real phone support: (123) 456-7890. Terms on the product page." } },
        { "type": "faq_item", "settings": { "question": "Can I return it?", "answer": "30-day money-back guarantee from the day it arrives." } },
        { "type": "faq_item", "settings": { "question": "What does it taste like?", "answer": "Alkaline, mineralized. 93% of surveyed owners rate the taste good or excellent." } }
      ]
    }
  ]
}
{% endschema %}
