<section class="container py-12 lg:py-16">
  <div class="relative rounded-2xl overflow-hidden cta-banner-gradient p-8 sm:p-12 lg:p-14 text-white">

    <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
      
      <div>
        <div class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1.5 rounded-full mb-4 border border-white/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          {{ section.settings.badge | default: 'In stock · Ships immediately' }}
        </div>
        <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-tight">
          {{ section.settings.heading | default: 'Order an air to water generator' }}
        </h2>
        <p class="text-sky-100 text-[15px] mt-2 max-w-lg leading-relaxed">
          {{ section.settings.description | default: '$1,495 — $500 below the $1,995 list price. Ships immediately. 1-year warranty.' }}
        </p>
      </div>

      <div class="flex flex-col items-stretch sm:items-end gap-3 shrink-0 w-full sm:w-auto">
        <button class="open-quote-modal w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white hover:bg-sky-50 text-[#088ae3] text-sm font-bold px-8 py-3.5 rounded-xl shadow-lg transition-all" aria-haspopup="dialog">
          {{ section.settings.btn_text | default: 'Order now' }}
        </button>
        {% if section.settings.phone_number != blank %}
          <span class="text-xs text-sky-200 font-medium text-center sm:text-right">
            Questions? <a href="tel:{{ section.settings.phone_number | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}" class="text-white font-semibold underline hover:text-sky-100">{{ section.settings.phone_number }}</a>
          </span>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA Banner",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "In stock · Ships immediately" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Order an air to water generator" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "$1,495 — $500 below the $1,995 list price. Ships immediately. 1-year warranty." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Order now" },
    { "type": "text", "id": "phone_number", "label": "Phone Number", "default": "(123) 456-7890" }
  ],
  "presets": [{ "name": "CTA Banner" }]
}
{% endschema %}
