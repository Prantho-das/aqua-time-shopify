<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
  <div class="relative rounded-2xl overflow-hidden cta-banner-gradient p-8 sm:p-10 shadow-xl text-white reveal-init">
    
    <!-- Background SVG Geometric Motif -->
    <div class="absolute -left-10 -top-10 w-60 h-60 text-white/10 pointer-events-none">
      {% render 'icon-logo', stroke_width: '2' %}
    </div>

    <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-6">
      
      <div class="flex items-center gap-5">
        <div class="hidden sm:flex w-16 h-16 text-cyan-300 shrink-0">
          {% render 'icon-logo', stroke_width: '2.5' %}
        </div>
        <div>
          <div class="inline-block bg-white/20 backdrop-blur-xs text-white text-[10px] font-extrabold px-2.5 py-0.5 rounded uppercase tracking-wider mb-1.5">
            {{ section.settings.badge | default: 'LIMITED TIME OFFER • SAVE $500' }}
          </div>
          <h2 class="font-heading text-2xl sm:text-3xl font-extrabold tracking-tight text-white leading-tight">
            {{ section.settings.heading | default: 'Ready to Generate Pure Water From Your Own Air?' }}
          </h2>
          <p class="text-sky-100 text-xs sm:text-[13px] mt-1.5 max-w-xl">
            {{ section.settings.description | default: 'Special Launch Pricing: $1,495 (Original $1,995). Units in stock and ship immediately with 1-Year Warranty.' }}
          </p>
        </div>
      </div>

      <div class="flex flex-col items-center sm:items-end gap-2.5 shrink-0">
        <button class="open-quote-modal inline-flex items-center gap-2 bg-white hover:bg-sky-50 text-brand-700 text-[12px] font-bold tracking-wider px-7 py-3 rounded-lg shadow hover:shadow-md transition-all uppercase" aria-haspopup="dialog">
          {{ section.settings.btn_text | default: 'ORDER NOW - $1,495' }}
          {% render 'icon', name: 'arrow-right', class: 'w-3.5 h-3.5' %}
        </button>
        {% if section.settings.phone_number != blank %}
          <span class="text-[12px] text-sky-100 font-normal">
            or speak to an engineer at <a href="tel:{{ section.settings.phone_number | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}" class="text-white font-bold hover:underline">{{ section.settings.phone_number }}</a>
          </span>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "LIMITED TIME OFFER • SAVE $500"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Generate Pure Water From Your Own Air?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Special Launch Pricing: $1,495 (Original $1,995). Units in stock and ship immediately with 1-Year Warranty."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "ORDER NOW - $1,495"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "(213) 335-2121"
    }
  ],
  "presets": [
    {
      "name": "CTA Banner"
    }
  ]
}
{% endschema %}
