<section id="applications" class="section-spacing bg-white">
  <div class="container">
    
    <div class="max-w-2xl mb-10">
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#173b57]">
        {{ section.settings.heading | default: 'Built for the home first' }}
      </h2>

      <div class="space-y-2 text-[15px] text-[#4a6177] leading-relaxed mt-3 max-w-xl">
        <p>{{ section.settings.description_1 | default: 'Atmospheric water generators offer a new approach to water production by capturing moisture already present in the air.' }}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {% for block in section.blocks %}
        <div class="app-card group" {{ block.shopify_attributes }}>
          <div class="relative h-44 overflow-hidden bg-slate-100">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500" loading="lazy">
            {% elsif block.settings.asset_image != blank %}
              <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500" loading="lazy">
            {% endif %}
            <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-[#173b57] text-[10px] font-semibold px-2.5 py-1 rounded-lg">
              {{ block.settings.tag }}
            </span>
          </div>
          
          <div class="p-5 space-y-2">
            <h3 class="font-heading font-bold text-[15px] text-[#173b57] group-hover:text-[#088ae3] transition-colors">
              {{ block.settings.title }}
            </h3>
            <p class="text-sm text-[#4a6177] leading-relaxed">{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Applications Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the home first" },
    { "type": "textarea", "id": "description_1", "label": "Description", "default": "Atmospheric water generators offer a new approach to water production by capturing moisture already present in the air." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Application Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Custom Image" },
        { "type": "text", "id": "asset_image", "label": "Asset Image Filename", "default": "residence-01.jpg" },
        { "type": "text", "id": "tag", "label": "Category Tag", "default": "For daily living" },
        { "type": "text", "id": "title", "label": "Title", "default": "Water for the home" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Use it for drinking, meals, coffee, and other everyday needs without relying on bottled water." },
        { "type": "text", "id": "cta_text", "label": "CTA Text", "default": "Explore" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Applications Grid",
      "blocks": [
        { "type": "card", "settings": { "asset_image": "residence-01.jpg", "tag": "For daily living", "title": "Water for the home", "description": "Use it for drinking, meals, coffee, and other everyday needs without relying on bottled water." } },
        { "type": "card", "settings": { "asset_image": "office-01.jpg", "tag": "For the workplace", "title": "Water for offices", "description": "Provide convenient on-site water while reducing the need for bottled deliveries and disposable containers." } },
        { "type": "card", "settings": { "asset_image": "emergency-response-01.jpg", "tag": "For added security", "title": "Backup water supply", "description": "Maintain access to another water source during service interruptions, emergencies, or unexpected disruptions." } },
        { "type": "card", "settings": { "asset_image": "residence-02.jpg", "tag": "For remote locations", "title": "Water beyond the water line", "description": "Produce water in RVs, remote properties, job sites, and other locations where electricity is available." } }
      ]
    }
  ]
}
{% endschema %}
