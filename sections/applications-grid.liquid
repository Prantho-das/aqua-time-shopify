<section id="applications" class="py-16 lg:py-24 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-2xl space-y-3.5 mb-10 reveal-init">
      <span class="text-[11px] font-extrabold tracking-widest text-brand-600 uppercase">{{ section.settings.badge | default: 'APPLICATIONS' }}</span>
      
      <h2 class="font-heading text-3xl sm:text-4xl font-extrabold text-[#0e1c36] leading-tight">
        {{ section.settings.heading_line1 | default: 'Water Independence' }}<br>
        {{ section.settings.heading_line2 | default: 'For Any Need.' }}
      </h2>

      <p class="text-[#596780] text-sm leading-relaxed">
        {{ section.settings.description | default: 'From home kitchens and corporate break rooms to off-grid cabins and disaster relief, our AWG units deliver pure water wherever you need it.' }}
      </p>

      <div class="pt-1">
        <a href="{{ section.settings.link_url | default: '#why-awg' }}" class="inline-flex items-center gap-1.5 text-[11px] font-bold tracking-wider text-brand-600 hover:text-brand-700 uppercase group">
          {{ section.settings.link_text | default: 'DISCOVER WHERE AWG FITS' }}
          {% render 'icon', name: 'arrow-right', class: 'w-3.5 h-3.5 group-hover:translate-x-1 transition-transform' %}
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 reveal-init delay-200">
      {% for block in section.blocks %}
        <div class="group rounded-2xl overflow-hidden bg-[#f8fbfe] border border-slate-100 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col hover-lift" {{ block.shopify_attributes }}>
          <div class="relative h-48 w-full overflow-hidden bg-slate-100">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async">
            {% elsif block.settings.asset_image != blank %}
              <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async">
            {% else %}
              <img src="{{ 'residence-01.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async">
            {% endif %}
          </div>
          
          <div class="p-4 relative flex-1 flex flex-col justify-between">
            <div class="absolute -top-5 left-4 w-10 h-10 rounded-full bg-white shadow border border-slate-100 flex items-center justify-center text-brand-600 group-hover:bg-brand-600 group-hover:text-white transition-colors">
              {% render 'icon', name: block.settings.icon, class: 'w-4 h-4' %}
            </div>
            <div class="pt-3">
              <h4 class="font-bold text-[13px] text-[#0e1c36] group-hover:text-brand-600 transition-colors">
                {{ block.settings.title }}
              </h4>
              <p class="text-[11px] text-[#596780] mt-1">{{ block.settings.description }}</p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Applications Grid",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "APPLICATIONS"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "Water Independence"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading Line 2",
      "default": "For Any Need."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "From home kitchens and corporate break rooms to off-grid cabins and disaster relief, our AWG units deliver pure water wherever you need it."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "DISCOVER WHERE AWG FITS"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Application Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "asset_image",
          "label": "Asset Image Filename (Fallback)",
          "default": "residence-01.jpg"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Lucide Icon Name",
          "default": "home"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Residential & Kitchens"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Pure drinking & cooking water for the whole family."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Applications Grid",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "asset_image": "residence-01.jpg",
            "icon": "home",
            "title": "Residential & Kitchens",
            "description": "Pure drinking & cooking water for the whole family."
          }
        },
        {
          "type": "card",
          "settings": {
            "asset_image": "office-01.jpg",
            "icon": "briefcase",
            "title": "Commercial & Break Rooms",
            "description": "End 5-gallon jug deliveries and clutter in the office."
          }
        },
        {
          "type": "card",
          "settings": {
            "asset_image": "emergency-response-01.jpg",
            "icon": "shield-alert",
            "title": "Emergency & Disaster Relief",
            "description": "Immediate pure water lifeline when municipal grids fail."
          }
        },
        {
          "type": "card",
          "settings": {
            "asset_image": "residence-02.jpg",
            "icon": "compass",
            "title": "Off-Grid Cabins & Tiny Homes",
            "description": "Complete autonomy without water hookups or wells."
          }
        }
      ]
    }
  ]
}
{% endschema %}
