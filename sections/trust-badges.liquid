<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 relative z-20">
  <div class="bg-[#f2f8fd] border border-[#e1eff8] rounded-2xl shadow-sm py-6 px-8 reveal-init hover-lift">
    <h3 class="text-center font-bold text-[11px] sm:text-[12px] tracking-widest text-[#1e293b] uppercase mb-6">
      {{ section.settings.title | default: 'CERTIFIED PURITY & SUSTAINABILITY STANDARDS' }}
    </h3>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6 items-center justify-items-center">
      {% for block in section.blocks %}
        <div class="flex flex-col items-center gap-2 group cursor-pointer text-center" {{ block.shopify_attributes }}>
          <div class="text-[#0084d6] group-hover:scale-110 transition-transform">
            {% case block.settings.icon_type %}
              {% when 'epa' %}
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              {% when 'who' %}
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                  <path d="M2 12h20"/>
                </svg>
              {% when 'hepa' %}
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
                </svg>
              {% when 'uvc' %}
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2v20"/>
                  <path d="M4.93 4.93l14.14 14.14"/>
                  <path d="M2 12h20"/>
                  <path d="M4.93 19.07l14.14-14.14"/>
                </svg>
              {% when 'solar' %}
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="4"/>
                  <path d="M12 2v2"/>
                  <path d="M12 20v2"/>
                  <path d="m4.93 4.93 1.41 1.41"/>
                  <path d="m17.66 17.66 1.41 1.41"/>
                  <path d="M2 12h2"/>
                  <path d="M20 12h2"/>
                  <path d="m6.34 17.66-1.41 1.41"/>
                  <path d="m19.07 4.93-1.41 1.41"/>
                </svg>
              {% else %}
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
            {% endcase %}
          </div>
          <span class="text-[12px] font-medium text-[#1e293b] group-hover:text-[#0084d6] transition-colors">{{ block.settings.title }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "CERTIFIED PURITY & SUSTAINABILITY STANDARDS"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge Item",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon Type",
          "options": [
            { "value": "epa", "label": "EPA Shield" },
            { "value": "who", "label": "WHO Globe" },
            { "value": "hepa", "label": "HEPA Cloud" },
            { "value": "uvc", "label": "UV-C Rays" },
            { "value": "solar", "label": "Solar Sun" },
            { "value": "warranty", "label": "Warranty Star" }
          ],
          "default": "epa"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Badge Text",
          "default": "EPA Standards"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "icon_type": "epa", "title": "EPA Standards" } },
        { "type": "badge", "settings": { "icon_type": "who", "title": "WHO Compliant" } },
        { "type": "badge", "settings": { "icon_type": "hepa", "title": "HEPA Air Filter" } },
        { "type": "badge", "settings": { "icon_type": "uvc", "title": "UV-C Sterilized" } },
        { "type": "badge", "settings": { "icon_type": "solar", "title": "Solar / Grid Ready" } },
        { "type": "badge", "settings": { "icon_type": "warranty", "title": "1-Year Warranty" } }
      ]
    }
  ]
}
{% endschema %}
