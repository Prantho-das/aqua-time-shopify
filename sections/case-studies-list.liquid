<!-- Case Studies Template -->
<div class="case-studies-page bg-white">
  
  <!-- Hero Section (matching .csh-head) -->
  <section class="relative bg-gradient-to-b from-[#eff9fd] via-[#f8fcfd] to-white pt-20 pb-12 sm:pt-28 sm:pb-16 text-center border-b border-[#d9f1fc]/50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.22em] text-[#088ae3] mb-3">
        {{ section.settings.eyebrow | default: 'Case Studies' }}
      </p>
      <h1 class="font-heading text-3xl sm:text-5xl lg:text-6xl font-extrabold text-[#173b57] tracking-tight leading-[1.08]">
        {{ section.settings.heading | default: 'Water from air, in action.' }}
      </h1>
      <p class="mt-4 sm:mt-5 text-[15px] sm:text-lg text-[#4a6177] leading-relaxed max-w-xl mx-auto">
        {{ section.settings.subheading | default: 'Deployments across five continents — aerospace launch sites, resorts, green campuses and relief operations that make their own drinking water.' }}
      </p>
    </div>
  </section>

  <!-- Featured Case Studies (Alternating Rows matching .csh-feat & .csh-feat--flip) -->
  <section class="py-12 sm:py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 sm:space-y-20 lg:space-y-24">
      
      {% for block in section.blocks %}
        {% assign is_even = forloop.index | modulo: 2 %}
        {% if block.type == 'featured_case' %}
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center group" {{ block.shopify_attributes }}>
            
            <!-- Media Column (16:10 Ratio, Chip Badge, Hover Zoom) -->
            <div class="lg:col-span-7 relative aspect-[16/10] rounded-2xl sm:rounded-3xl overflow-hidden shadow-lg border border-[#d9f1fc]/80 bg-slate-100 {% if is_even == 0 %}lg:order-2{% else %}lg:order-1{% endif %}">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" loading="lazy">
              {% elsif block.settings.asset_image != blank %}
                <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" loading="lazy">
              {% else %}
                <img src="{{ 'office-01.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" loading="lazy">
              {% endif %}
              
              <!-- Frosted Chip Badge -->
              <span class="absolute top-3.5 left-3.5 sm:top-4 sm:left-4 bg-white/90 backdrop-blur-md border border-[#173b57]/10 text-[#173b57] text-[11px] font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full shadow-sm">
                {{ block.settings.category | default: 'Aerospace' }}
              </span>
            </div>

            <!-- Content Column -->
            <div class="lg:col-span-5 space-y-4 {% if is_even == 0 %}lg:order-1{% else %}lg:order-2{% endif %}">
              
              <div class="text-xs font-semibold text-[#088ae3] flex items-center gap-2">
                <span>{{ block.settings.location | default: 'Texas, USA' }}</span>
                <span class="text-slate-300">•</span>
                <span class="text-[#4a6177]">{{ block.settings.environment | default: 'Coastal Climate' }}</span>
              </div>

              <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-[#173b57] tracking-tight leading-tight group-hover:text-[#088ae3] transition-colors">
                {{ block.settings.title }}
              </h2>

              <p class="text-[15px] text-[#4a6177] leading-relaxed">
                {{ block.settings.description }}
              </p>

              <!-- Metric Pills -->
              {% if block.settings.metric_1 != blank or block.settings.metric_2 != blank %}
                <div class="grid grid-cols-2 gap-3 py-2">
                  {% if block.settings.metric_1 != blank %}
                    <div class="p-3 bg-[#f8fcfd] rounded-xl border border-[#d9f1fc]">
                      <span class="text-[10px] uppercase font-bold text-[#4a6177] block">{{ block.settings.metric_1_label | default: 'Capacity' }}</span>
                      <span class="font-heading font-extrabold text-sm sm:text-base text-[#088ae3]">{{ block.settings.metric_1 }}</span>
                    </div>
                  {% endif %}
                  {% if block.settings.metric_2 != blank %}
                    <div class="p-3 bg-[#f8fcfd] rounded-xl border border-[#d9f1fc]">
                      <span class="text-[10px] uppercase font-bold text-[#4a6177] block">{{ block.settings.metric_2_label | default: 'Impact' }}</span>
                      <span class="font-heading font-extrabold text-sm sm:text-base text-[#173b57]">{{ block.settings.metric_2 }}</span>
                    </div>
                  {% endif %}
                </div>
              {% endif %}

              <div class="pt-2">
                <a href="{{ block.settings.cta_link | default: '/pages/contact' }}" class="inline-flex items-center gap-2 font-bold text-sm text-[#088ae3] hover:text-[#0776c4] group/btn">
                  <span>{{ block.settings.cta_text | default: 'Read the story' }}</span>
                  <svg class="w-4 h-4 group-hover/btn:translate-x-1.5 transition-transform" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 8h10M9 4l4 4-4 4"/>
                  </svg>
                </a>
              </div>

            </div>

          </div>
        {% endif %}
      {% endfor %}

      <!-- 2-Column Grid for Secondary Case Studies (matching .csh-grid) -->
      <div class="pt-10 border-t border-[#d9f1fc]">
        <h3 class="font-heading text-xl sm:text-2xl font-bold text-[#173b57] mb-8 text-center sm:text-left">
          More Deployments & Field Operations
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-10">
          {% for block in section.blocks %}
            {% if block.type == 'grid_case' %}
              <div class="group flex flex-col space-y-4" {{ block.shopify_attributes }}>
                <div class="relative aspect-[16/10] rounded-2xl overflow-hidden shadow-md border border-[#d9f1fc] bg-slate-100">
                  {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy">
                  {% elsif block.settings.asset_image != blank %}
                    <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy">
                  {% else %}
                    <img src="{{ 'emergency-response-01.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy">
                  {% endif %}
                  <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md border border-[#173b57]/10 text-[#173b57] text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full">
                    {{ block.settings.category | default: 'Field Operation' }}
                  </span>
                </div>

                <div class="space-y-1.5">
                  <h4 class="font-heading text-lg font-bold text-[#173b57] group-hover:text-[#088ae3] transition-colors">
                    {{ block.settings.title }}
                  </h4>
                  <p class="text-xs sm:text-sm text-[#4a6177] leading-relaxed">
                    {{ block.settings.description }}
                  </p>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

    </div>
  </section>

  <!-- Bottom CTA Section -->
  <section class="py-16 sm:py-24 bg-gradient-to-b from-white via-[#eff9fd] to-[#d9f1fc]/40 text-center border-t border-[#d9f1fc]">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h2 class="font-heading text-3xl sm:text-4xl font-extrabold text-[#173b57] tracking-tight">
        Start a story of <span class="bg-gradient-to-r from-[#088ae3] to-[#43a5ff] bg-clip-text text-transparent">your own.</span>
      </h2>
      <p class="text-sm sm:text-base text-[#4a6177] leading-relaxed">
        Tell us your location, water volume requirements, and intended application. Our engineers will configure the right atmospheric water solution.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="/pages/contact" class="btn-primary py-3.5 px-7 text-sm font-bold flex items-center gap-2 shadow-lg shadow-[#088ae3]/25">
          <span>Talk to an Expert</span>
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 8h10M9 4l4 4-4 4"/>
          </svg>
        </a>
        <a href="/pages/how-it-works" class="px-6 py-3.5 rounded-xl border border-[#173b57]/20 text-[#173b57] hover:bg-white text-sm font-bold transition-all">
          Explore Technology
        </a>
      </div>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "Case Studies",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Case Studies"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Water from air, in action."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Deployments across five continents — aerospace launch sites, resorts, green campuses and relief operations that make their own drinking water."
    }
  ],
  "blocks": [
    {
      "type": "featured_case",
      "name": "Featured Story (Row)",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Custom Image" },
        { "type": "text", "id": "asset_image", "label": "Asset Image Filename", "default": "office-01.jpg" },
        { "type": "text", "id": "category", "label": "Category Tag", "default": "Workplace Deployment" },
        { "type": "text", "id": "location", "label": "Location", "default": "Austin, Texas" },
        { "type": "text", "id": "environment", "label": "Environment", "default": "74°F · 68% Humidity" },
        { "type": "text", "id": "title", "label": "Story Title", "default": "Corporate Headquarters — 5-gallon jug deliveries eliminated" },
        { "type": "textarea", "id": "description", "label": "Story Description", "default": "High recurring monthly invoices, physical lifting hazards, and storage congestion from empty bottle stacks were replaced with on-site atmospheric water generators operating with zero incoming plumbing connections." },
        { "type": "text", "id": "metric_1_label", "label": "Metric 1 Label", "default": "Daily Output" },
        { "type": "text", "id": "metric_1", "label": "Metric 1 Value", "default": "11 Gal/Day" },
        { "type": "text", "id": "metric_2_label", "label": "Metric 2 Label", "default": "Annual Impact" },
        { "type": "text", "id": "metric_2", "label": "Metric 2 Value", "default": "$2,400 Saved/Yr" },
        { "type": "text", "id": "cta_text", "label": "CTA Link Text", "default": "Read the story" },
        { "type": "url", "id": "cta_link", "label": "CTA Link" }
      ]
    },
    {
      "type": "grid_case",
      "name": "Secondary Story (Card)",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Custom Image" },
        { "type": "text", "id": "asset_image", "label": "Asset Image Filename", "default": "emergency-response-01.jpg" },
        { "type": "text", "id": "category", "label": "Category Tag", "default": "Emergency Relief" },
        { "type": "text", "id": "title", "label": "Title", "default": "American Red Cross & FEMA Relief Operations" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Rapid deployment units providing vital drinking water to coastal communities affected by severe hurricane infrastructure outages." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Case Studies",
      "blocks": [
        {
          "type": "featured_case",
          "settings": {
            "asset_image": "office-01.jpg",
            "category": "Corporate Campus",
            "location": "Austin, Texas",
            "environment": "74°F · 68% Humidity",
            "title": "Enterprise Campus — water from air on a green facility",
            "description": "On-site standalone AWG units generate pure mineralized drinking water continuously for employees, completely removing recurring delivery logistics and plastic waste.",
            "metric_1_label": "Daily Capacity",
            "metric_1": "11 Gal/Day",
            "metric_2_label": "Annual Impact",
            "metric_2": "$2,400 Saved/Yr",
            "cta_text": "Read the story"
          }
        },
        {
          "type": "featured_case",
          "settings": {
            "asset_image": "residence-01.jpg",
            "category": "Residential Resilience",
            "location": "Hill Country, Texas",
            "environment": "82°F · 55% Humidity",
            "title": "Hill Country Residence — water independent of contaminated wells",
            "description": "In areas with high groundwater arsenic and heavy mineral scaling, residential AWG systems produce clean drinking water directly from air without complex reverse-osmosis wastewater.",
            "metric_1_label": "Generation",
            "metric_1": "5.5 Gal/Day",
            "metric_2_label": "Purity",
            "metric_2": "100% PFAS-Free",
            "cta_text": "Read the story"
          }
        },
        {
          "type": "featured_case",
          "settings": {
            "asset_image": "residence-02.jpg",
            "category": "Remote Living & Off-Grid",
            "location": "West Texas Ranch",
            "environment": "85°F · 45% Humidity",
            "title": "Remote Ranch Facility — water beyond the pipeline",
            "description": "Off-grid solar-compatible AWG systems generating vital freshwater for staff and visitors where municipal water infrastructure is unavailable.",
            "metric_1_label": "Power Setup",
            "metric_1": "Solar / Grid",
            "metric_2_label": "Autonomy",
            "metric_2": "100% On-Site",
            "cta_text": "Read the story"
          }
        },
        {
          "type": "grid_case",
          "settings": {
            "asset_image": "emergency-response-01.jpg",
            "category": "Disaster Response",
            "title": "Hurricane Preparedness & Mobile Emergency Relief",
            "description": "Providing guaranteed clean water access during municipal boil-water notices and utility pipe disruptions."
          }
        },
        {
          "type": "grid_case",
          "settings": {
            "asset_image": "office-02.jpg",
            "category": "Hospitality & Healthcare",
            "title": "Medical Center & Clinic Patient Hydration",
            "description": "Ultra-purified, multi-stage filtered alkaline water delivered right at patient reception areas."
          }
        }
      ]
    }
  ]
}
{% endschema %}
