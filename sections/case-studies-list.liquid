<section id="case-studies" class="py-16 sm:py-20 lg:py-24 bg-white">
  <div class="container">
    
    <!-- Hero Header matching Watergen -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="inline-block text-xs font-bold tracking-widest uppercase text-[#088ae3] bg-[#eff9fd] px-4 py-1.5 rounded-full mb-3">
        Case Studies
      </span>
      <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#173b57] tracking-tight">
        {{ section.settings.heading | default: 'Water from air, in action.' }}
      </h1>
      <p class="text-[#4a6177] text-base sm:text-lg mt-4 leading-relaxed max-w-2xl mx-auto">
        {{ section.settings.subheading | default: 'Deployments across residential communities, corporate offices, relief operations and remote sites that make their own drinking water.' }}
      </p>
    </div>

    <!-- Case Studies Alternating Grid matching Watergen -->
    <div class="space-y-16 lg:space-y-20">
      {% for block in section.blocks %}
        {% assign is_even = forloop.index | modulo: 2 %}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center group" {{ block.shopify_attributes }}>
          
          <!-- Image Column with Pill Chip (Alternates side) -->
          <div class="lg:col-span-6 relative aspect-[16/10] rounded-3xl overflow-hidden shadow-lg border border-[#d9f1fc] bg-slate-100 {% if is_even == 0 %}lg:order-2{% else %}lg:order-1{% endif %}">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy">
            {% elsif block.settings.asset_image != blank %}
              <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy">
            {% else %}
              <img src="{{ 'office-01.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy">
            {% endif %}
            <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-md text-[#173b57] text-xs font-bold px-3.5 py-1.5 rounded-full shadow-sm">
              {{ block.settings.category | default: 'Workplace Deployment' }}
            </span>
          </div>

          <!-- Story Details Column -->
          <div class="lg:col-span-6 space-y-5 {% if is_even == 0 %}lg:order-1{% else %}lg:order-2{% endif %}">
            
            <div class="flex items-center gap-2 text-xs font-semibold text-[#088ae3]">
              {% render 'icon', name: 'map-pin', class: 'w-3.5 h-3.5' %}
              <span>{{ block.settings.location | default: 'Austin, Texas' }}</span>
              <span class="text-slate-300">•</span>
              <span class="text-[#4a6177]">{{ block.settings.environment | default: '72°F · 65% Humidity' }}</span>
            </div>

            <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-[#173b57] group-hover:text-[#088ae3] transition-colors leading-tight">
              {{ block.settings.title }}
            </h2>

            <p class="text-[15px] text-[#4a6177] leading-relaxed">
              {{ block.settings.challenge }}
            </p>

            <div class="p-4 rounded-2xl bg-[#f8fcfd] border border-[#d9f1fc] space-y-2">
              <span class="text-xs font-bold uppercase tracking-wider text-[#173b57] block">The Deployment:</span>
              <p class="text-xs sm:text-sm text-[#4a6177] leading-relaxed">{{ block.settings.solution }}</p>
            </div>

            <div class="pt-2 flex flex-wrap items-center justify-between gap-4 border-t border-[#d9f1fc]">
              <div class="flex items-center gap-6">
                <div>
                  <span class="text-[11px] text-[#4a6177] block font-medium">Measured Output</span>
                  <span class="font-heading font-extrabold text-base text-[#088ae3]">{{ block.settings.metric_1 | default: '11 Gal/Day' }}</span>
                </div>
                <div>
                  <span class="text-[11px] text-[#4a6177] block font-medium">Impact Result</span>
                  <span class="font-heading font-extrabold text-base text-[#173b57]">{{ block.settings.metric_2 | default: '$2,400/yr Saved' }}</span>
                </div>
              </div>
              
              <a href="{{ block.settings.cta_link | default: '/products/hydrocell-standup' }}" class="inline-flex items-center gap-1.5 font-bold text-xs text-[#088ae3] hover:text-[#0776c4] group/link">
                <span>{{ block.settings.cta_text | default: 'View Machine Specs' }}</span>
                <span class="group-hover/link:translate-x-1 transition-transform">→</span>
              </a>
            </div>

          </div>

        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Case Studies List",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Water from air, in action."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Deployments across residential communities, corporate offices, relief operations and remote sites that make their own drinking water."
    }
  ],
  "blocks": [
    {
      "type": "case_study",
      "name": "Case Study",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Custom Image" },
        { "type": "text", "id": "asset_image", "label": "Asset Image Filename", "default": "office-01.jpg" },
        { "type": "text", "id": "category", "label": "Category", "default": "Workplace Deployment" },
        { "type": "text", "id": "location", "label": "Location", "default": "Austin, Texas" },
        { "type": "text", "id": "environment", "label": "Climate Conditions", "default": "74°F · 68% Humidity" },
        { "type": "text", "id": "title", "label": "Title", "default": "Corporate Office Eliminates 5-Gallon Plastic Jug Deliveries" },
        { "type": "textarea", "id": "challenge", "label": "The Challenge", "default": "High recurring monthly invoices, lifting 42lb jugs causing workplace hazards, and storage congestion from empty bottle stacks." },
        { "type": "textarea", "id": "solution", "label": "The Solution", "default": "Two HydroCell™ units installed directly in main break rooms with zero plumbing connections or external drain lines required." },
        { "type": "text", "id": "metric_1", "label": "Output Metric", "default": "11 Gal/Day" },
        { "type": "text", "id": "metric_2", "label": "Impact Metric", "default": "$2,400/yr Saved" },
        { "type": "text", "id": "cta_text", "label": "CTA Text", "default": "View Machine Specs" },
        { "type": "url", "id": "cta_link", "label": "CTA Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Case Studies List",
      "blocks": [
        {
          "type": "case_study",
          "settings": {
            "asset_image": "office-01.jpg",
            "category": "Workplace Deployment",
            "location": "Austin, Texas",
            "environment": "74°F · 68% Humidity",
            "title": "Corporate Office Eliminates 5-Gallon Plastic Jug Deliveries",
            "challenge": "High recurring monthly invoices, lifting 42lb jugs causing workplace hazards, and storage congestion from empty bottle stacks.",
            "solution": "Two HydroCell™ units installed directly in main break rooms with zero plumbing connections or external drain lines required.",
            "metric_1": "11 Gal/Day",
            "metric_2": "$2,400/yr Saved"
          }
        },
        {
          "type": "case_study",
          "settings": {
            "asset_image": "residence-01.jpg",
            "category": "Residential Resilience",
            "location": "Hill Country, Texas",
            "environment": "82°F · 55% Humidity",
            "title": "Family Secures Reliable Drinking Water Beyond Municipal Lines",
            "challenge": "High mineral hardness and arsenic concerns in local groundwater well supply requiring redundant backup.",
            "solution": "HydroCell™ unit capturing clean atmospheric humidity independent of well water or municipal piping.",
            "metric_1": "5.5 Gal/Day",
            "metric_2": "100% PFAS-Free"
          }
        },
        {
          "type": "case_study",
          "settings": {
            "asset_image": "emergency-response-01.jpg",
            "category": "Emergency Response",
            "location": "Gulf Coast Facility",
            "environment": "85°F · 80% Humidity",
            "title": "Critical Facility Maintains Continuous Hydration During Grid Disruptions",
            "challenge": "Boil-water notices and hurricane season supply disruptions risking operational safety and compliance.",
            "solution": "Solar-compatible AWG backup system providing guaranteed fresh water during utility grid outages.",
            "metric_1": "20L/Day",
            "metric_2": "Zero Grid Reliance"
          }
        }
      ]
    }
  ]
}
{% endschema %}
