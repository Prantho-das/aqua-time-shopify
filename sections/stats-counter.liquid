<section id="stats-section" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 relative z-20">
  <div class="bg-white rounded-2xl border border-slate-100 shadow-md p-6 sm:p-8 reveal-init hover-lift">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 divide-y-2 md:divide-y-0 md:divide-x-2 divide-slate-50">
      {% for block in section.blocks %}
        <div class="flex flex-col items-center text-center p-2 {% if forloop.index > 2 %}pt-6 md:pt-2{% endif %}" {{ block.shopify_attributes }}>
          <div class="text-brand-600 mb-2">
            {% render 'icon', name: block.settings.icon, class: 'w-6 h-6 text-brand-600' %}
          </div>
          <div class="font-heading text-3xl font-extrabold text-[#0e1c36] stat-counter" 
               data-target="{{ block.settings.target }}" 
               data-prefix="{{ block.settings.prefix | default: '' }}" 
               data-suffix="{{ block.settings.suffix | default: '' }}">
            {{ block.settings.prefix }}0{{ block.settings.suffix }}
          </div>
          <div class="font-bold text-[12px] text-[#0e1c36] mt-1">{{ block.settings.title }}</div>
          <div class="text-[11px] text-[#596780]">{{ block.settings.subtitle }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stats Counter",
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Lucide Icon Name",
          "default": "cloud-rain"
        },
        {
          "type": "text",
          "id": "target",
          "label": "Target Value (Number)",
          "default": "3"
        },
        {
          "type": "text",
          "id": "prefix",
          "label": "Prefix (e.g. $)"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix (e.g. .1Q Gal)",
          "default": ".1Q Gal"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Atmospheric Water"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Renewable Earth Reservoir"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats Counter",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "icon": "cloud-rain",
            "target": "3",
            "suffix": ".1Q Gal",
            "title": "Atmospheric Water",
            "subtitle": "Renewable Earth Reservoir"
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "trash-2",
            "target": "4000",
            "suffix": "+",
            "title": "Plastic Bottles Diverted",
            "subtitle": "Per Unit Annually"
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "shield-check",
            "target": "99",
            "suffix": ".9%",
            "title": "Pathogen Elimination",
            "subtitle": "UV-C & HEPA Purity"
          }
        },
        {
          "type": "stat",
          "settings": {
            "icon": "dollar-sign",
            "target": "8",
            "suffix": "¢ / Gal",
            "title": "Generation Cost",
            "subtitle": "vs $1.50+ Bottled Jugs"
          }
        }
      ]
    }
  ]
}
{% endschema %}
