<section id="lab-reports" class="py-16 sm:py-20 lg:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-widest text-[#088ae3] bg-[#eff9fd] uppercase mb-3">
        Third-Party Certified Transparency
      </span>
      <h1 class="font-heading text-3xl sm:text-5xl font-extrabold text-[#0e1c36] tracking-tight">
        What the Lab Reports Say
      </h1>
      <p class="mt-4 text-sm sm:text-base text-[#4a6177] leading-relaxed">
        In the HydroCell™ water samples tested by independent, ISO-accredited drinking water laboratories, targeted contaminants returned as <strong class="text-[#0e1c36]">NOT DETECTED</strong>.
      </p>
    </div>

    <!-- Key Metrics Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="bg-[#f8fcfd] rounded-2xl p-6 border border-[#d9f1fc] text-center">
        <span class="text-xs font-extrabold text-[#088ae3] uppercase tracking-wider block mb-1">Independent Labs</span>
        <span class="font-heading font-black text-3xl text-[#0e1c36] block">SimpleLab & Pace</span>
        <p class="text-xs text-[#4a6177] mt-2">Accredited testing by Microbac, Pace Analytical, and EMSL Analytical.</p>
      </div>

      <div class="bg-[#f8fcfd] rounded-2xl p-6 border border-[#d9f1fc] text-center">
        <span class="text-xs font-extrabold text-emerald-600 uppercase tracking-wider block mb-1">Contaminants Screened</span>
        <span class="font-heading font-black text-3xl text-emerald-600 block">100+ Analytes</span>
        <p class="text-xs text-[#4a6177] mt-2">Zero detectable PFAS, microplastics, arsenic, nitrates, or heavy metals.</p>
      </div>

      <div class="bg-[#f8fcfd] rounded-2xl p-6 border border-[#d9f1fc] text-center">
        <span class="text-xs font-extrabold text-[#088ae3] uppercase tracking-wider block mb-1">Taste & Minerals</span>
        <span class="font-heading font-black text-3xl text-[#0e1c36] block">pH 6.5 – 8.5</span>
        <p class="text-xs text-[#4a6177] mt-2">Naturally alkaline, mineralized, crisp taste rated excellent by 93% of owners.</p>
      </div>
    </div>

    <!-- Lab Test Results Table -->
    <div class="bg-white rounded-2xl border border-[#d9f1fc] overflow-hidden shadow-sm mb-12">
      <div class="bg-[#0e1c36] text-white p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="font-heading font-bold text-lg">Tested Analytes Summary & Comparison</h2>
          <span class="text-xs text-slate-300">Methodology: EPA 537.1 / EPA 200.8 / SM 4500-NO3 / FTIR</span>
        </div>
        <span class="bg-[#088ae3] text-white text-[11px] font-bold px-3 py-1 rounded-md w-fit">
          VERIFIED ISO/IEC 17025
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-xs sm:text-sm text-left border-collapse">
          <thead>
            <tr class="bg-[#f8fcfd] border-b border-[#d9f1fc] text-[#0e1c36] font-bold">
              <th class="p-4">Analyte / Compound</th>
              <th class="p-4">EPA Limit</th>
              <th class="p-4">Typical Municipal Tap</th>
              <th class="p-4 text-right">HydroCell™ Result</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#d9f1fc] text-[#4a6177]">
            <tr class="hover:bg-[#f0f9ff]/50">
              <td class="p-4 font-bold text-[#0e1c36]">PFAS (PFOA & PFOS Forever Chemicals)</td>
              <td class="p-4">4.0 ng/L</td>
              <td class="p-4 text-rose-600 font-semibold">25.0 ng/L (Detected)</td>
              <td class="p-4 text-right font-bold text-emerald-600 bg-emerald-50/50">NOT DETECTED (<0.5)</td>
            </tr>
            <tr class="hover:bg-[#f0f9ff]/50">
              <td class="p-4 font-bold text-[#0e1c36]">Arsenic (Total Inorganic)</td>
              <td class="p-4">10 µg/L</td>
              <td class="p-4 text-rose-600 font-semibold">7.5 µg/L (Detected)</td>
              <td class="p-4 text-right font-bold text-emerald-600 bg-emerald-50/50">NOT DETECTED (<0.2)</td>
            </tr>
            <tr class="hover:bg-[#f0f9ff]/50">
              <td class="p-4 font-bold text-[#0e1c36]">Nitrates (NO3-N)</td>
              <td class="p-4">10 mg/L</td>
              <td class="p-4 text-rose-600 font-semibold">0.73 mg/L (Detected)</td>
              <td class="p-4 text-right font-bold text-emerald-600 bg-emerald-50/50">NOT DETECTED (<0.05)</td>
            </tr>
            <tr class="hover:bg-[#f0f9ff]/50">
              <td class="p-4 font-bold text-[#0e1c36]">Microplastics (>0.01 micron)</td>
              <td class="p-4">N/A</td>
              <td class="p-4 text-rose-600 font-semibold">325 particles/L</td>
              <td class="p-4 text-right font-bold text-emerald-600 bg-emerald-50/50">NOT DETECTED (0)</td>
            </tr>
            <tr class="hover:bg-[#f0f9ff]/50">
              <td class="p-4 font-bold text-[#0e1c36]">Lead & Copper</td>
              <td class="p-4">15 µg/L</td>
              <td class="p-4 text-amber-600 font-semibold">Variable (Pipe leach)</td>
              <td class="p-4 text-right font-bold text-emerald-600 bg-emerald-50/50">NOT DETECTED (<0.1)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Note & Transparency Section -->
    <div class="bg-[#f8fcfd] rounded-2xl p-6 sm:p-8 border border-[#d9f1fc] max-w-4xl mx-auto text-center space-y-4">
      <h3 class="font-heading text-lg font-bold text-[#0e1c36]">A Note About These Results</h3>
      <p class="text-xs sm:text-sm text-[#4a6177] leading-relaxed">
        These findings reflect individual water samples tested under controlled conditions by SimpleLab and accredited partners. Water quality can vary based on your environment, filter condition, and routine maintenance schedule. We recommend an annual third-party test to confirm ongoing pristine performance.
      </p>
      <div class="pt-2">
        <a href="/pages/contact" class="inline-flex items-center gap-1 text-xs font-bold text-[#088ae3] hover:underline">
          Have a question about a specific test result? Contact our water quality team →
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lab Reports",
  "settings": [],
  "presets": [
    {
      "name": "Lab Reports"
    }
  ]
}
{% endschema %}
