<div class="collections-page bg-white">
  
  <section class="relative bg-gradient-to-b from-[#eff9fd] via-[#f8fcfd] to-white pt-20 pb-12 sm:pt-28 sm:pb-16 text-center border-b border-[#d9f1fc]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-[#088ae3] bg-[#eff9fd] border border-[#d9f1fc] px-4 py-1.5 rounded-full mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-[#088ae3] animate-pulse"></span>
        Water Systems Portfolio
      </span>
      <h1 class="font-heading text-3xl sm:text-5xl lg:text-6xl font-extrabold text-[#173b57] tracking-tight leading-[1.08]">
        Atmospheric Water Systems
      </h1>
      <p class="mt-4 sm:mt-5 text-[15px] sm:text-lg text-[#4a6177] leading-relaxed max-w-2xl mx-auto">
        Explore autonomous on-site water generators engineered for homes, modern workplaces, commercial facilities, and remote off-grid operations.
      </p>
    </div>
  </section>

  <div class="border-b border-[#d9f1fc] bg-[#f8fcfd]/80 py-5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        <div class="space-y-0.5">
          <span class="font-heading font-extrabold text-sm sm:text-base text-[#173b57]">100% Plug-and-Play</span>
          <p class="text-[11px] text-[#4a6177]">No plumbing or drain lines needed</p>
        </div>
        <a href="/pages/lab-report" class="space-y-0.5 group block hover:text-[#088ae3] transition-colors">
          <span class="font-heading font-extrabold text-sm sm:text-base text-[#173b57] group-hover:text-[#088ae3]">Zero PFAS & Heavy Metals</span>
          <p class="text-[11px] text-[#4a6177] group-hover:text-[#088ae3]">Independently lab tested →</p>
        </a>
        <div class="space-y-0.5">
          <span class="font-heading font-extrabold text-sm sm:text-base text-[#173b57]">≈ $0.50 / Gallon</span>
          <p class="text-[11px] text-[#4a6177]">Electricity and filters</p>
        </div>
        <div class="space-y-0.5">
          <span class="font-heading font-extrabold text-sm sm:text-base text-[#173b57]">1-Year Warranty</span>
          <p class="text-[11px] text-[#4a6177]">Direct support</p>
        </div>
      </div>
    </div>
  </div>

  <section class="py-14 sm:py-20 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {%- assign all_prods = collections['all'].products -%}
        {%- if all_prods.size > 0 -%}
          {%- for product in all_prods -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        {%- else -%}
          {%- if all_products['hydrocell-standup'] != blank -%}
            {% render 'product-card', product: all_products['hydrocell-standup'] %}
          {%- endif -%}
          {%- if all_products['hydrocell-2-units'] != blank -%}
            {% render 'product-card', product: all_products['hydrocell-2-units'] %}
          {%- endif -%}
          {%- if all_products['hydrocell-3-units'] != blank -%}
            {% render 'product-card', product: all_products['hydrocell-3-units'] %}
          {%- endif -%}
          {%- if all_products['filter-replacement-kits'] != blank -%}
            {% render 'product-card', product: all_products['filter-replacement-kits'] %}
          {%- endif -%}
        {%- endif -%}

        <div class="bg-white rounded-3xl border border-[#d9f1fc] overflow-hidden hover:border-[#088ae3]/60 hover:shadow-xl transition-all group flex flex-col justify-between shadow-sm">
          <div>
            <div class="p-8 bg-gradient-to-b from-[#eff9fd] to-white border-b border-[#d9f1fc] flex items-center justify-center relative aspect-[4/3]">
              <span class="absolute top-4 left-4 bg-[#173b57] text-white text-[10px] font-extrabold uppercase tracking-wider px-3 py-1 rounded-full shadow-sm">
                HIGH OUTPUT & OFF-GRID
              </span>
              <div class="w-28 h-28 rounded-3xl bg-[#eff9fd] border border-[#d9f1fc] shadow-sm flex items-center justify-center text-[#173b57] group-hover:scale-105 transition-transform">
                {% render 'icon', name: 'building', class: 'w-12 h-12 text-[#088ae3]' %}
              </div>
            </div>

            <div class="p-6 sm:p-7 space-y-4">
              <div class="flex justify-between items-baseline gap-2">
                <h2 class="font-heading font-bold text-xl sm:text-2xl text-[#173b57]">Commercial & Industrial</h2>
                <span class="font-heading font-bold text-xs text-[#088ae3] bg-[#eff9fd] border border-[#d9f1fc] px-2.5 py-1 rounded-md uppercase">Custom Spec</span>
              </div>

              <p class="text-xs sm:text-sm text-[#4a6177] leading-relaxed">
                Industrial and commercial skid installations scaling from 50 to 5,000+ liters daily. Optimized for business facilities, schools, and emergency relief.
              </p>

              <div class="flex flex-wrap gap-2 pt-2 text-[11px] font-bold text-[#173b57]">
                <span class="bg-[#eff9fd] border border-[#d9f1fc] px-3 py-1 rounded-full text-[#088ae3]">50–500+ Gal/Day</span>
                <span class="bg-[#eff9fd] border border-[#d9f1fc] px-3 py-1 rounded-full text-[#088ae3]">Solar Ready</span>
                <span class="bg-[#eff9fd] border border-[#d9f1fc] px-3 py-1 rounded-full text-[#088ae3]">Skid Mount</span>
              </div>
            </div>
          </div>

          <div class="p-6 sm:p-7 pt-0">
            <a href="/pages/contact?interest=commercial" class="block w-full text-center px-6 py-3 rounded-xl border border-[#088ae3] text-[#088ae3] hover:bg-[#eff9fd] text-xs font-bold transition-all">
              REQUEST COMMERCIAL SPEC
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "Collections List",
  "settings": [],
  "presets": [
    {
      "name": "Collections List"
    }
  ]
}
{% endschema %}
