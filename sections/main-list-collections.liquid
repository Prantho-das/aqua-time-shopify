<section class="py-16 sm:py-20 lg:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-widest text-[#088ae3] bg-[#eff9fd] uppercase mb-3">
        Water Solutions at Every Scale
      </span>
      <h1 class="font-heading text-3xl sm:text-5xl font-extrabold text-[#0e1c36] tracking-tight">
        Atmospheric Water Systems
      </h1>
      <p class="mt-4 text-sm sm:text-base text-[#4a6177] leading-relaxed">
        Explore on-site water generation systems tailored for homes, workplaces, commercial facilities, and remote off-grid environments.
      </p>
    </div>

    <!-- Collections Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Card 1: HydroCell Standup -->
      <div class="bg-[#f8fcfd] rounded-2xl border border-[#d9f1fc] overflow-hidden hover:border-[#088ae3] hover:shadow-lg transition-all group flex flex-col justify-between">
        <div>
          <div class="p-8 bg-white border-b border-[#d9f1fc] flex items-center justify-center relative aspect-[4/3]">
            <span class="absolute top-4 left-4 bg-[#088ae3] text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full">
              POPULAR RESIDENTIAL
            </span>
            <img src="{{ 'chatgpt-image.jpg' | asset_url }}" alt="HydroCell Standup" class="max-h-48 object-contain group-hover:scale-105 transition-transform duration-300">
          </div>
          <div class="p-6 space-y-3">
            <div class="flex justify-between items-baseline">
              <h2 class="font-heading font-bold text-xl text-[#0e1c36]">HydroCell™ STANDUP</h2>
              <span class="font-heading font-black text-lg text-[#088ae3]">$1,495</span>
            </div>
            <p class="text-xs text-[#4a6177] leading-relaxed">
              Generates up to 20L (5.28 gal)/day directly from humidity. No plumbing required, hot & cold instant dispense.
            </p>
            <div class="flex flex-wrap gap-2 pt-1 text-[11px] font-bold text-slate-600">
              <span class="bg-white border border-[#d9f1fc] px-2.5 py-1 rounded-md">20L/Day</span>
              <span class="bg-white border border-[#d9f1fc] px-2.5 py-1 rounded-md">19L Storage</span>
              <span class="bg-white border border-[#d9f1fc] px-2.5 py-1 rounded-md">8-Stage Purifier</span>
            </div>
          </div>
        </div>
        <div class="p-6 pt-0">
          <a href="/products/hydrocell-standup" class="block w-full text-center bg-[#088ae3] hover:bg-[#0776c4] text-white font-bold py-3 rounded-xl text-xs uppercase tracking-wider transition-all">
            VIEW HYDROCELL™ ($1,495)
          </a>
        </div>
      </div>

      <!-- Card 2: Filter Kits -->
      <div class="bg-[#f8fcfd] rounded-2xl border border-[#d9f1fc] overflow-hidden hover:border-[#088ae3] hover:shadow-lg transition-all group flex flex-col justify-between">
        <div>
          <div class="p-8 bg-white border-b border-[#d9f1fc] flex items-center justify-center relative aspect-[4/3]">
            <span class="absolute top-4 left-4 bg-emerald-600 text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full">
              MAINTENANCE & REFILL
            </span>
            <div class="w-24 h-24 rounded-2xl bg-[#eff9fd] flex items-center justify-center text-[#088ae3] group-hover:scale-105 transition-transform">
              <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            </div>
          </div>
          <div class="p-6 space-y-3">
            <div class="flex justify-between items-baseline">
              <h2 class="font-heading font-bold text-xl text-[#0e1c36]">Filter Replacement Kits</h2>
              <span class="font-heading font-black text-lg text-[#088ae3]">$100</span>
            </div>
            <p class="text-xs text-[#4a6177] leading-relaxed">
              Pre-bundled 6, 12, 18, and 24-month maintenance cartridges for continuous non-detect water quality.
            </p>
            <div class="flex flex-wrap gap-2 pt-1 text-[11px] font-bold text-slate-600">
              <span class="bg-white border border-[#d9f1fc] px-2.5 py-1 rounded-md">2-Min Swap</span>
              <span class="bg-white border border-[#d9f1fc] px-2.5 py-1 rounded-md">Tool-Free</span>
              <span class="bg-white border border-[#d9f1fc] px-2.5 py-1 rounded-md">OEM Quality</span>
            </div>
          </div>
        </div>
        <div class="p-6 pt-0">
          <a href="/products/filter-replacement-kits" class="block w-full text-center bg-[#088ae3] hover:bg-[#0776c4] text-white font-bold py-3 rounded-xl text-xs uppercase tracking-wider transition-all">
            VIEW REFILL KITS ($100)
          </a>
        </div>
      </div>

      <!-- Card 3: Commercial & Custom Sizing -->
      <div class="bg-[#f8fcfd] rounded-2xl border border-[#d9f1fc] overflow-hidden hover:border-[#088ae3] hover:shadow-lg transition-all group flex flex-col justify-between">
        <div>
          <div class="p-8 bg-white border-b border-[#d9f1fc] flex items-center justify-center relative aspect-[4/3]">
            <span class="absolute top-4 left-4 bg-purple-600 text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full">
              COMMERCIAL & SCALE
            </span>
            <div class="w-24 h-24 rounded-2xl bg-purple-50 flex items-center justify-center text-purple-600 group-hover:scale-105 transition-transform">
              <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
              </svg>
            </div>
          </div>
          <div class="p-6 space-y-3">
            <div class="flex justify-between items-baseline">
              <h2 class="font-heading font-bold text-xl text-[#0e1c36]">Commercial & Off-Grid</h2>
              <span class="font-heading font-bold text-xs text-[#088ae3] uppercase">Custom Quote</span>
            </div>
            <p class="text-xs text-[#4a6177] leading-relaxed">
              Modular skid systems producing 50 to 500+ gallons daily for offices, campuses, industrial sites, and emergency backup.
            </p>
            <div class="flex flex-wrap gap-2 pt-1 text-[11px] font-bold text-slate-600">
              <span class="bg-white border border-[#d9f1fc] px-2.5 py-1 rounded-md">50–500 Gal/Day</span>
              <span class="bg-white border border-[#d9f1fc] px-2.5 py-1 rounded-md">Solar Compatible</span>
            </div>
          </div>
        </div>
        <div class="p-6 pt-0">
          <a href="/pages/how-it-works#system-selector" class="block w-full text-center border border-[#088ae3] text-[#088ae3] hover:bg-[#f0f9ff] font-bold py-3 rounded-xl text-xs uppercase tracking-wider transition-all">
            SIZE YOUR SYSTEM
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

