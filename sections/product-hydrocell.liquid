<section class="py-12 sm:py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- Product Images Gallery -->
      <div class="lg:col-span-6 space-y-4">
        <div class="bg-[#f8fcfd] rounded-2xl border border-[#d9f1fc] p-6 sm:p-10 flex items-center justify-center relative overflow-hidden group">
          <div class="absolute top-4 left-4 z-10 flex flex-col gap-2">
            <span class="bg-[#088ae3] text-white text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-sm">
              SAVE $500 NOW
            </span>
            <span class="bg-emerald-600 text-white text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-sm">
              IN STOCK • SHIPS TODAY
            </span>
          </div>

          <div class="relative w-full max-w-sm aspect-[3/4] flex items-center justify-center">
            <img src="{{ 'chatgpt-image.jpg' | asset_url }}" alt="HydroCell Standup Atmospheric Water Generator" class="max-h-[460px] object-contain drop-shadow-xl group-hover:scale-105 transition-transform duration-500" loading="eager">
          </div>
        </div>

        <!-- Thumbnails / Features Row -->
        <div class="grid grid-cols-3 gap-3">
          <div class="bg-[#f8fcfd] border border-[#d9f1fc] rounded-xl p-3 text-center">
            <span class="block font-heading font-black text-base text-[#088ae3]">20L / Day</span>
            <span class="text-[11px] text-[#4a6177]">Max Pure Yield</span>
          </div>
          <div class="bg-[#f8fcfd] border border-[#d9f1fc] rounded-xl p-3 text-center">
            <span class="block font-heading font-black text-base text-[#088ae3]">19L Tank</span>
            <span class="text-[11px] text-[#4a6177]">Internal Storage</span>
          </div>
          <div class="bg-[#f8fcfd] border border-[#d9f1fc] rounded-xl p-3 text-center">
            <span class="block font-heading font-black text-base text-emerald-600">Hot & Cold</span>
            <span class="text-[11px] text-[#4a6177]">Instant Dispense</span>
          </div>
        </div>
      </div>

      <!-- Product Details / Purchase Area -->
      <div class="lg:col-span-6 space-y-6">
        <div>
          <span class="text-xs font-extrabold text-[#088ae3] uppercase tracking-widest block mb-2">
            HYDROCELL™ AIR-TO-WATER GENERATOR
          </span>
          <h1 class="font-heading text-3xl sm:text-4xl font-extrabold text-[#0e1c36] tracking-tight">
            HydroCell™ STANDUP
          </h1>
          <p class="font-medium text-base text-[#088ae3] mt-1">
            Pure Drinking Water Straight from the Air
          </p>
        </div>

        <!-- Pricing Card -->
        <div class="bg-[#f8fcfd] border border-[#d9f1fc] rounded-2xl p-5 flex items-baseline gap-4">
          <span class="font-heading font-black text-3xl sm:text-4xl text-[#0e1c36]">$1,495.00</span>
          <span class="text-lg text-slate-400 line-through font-semibold">$1,995.00</span>
          <span class="text-xs font-bold text-emerald-700 bg-emerald-100 px-2.5 py-1 rounded-md">
            Save $500 (Limited Batch)
          </span>
        </div>

        <p class="text-sm text-[#4a6177] leading-relaxed">
          A convenient indoor water source for homes, offices, and event spaces. No heavy jugs or scheduled deliveries—just fresh drinking water produced when you need it. Set it up, switch it on, and start making water from the air.
        </p>

        <!-- CTAs -->
        <div class="space-y-3 pt-2">
          <button class="open-quote-modal w-full bg-[#088ae3] hover:bg-[#0776c4] text-white font-bold py-4 rounded-xl text-sm tracking-wider uppercase shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2">
            <span>BUY NOW — $1,495.00</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          
          <div class="grid grid-cols-2 gap-3">
            <a href="#specifications" class="text-center py-3 rounded-xl border border-[#d9f1fc] bg-white hover:bg-[#f8fcfd] text-xs font-bold text-[#0e1c36] tracking-wider uppercase transition-all">
              FULL SPECIFICATIONS
            </a>
            <a href="/pages/contact" class="text-center py-3 rounded-xl border border-[#088ae3] text-[#088ae3] hover:bg-[#f0f9ff] text-xs font-bold tracking-wider uppercase transition-all">
              TALK TO AN EXPERT
            </a>
          </div>
        </div>

        <!-- 3 Core Pillars -->
        <div class="pt-4 border-t border-slate-100 space-y-3">
          <h3 class="font-heading text-base font-bold text-[#0e1c36]">Why Buy a HydroCell™?</h3>
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="bg-white border border-[#d9f1fc] p-4 rounded-xl">
              <span class="block text-xs font-bold text-[#088ae3] uppercase mb-1">01. Health</span>
              <p class="text-xs text-[#4a6177] leading-relaxed">
                Delivers 100% contaminant-free water with zero PFAS, lead, nitrates, or microplastics.
              </p>
            </div>

            <div class="bg-white border border-[#d9f1fc] p-4 rounded-xl">
              <span class="block text-xs font-bold text-[#088ae3] uppercase mb-1">02. Independence</span>
              <p class="text-xs text-[#4a6177] leading-relaxed">
                Works anywhere electricity is available—no plumbing pipes or plastic bottle deliveries.
              </p>
            </div>

            <div class="bg-white border border-[#d9f1fc] p-4 rounded-xl">
              <span class="block text-xs font-bold text-[#088ae3] uppercase mb-1">03. Impact</span>
              <p class="text-xs text-[#4a6177] leading-relaxed">
                Replaces 14,000 bottles/yr; cuts 1.2 tons CO₂/yr; produces water at just $0.06/L.
              </p>
            </div>
          </div>
        </div>

        <!-- Trust Features -->
        <div class="flex items-center gap-6 text-xs text-[#4a6177] pt-2">
          <div class="flex items-center gap-1.5 font-semibold">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            1-Year Warranty
          </div>
          <div class="flex items-center gap-1.5 font-semibold">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            30-Day Money-Back
          </div>
          <div class="flex items-center gap-1.5 font-semibold">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            Free Freight Shipping
          </div>
        </div>

      </div>
    </div>

    <!-- Specifications Table Section -->
    <div id="specifications" class="mt-20 pt-16 border-t border-slate-200">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10">
          <span class="text-xs font-bold text-[#088ae3] uppercase tracking-widest">Engineering Data</span>
          <h2 class="font-heading text-3xl font-extrabold text-[#0e1c36] mt-1">
            Technical Specifications
          </h2>
        </div>

        <div class="bg-white border border-[#d9f1fc] rounded-2xl overflow-hidden shadow-sm">
          <table class="w-full text-xs sm:text-sm text-left border-collapse">
            <tbody class="divide-y divide-slate-100">
              <tr class="bg-[#f8fcfd]">
                <td class="p-4 font-bold text-[#0e1c36] w-1/2">Daily Water Generation</td>
                <td class="p-4 text-[#4a6177]">Up to 20 L / 5.28 gal a day (@ 30°C / 86°F, 80% RH)</td>
              </tr>
              <tr>
                <td class="p-4 font-bold text-[#0e1c36]">Internal Storage Capacity</td>
                <td class="p-4 text-[#4a6177]">19 Liters total (Upper ambient, cold, and hot tanks combined)</td>
              </tr>
              <tr class="bg-[#f8fcfd]">
                <td class="p-4 font-bold text-[#0e1c36]">Dimensions (W × D × H)</td>
                <td class="p-4 text-[#4a6177]">14.8 × 12.1 × 45.4 inches (37.6 × 30.7 × 115.3 cm)</td>
              </tr>
              <tr>
                <td class="p-4 font-bold text-[#0e1c36]">Net Weight</td>
                <td class="p-4 text-[#4a6177]">105 lbs (47.6 kg)</td>
              </tr>
              <tr class="bg-[#f8fcfd]">
                <td class="p-4 font-bold text-[#0e1c36]">Cold Water Temperature</td>
                <td class="p-4 text-[#4a6177]">43°F / 6°C (Instant chilled)</td>
              </tr>
              <tr>
                <td class="p-4 font-bold text-[#0e1c36]">Hot Water Temperature</td>
                <td class="p-4 text-[#4a6177]">185°F / 85°C (Child-locked tea & coffee dispense)</td>
              </tr>
              <tr class="bg-[#f8fcfd]">
                <td class="p-4 font-bold text-[#0e1c36]">Operating Climate Range</td>
                <td class="p-4 text-[#4a6177]">59–113°F (15–45°C) & 30–99% Relative Humidity</td>
              </tr>
              <tr>
                <td class="p-4 font-bold text-[#0e1c36]">Electrical Requirements</td>
                <td class="p-4 text-[#4a6177]">110-120V / 60Hz standard 3-prong grounded wall outlet</td>
              </tr>
              <tr class="bg-[#f8fcfd]">
                <td class="p-4 font-bold text-[#0e1c36]">Purification Architecture</td>
                <td class="p-4 text-[#4a6177]">8-Stage: Air + Softening + Sediment + UF + Carbon + Electropositive + Dual UV-C</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>

