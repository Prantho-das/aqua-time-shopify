<section class="py-12 sm:py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- Product Graphic -->
      <div class="lg:col-span-5 space-y-4">
        <div class="bg-[#f8fcfd] rounded-2xl border border-[#d9f1fc] p-8 flex items-center justify-center relative overflow-hidden">
          <div class="w-full max-w-xs aspect-square rounded-2xl bg-white border border-[#d9f1fc] flex flex-col items-center justify-center p-6 text-center shadow-sm">
            <div class="w-20 h-20 rounded-full bg-[#eff9fd] flex items-center justify-center text-[#088ae3] mb-4">
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            </div>
            <h3 class="font-heading font-bold text-lg text-[#0e1c36]">HydroCell™ Maintenance Pack</h3>
            <span class="text-xs text-[#088ae3] font-bold mt-1">Pre-Bundled Cartridge Kits</span>
          </div>
        </div>

        <div class="bg-[#f8fcfd] border border-[#d9f1fc] rounded-xl p-4 text-xs text-[#4a6177] flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold shrink-0">
            ⚡
          </div>
          <div>
            <span class="font-bold text-[#0e1c36] block">2-Minute Tool-Free Swap</span>
            Quick-twist cartridge architecture allows effortless filter refresh.
          </div>
        </div>
      </div>

      <!-- Purchase & Overview -->
      <div class="lg:col-span-7 space-y-6">
        <div>
          <span class="text-xs font-extrabold text-[#088ae3] uppercase tracking-widest block mb-2">
            GENUINE REPLACEMENT MEDIA
          </span>
          <h1 class="font-heading text-3xl sm:text-4xl font-extrabold text-[#0e1c36] tracking-tight">
            HydroCell™ Filter Replacement Kits
          </h1>
          <p class="font-medium text-base text-[#4a6177] mt-1">
            The filtration system does the work. Routine maintenance keeps it going.
          </p>
        </div>

        <!-- Pricing Card -->
        <div class="bg-[#f8fcfd] border border-[#d9f1fc] rounded-2xl p-5 flex items-baseline gap-4">
          <span class="font-heading font-black text-3xl text-[#0e1c36]">$100.00</span>
          <span class="text-xs font-bold text-[#088ae3] bg-[#eff9fd] px-2.5 py-1 rounded-md">
            Direct OEM Supply • Free Shipping
          </span>
        </div>

        <p class="text-sm text-[#4a6177] leading-relaxed">
          HydroCell™ Replacement Filter Kits are pre-bundled maintenance packs engineered to keep your unit’s 8-stage purification system operating at peak performance and lab-tested non-detect standards.
        </p>

        <!-- Buy Action -->
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <button class="open-quote-modal flex-1 bg-[#088ae3] hover:bg-[#0776c4] text-white font-bold py-3.5 rounded-xl text-xs tracking-wider uppercase shadow transition-all">
            ORDER REPLACEMENT KIT ($100)
          </button>
          <a href="/pages/contact" class="text-center px-6 py-3.5 rounded-xl border border-[#088ae3] text-[#088ae3] hover:bg-[#f0f9ff] text-xs font-bold tracking-wider uppercase transition-all">
            TALK TO AN EXPERT
          </a>
        </div>
      </div>
    </div>

    <!-- 24-Month Maintenance Routine Grid -->
    <div class="mt-16 pt-12 border-t border-slate-200">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold text-[#088ae3] uppercase tracking-widest">Maintenance Schedule</span>
        <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-[#0e1c36] mt-1">
          The 24-Month Refill Cycle
        </h2>
        <p class="text-xs sm:text-sm text-[#4a6177] mt-2">
          Here is what is included in each milestone kit. After Month 24, the cycle repeats to keep purification consistent over time.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <!-- Month 6 -->
        <div class="bg-[#f8fcfd] border border-[#d9f1fc] rounded-2xl p-5 hover:border-[#088ae3] transition-all">
          <span class="font-heading font-black text-xl text-[#088ae3] block mb-1">Month 6</span>
          <h3 class="font-bold text-sm text-[#0e1c36] mb-3">Standard Refresh</h3>
          <ul class="space-y-2 text-xs text-[#4a6177]">
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Softening Filter</li>
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Sediment Filter</li>
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Carbon Block Filter</li>
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Electropositive Membrane</li>
          </ul>
        </div>

        <!-- Month 12 -->
        <div class="bg-[#f8fcfd] border border-[#d9f1fc] rounded-2xl p-5 hover:border-[#088ae3] transition-all">
          <span class="font-heading font-black text-xl text-[#088ae3] block mb-1">Month 12</span>
          <h3 class="font-bold text-sm text-[#0e1c36] mb-3">Standard + UF Membrane</h3>
          <ul class="space-y-2 text-xs text-[#4a6177]">
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Softening Filter</li>
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Sediment Filter</li>
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Carbon Block Filter</li>
            <li class="flex items-center gap-1.5 font-bold text-[#0e1c36]"><span class="text-[#088ae3]">✓</span> Ultra-Fine Membrane</li>
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Electropositive Membrane</li>
          </ul>
        </div>

        <!-- Month 18 -->
        <div class="bg-[#f8fcfd] border border-[#d9f1fc] rounded-2xl p-5 hover:border-[#088ae3] transition-all">
          <span class="font-heading font-black text-xl text-[#088ae3] block mb-1">Month 18</span>
          <h3 class="font-bold text-sm text-[#0e1c36] mb-3">Standard + UV Lamps</h3>
          <ul class="space-y-2 text-xs text-[#4a6177]">
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Softening Filter</li>
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Sediment Filter</li>
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Carbon Block Filter</li>
            <li class="flex items-center gap-1.5 font-bold text-[#0e1c36]"><span class="text-[#088ae3]">✓</span> Bottom Tank LED-UV</li>
            <li class="flex items-center gap-1.5 font-bold text-[#0e1c36]"><span class="text-[#088ae3]">✓</span> Top Tank LED-UV</li>
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Electropositive Membrane</li>
          </ul>
        </div>

        <!-- Month 24 -->
        <div class="bg-[#f8fcfd] border border-[#d9f1fc] rounded-2xl p-5 hover:border-[#088ae3] transition-all">
          <span class="font-heading font-black text-xl text-[#088ae3] block mb-1">Month 24</span>
          <h3 class="font-bold text-sm text-[#0e1c36] mb-3">Standard + UF Membrane</h3>
          <ul class="space-y-2 text-xs text-[#4a6177]">
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Softening Filter</li>
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Sediment Filter</li>
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Carbon Block Filter</li>
            <li class="flex items-center gap-1.5 font-bold text-[#0e1c36]"><span class="text-[#088ae3]">✓</span> Ultra-Fine Membrane</li>
            <li class="flex items-center gap-1.5"><span class="text-[#088ae3]">✓</span> Electropositive Membrane</li>
          </ul>
        </div>

      </div>
    </div>
  </div>
</section>

