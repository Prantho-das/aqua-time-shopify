<div class="product-filter-kit-page bg-white">
  
  <!-- Breadcrumb -->
  <div class="border-b border-[#d9f1fc] bg-[#f8fcfd]/70 py-3.5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-xs font-semibold text-[#4a6177]">
        <a href="/" class="hover:text-[#088ae3] transition-colors">Home</a>
        <span>/</span>
        <a href="/collections" class="hover:text-[#088ae3] transition-colors">Products</a>
        <span>/</span>
        <span class="text-[#173b57] font-bold">Filter Replacement Kits</span>
      </div>
    </div>
  </div>

  <!-- SECTION 1 — HERO & REPLACEMENT KIT SELECTION -->
  <section class="py-10 sm:py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        
        <!-- Product Graphic / Gallery -->
        <div class="lg:col-span-5 space-y-4 lg:sticky lg:top-24">
          <div class="bg-gradient-to-b from-[#eff9fd] via-[#f8fcfd] to-white rounded-3xl border border-[#d9f1fc] p-8 flex items-center justify-center relative overflow-hidden shadow-sm">
            <span class="absolute top-5 left-5 bg-emerald-600 text-white text-[11px] font-extrabold uppercase tracking-wider px-3.5 py-1 rounded-full shadow-sm">
              GENUINE OEM REFILL
            </span>

            <div class="w-full max-w-xs aspect-square rounded-3xl bg-white border border-[#d9f1fc] flex flex-col items-center justify-center p-8 text-center shadow-sm">
              <div class="w-24 h-24 rounded-2xl bg-[#eff9fd] flex items-center justify-center text-[#088ae3] mb-4">
                {% render 'icon', name: 'filter', class: 'w-12 h-12 text-[#088ae3]' %}
              </div>
              <h3 id="selected-kit-title" class="font-heading font-extrabold text-xl text-[#173b57]">Month 6 Refill Kit</h3>
              <span id="selected-kit-tag" class="text-xs text-[#088ae3] font-bold mt-1">Standard Refresh Pack</span>
            </div>
          </div>

          <div class="bg-[#f8fcfd] border border-[#d9f1fc] rounded-2xl p-4 text-xs text-[#4a6177] flex items-center gap-3 shadow-sm">
            <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg shrink-0">
              ⚡
            </div>
            <div>
              <span class="font-bold text-[#173b57] block">2-Minute Tool-Free Twist Lock</span>
              Quick-swap cartridge architecture allows effortless filter refresh with zero tools required.
            </div>
          </div>
        </div>

        <!-- Purchase & Milestone Options -->
        <div class="lg:col-span-7 space-y-6">
          <div>
            <span class="text-xs font-bold text-[#088ae3] uppercase tracking-[0.2em] block mb-2">
              HYDROCELL™ FILTER REPLACEMENTS
            </span>
            <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#173b57] tracking-tight">
              HydroCell™ Filter Replacement Kits
            </h1>
            <h2 class="font-heading text-xl sm:text-2xl font-bold text-[#088ae3] mt-2">
              The filtration system does the work. Routine maintenance keeps it going.
            </h2>
          </div>

          <!-- Pricing Card -->
          <div class="bg-[#f8fcfd] border border-[#d9f1fc] rounded-3xl p-6 flex flex-wrap items-baseline justify-between gap-3 shadow-sm">
            <div class="flex items-baseline gap-3">
              <span id="kit-price" class="font-heading font-extrabold text-3xl sm:text-4xl text-[#173b57]">$100.00</span>
              <span id="kit-term" class="text-xs text-[#4a6177]">6-Month Service Interval</span>
            </div>
            <span class="text-xs font-bold text-[#088ae3] bg-[#eff9fd] border border-[#d9f1fc] px-3.5 py-1 rounded-full">
              Direct OEM Supply • Free US Shipping
            </span>
          </div>

          <p class="text-sm sm:text-base text-[#4a6177] leading-relaxed">
            HydroCell™ Replacement Filter Kits are pre-bundled maintenance packs designed to keep your unit’s purification system performing consistently over time.
          </p>

          <!-- Milestone Kit Selection Cards (Interactive) -->
          <div class="space-y-3 pt-2">
            <span class="text-xs font-bold uppercase tracking-wider text-[#173b57] block">
              Select Your Maintenance Milestone:
            </span>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <button type="button" class="milestone-btn p-3.5 rounded-2xl border-2 border-[#088ae3] bg-[#eff9fd] text-center cursor-pointer shadow-sm transition-all text-left w-full" data-month="6" data-price="$100.00" data-name="Month 6 Refill Kit" data-tag="Standard Refresh Pack" data-term="6-Month Service Interval">
                <span class="font-heading font-extrabold text-sm text-[#173b57] block">Month 6</span>
                <span class="text-[11px] text-[#088ae3] font-bold block">$100.00</span>
                <span class="text-[10px] text-[#4a6177] block mt-0.5">Standard Refresh</span>
              </button>

              <button type="button" class="milestone-btn p-3.5 rounded-2xl border border-[#d9f1fc] bg-white text-center cursor-pointer hover:border-[#088ae3] shadow-sm transition-all text-left w-full" data-month="12" data-price="$150.00" data-name="Month 12 Refill Kit" data-tag="Standard Refresh + UF Membrane" data-term="12-Month Service Interval">
                <span class="font-heading font-extrabold text-sm text-[#173b57] block">Month 12</span>
                <span class="text-[11px] text-[#088ae3] font-bold block">$150.00</span>
                <span class="text-[10px] text-[#4a6177] block mt-0.5">+ UF Membrane</span>
              </button>

              <button type="button" class="milestone-btn p-3.5 rounded-2xl border border-[#d9f1fc] bg-white text-center cursor-pointer hover:border-[#088ae3] shadow-sm transition-all text-left w-full" data-month="18" data-price="$180.00" data-name="Month 18 Refill Kit" data-tag="Standard Refresh + Dual UV Lamps" data-term="18-Month Service Interval">
                <span class="font-heading font-extrabold text-sm text-[#173b57] block">Month 18</span>
                <span class="text-[11px] text-[#088ae3] font-bold block">$180.00</span>
                <span class="text-[10px] text-[#4a6177] block mt-0.5">+ UV Lamps</span>
              </button>

              <button type="button" class="milestone-btn p-3.5 rounded-2xl border border-[#d9f1fc] bg-white text-center cursor-pointer hover:border-[#088ae3] shadow-sm transition-all text-left w-full" data-month="24" data-price="$220.00" data-name="Month 24 Refill Kit" data-tag="Complete Cycle Reset" data-term="24-Month Full Overhaul">
                <span class="font-heading font-extrabold text-sm text-[#173b57] block">Month 24</span>
                <span class="text-[11px] text-[#088ae3] font-bold block">$220.00</span>
                <span class="text-[10px] text-[#4a6177] block mt-0.5">Complete Reset</span>
              </button>
            </div>
          </div>

          <!-- Included Cartridges in Active Milestone -->
          <div class="bg-white rounded-2xl border border-[#d9f1fc] p-5 space-y-2.5 shadow-sm text-xs">
            <span class="text-xs font-bold text-[#173b57] uppercase tracking-wider block border-b border-[#d9f1fc] pb-2">
              Cartridges Included In Selected Kit:
            </span>
            <div id="kit-cartridges-list" class="space-y-1.5 text-xs text-[#4a6177]">
              <div class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Softening Filter (anti-scale protection)</div>
              <div class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Sediment Filter (removes particles &gt; 5 microns)</div>
              <div class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Pre-Carbon Block Filter (chlorine, taste &amp; odor)</div>
              <div class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Electropositive Membrane Filter (microbial barrier)</div>
            </div>
          </div>

          <!-- Buy Action -->
          <div class="flex flex-col sm:flex-row gap-3 pt-2">
            <button id="order-kit-btn" class="open-quote-modal flex-1 btn-primary py-4 text-xs font-bold tracking-wider uppercase shadow hover:shadow-lg transition-all flex items-center justify-center gap-2" aria-haspopup="dialog">
              <span>BUY NOW — $100.00</span>
              {% render 'icon', name: 'arrow-right', class: 'w-4 h-4 text-white' %}
            </button>
            <a href="/pages/contact" class="text-center px-6 py-4 rounded-xl border border-[#d9f1fc] text-[#173b57] hover:text-[#088ae3] hover:border-[#088ae3] text-xs font-bold tracking-wider uppercase transition-all">
              TALK TO AN EXPERT
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="flex flex-wrap items-center gap-6 text-xs text-[#4a6177] pt-2 border-t border-[#d9f1fc]">
            <div class="flex items-center gap-1.5 font-bold text-[#173b57]">
              {% render 'icon', name: 'shield-check', class: 'w-4 h-4 text-[#088ae3]' %}
              100% OEM Guarantee
            </div>
            <div class="flex items-center gap-1.5 font-bold text-[#173b57]">
              {% render 'icon', name: 'check-circle', class: 'w-4 h-4 text-emerald-600' %}
              Free Priority US Shipping
            </div>
            <div class="flex items-center gap-1.5 font-bold text-[#173b57]">
              {% render 'icon', name: 'zap', class: 'w-4 h-4 text-[#088ae3]' %}
              Tool-Free Twist Lock
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION 2 — THE REFILL KIT (From Docx) -->
      <div class="mt-20 pt-16 border-t border-[#d9f1fc]">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#088ae3] bg-[#eff9fd] px-3.5 py-1.5 rounded-full mb-2">
            Full Refill Schedule
          </span>
          <h2 class="font-heading text-3xl sm:text-4xl font-extrabold text-[#173b57]">
            The Refill Kit
          </h2>
          <p class="text-sm sm:text-base text-[#4a6177] mt-2">
            Here’s what’s included in each kit.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Month 6 -->
          <div class="bg-white border border-[#d9f1fc] rounded-3xl p-6 shadow-sm hover:border-[#088ae3]/60 transition-all space-y-3">
            <span class="font-heading font-extrabold text-2xl text-[#088ae3] block">Month 6</span>
            <h3 class="font-bold text-sm text-[#173b57]">Standard Refresh</h3>
            <ul class="space-y-2 text-xs text-[#4a6177] pt-2 border-t border-[#d9f1fc]">
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Softening filter</li>
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Sediment filter</li>
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Carbon filter</li>
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Electropositive membrane filter</li>
            </ul>
          </div>

          <!-- Month 12 -->
          <div class="bg-white border border-[#d9f1fc] rounded-3xl p-6 shadow-sm hover:border-[#088ae3]/60 transition-all space-y-3">
            <span class="font-heading font-extrabold text-2xl text-[#088ae3] block">Month 12</span>
            <h3 class="font-bold text-sm text-[#173b57]">Standard Refresh + Ultra-Fine Membrane</h3>
            <ul class="space-y-2 text-xs text-[#4a6177] pt-2 border-t border-[#d9f1fc]">
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Softening filter</li>
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Sediment filter</li>
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Carbon filter</li>
              <li class="flex items-center gap-2 font-bold text-[#173b57]"><span class="text-[#088ae3]">✓</span> Ultra-fine membrane filter</li>
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Electropositive membrane filter</li>
            </ul>
          </div>

          <!-- Month 18 -->
          <div class="bg-white border border-[#d9f1fc] rounded-3xl p-6 shadow-sm hover:border-[#088ae3]/60 transition-all space-y-3">
            <span class="font-heading font-extrabold text-2xl text-[#088ae3] block">Month 18</span>
            <h3 class="font-bold text-sm text-[#173b57]">Standard Refresh + UV Lamps</h3>
            <ul class="space-y-2 text-xs text-[#4a6177] pt-2 border-t border-[#d9f1fc]">
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Softening filter</li>
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Sediment filter</li>
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Carbon filter</li>
              <li class="flex items-center gap-2 font-bold text-[#173b57]"><span class="text-[#088ae3]">✓</span> Bottom tank LED-UV lamp</li>
              <li class="flex items-center gap-2 font-bold text-[#173b57]"><span class="text-[#088ae3]">✓</span> Top tank LED-UV lamp</li>
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Electropositive membrane filter</li>
            </ul>
          </div>

          <!-- Month 24 -->
          <div class="bg-white border border-[#d9f1fc] rounded-3xl p-6 shadow-sm hover:border-[#088ae3]/60 transition-all space-y-3">
            <span class="font-heading font-extrabold text-2xl text-[#088ae3] block">Month 24</span>
            <h3 class="font-bold text-sm text-[#173b57]">Standard Refresh + Ultra-Fine Membrane (repeat)</h3>
            <ul class="space-y-2 text-xs text-[#4a6177] pt-2 border-t border-[#d9f1fc]">
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Softening filter</li>
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Sediment filter</li>
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Carbon filter</li>
              <li class="flex items-center gap-2 font-bold text-[#173b57]"><span class="text-[#088ae3]">✓</span> Ultra-fine membrane filter</li>
              <li class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> Electropositive membrane filter</li>
            </ul>
          </div>

        </div>

        <div class="mt-8 text-center p-6 bg-[#f8fcfd] border border-[#d9f1fc] rounded-2xl max-w-3xl mx-auto">
          <p class="text-xs sm:text-sm text-[#4a6177] font-medium">
            After Month 24, the cycle repeats with the same 6-month milestones to keep purification performance consistent over time.
          </p>
        </div>
      </div>
    </div>
  </section>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var buttons = document.querySelectorAll('.milestone-btn');
    var priceEl = document.getElementById('kit-price');
    var termEl = document.getElementById('kit-term');
    var titleEl = document.getElementById('selected-kit-title');
    var tagEl = document.getElementById('selected-kit-tag');
    var orderBtn = document.getElementById('order-kit-btn');
    var listEl = document.getElementById('kit-cartridges-list');

    var cartMap = {
      '6': [
        'Softening filter',
        'Sediment filter (5µm)',
        'Carbon filter',
        'Electropositive membrane filter'
      ],
      '12': [
        'Softening filter',
        'Sediment filter (5µm)',
        'Carbon filter',
        'Ultra-fine membrane filter (0.01µm)',
        'Electropositive membrane filter'
      ],
      '18': [
        'Softening filter',
        'Sediment filter (5µm)',
        'Carbon filter',
        'Bottom tank LED-UV lamp',
        'Top tank LED-UV lamp',
        'Electropositive membrane filter'
      ],
      '24': [
        'Softening filter',
        'Sediment filter (5µm)',
        'Carbon filter',
        'Ultra-fine membrane filter (0.01µm)',
        'Electropositive membrane filter'
      ]
    };

    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        buttons.forEach(function(b) {
          b.classList.remove('border-2', 'border-[#088ae3]', 'bg-[#eff9fd]');
          b.classList.add('border', 'border-[#d9f1fc]', 'bg-white');
        });
        btn.classList.remove('border', 'border-[#d9f1fc]', 'bg-white');
        btn.classList.add('border-2', 'border-[#088ae3]', 'bg-[#eff9fd]');

        var m = btn.getAttribute('data-month');
        var price = btn.getAttribute('data-price');
        var name = btn.getAttribute('data-name');
        var tag = btn.getAttribute('data-tag');
        var term = btn.getAttribute('data-term');

        if (priceEl) priceEl.textContent = price;
        if (termEl) termEl.textContent = term;
        if (titleEl) titleEl.textContent = name;
        if (tagEl) tagEl.textContent = tag;
        if (orderBtn) {
          orderBtn.querySelector('span').textContent = 'BUY NOW — ' + price;
        }

        if (listEl && cartMap[m]) {
          listEl.innerHTML = cartMap[m].map(function(item) {
            return '<div class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> ' + item + '</div>';
          }).join('');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Product Filter Kit",
  "settings": [],
  "presets": [
    {
      "name": "Product Filter Kit"
    }
  ]
}
{% endschema %}
