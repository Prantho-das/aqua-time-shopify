<!-- Client-side Instant Dispatcher for Environment Resiliency -->
<script>
  (function() {
    function routeProduct() {
      var isFilter = window.location.pathname.indexOf('filter') !== -1;
      var hydroView = document.getElementById('view-hydrocell-standup');
      var filterView = document.getElementById('view-filter-kits');
      var climateSection = document.getElementById('climate-production');
      var compSection = document.getElementById('comparison');

      if (isFilter) {
        if (hydroView) hydroView.style.display = 'none';
        if (filterView) filterView.style.display = 'block';
        if (climateSection) climateSection.style.display = 'none';
        if (compSection) compSection.style.display = 'none';
        document.title = 'Filter Replacement Kits – aqua-time';
      } else {
        if (hydroView) hydroView.style.display = 'block';
        if (filterView) filterView.style.display = 'none';
        if (climateSection) climateSection.style.display = 'block';
        if (compSection) compSection.style.display = 'block';
      }
    }

    routeProduct();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', routeProduct);
    }
  })();

  document.addEventListener('DOMContentLoaded', function() {
    var buttons = document.querySelectorAll('.milestone-btn');
    var priceEl = document.getElementById('kit-price');
    var termEl = document.getElementById('kit-term');
    var titleEl = document.getElementById('selected-kit-title');
    var tagEl = document.getElementById('selected-kit-tag');
    var orderBtn = document.getElementById('order-kit-btn');
    var listEl = document.getElementById('kit-cartridges-list');

    var cartMap = {
      '6': [
        'Softening filter (anti-scale protection)',
        'Sediment filter (5µm particles)',
        'Pre-Carbon block filter',
        'Electropositive membrane filter'
      ],
      '12': [
        'Softening filter (anti-scale protection)',
        'Sediment filter (5µm particles)',
        'Pre-Carbon block filter',
        'Ultra-fine membrane filter (0.01µm barrier)',
        'Electropositive membrane filter'
      ],
      '18': [
        'Softening filter (anti-scale protection)',
        'Sediment filter (5µm particles)',
        'Pre-Carbon block filter',
        'Bottom tank LED-UV lamp',
        'Top tank LED-UV lamp',
        'Electropositive membrane filter'
      ],
      '24': [
        'Softening filter (anti-scale protection)',
        'Sediment filter (5µm particles)',
        'Pre-Carbon block filter',
        'Ultra-fine membrane filter (0.01µm barrier)',
        'Electropositive membrane filter'
      ]
    };

    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        buttons.forEach(function(b) {
          b.classList.remove('border-2', 'border-[#088ae3]', 'bg-[#eff9fd]');
          b.classList.add('border', 'border-[#d9f1fc]', 'bg-white');
        });
        btn.classList.remove('border', 'border-[#d9f1fc]', 'bg-white');
        btn.classList.add('border-2', 'border-[#088ae3]', 'bg-[#eff9fd]');

        var m = btn.getAttribute('data-month');
        var price = btn.getAttribute('data-price');
        var name = btn.getAttribute('data-name');
        var tag = btn.getAttribute('data-tag');
        var term = btn.getAttribute('data-term');

        if (priceEl) priceEl.textContent = price;
        if (termEl) termEl.textContent = term;
        if (titleEl) titleEl.textContent = name;
        if (tagEl) tagEl.textContent = tag;
        if (orderBtn) {
          orderBtn.querySelector('span').textContent = 'BUY NOW — ' + price;
        }

        if (listEl && cartMap[m]) {
          listEl.innerHTML = cartMap[m].map(function(item) {
            return '<div class="flex items-center gap-2"><span class="text-[#088ae3] font-bold">✓</span> ' + item + '</div>';
          }).join('');
        }
      });
    });
  });
</script>

