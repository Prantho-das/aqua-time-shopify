<section id="how-it-works" class="section-spacing bg-[#f8fcfd] border-t border-[#e2f0f9]">
  <div class="container">
    
    <div class="max-w-2xl mb-12">
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#173b57]">
        {{ section.settings.heading | default: 'Air in. Water out.' }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="text-[#4a6177] text-[15px] mt-3 leading-relaxed max-w-xl">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      
      <div class="step-card space-y-3">
        <div class="flex items-center gap-3 mb-1">
          <div class="w-8 h-8 rounded-lg bg-[#eff9fd] text-[#088ae3] flex items-center justify-center shrink-0">
            {% render 'icon', name: 'wind', class: 'w-4 h-4' %}
          </div>
          <span class="text-xs font-semibold text-[#4a6177]">Step 1</span>
        </div>
        <h3 class="font-heading font-bold text-base text-[#173b57]">
          {{ section.settings.step1_title | default: 'Air enters the system' }}
        </h3>
        <p class="text-sm text-[#4a6177] leading-relaxed">
          {{ section.settings.step1_desc | default: 'The system pulls in outside air and filters out dust and other particles before collecting moisture.' }}
        </p>
      </div>

      <div class="step-card space-y-3">
        <div class="flex items-center gap-3 mb-1">
          <div class="w-8 h-8 rounded-lg bg-[#eff9fd] text-[#088ae3] flex items-center justify-center shrink-0">
            {% render 'icon', name: 'droplet', class: 'w-4 h-4' %}
          </div>
          <span class="text-xs font-semibold text-[#4a6177]">Step 2</span>
        </div>
        <h3 class="font-heading font-bold text-base text-[#173b57]">
          {{ section.settings.step2_title | default: 'Moisture is condensed' }}
        </h3>
        <p class="text-sm text-[#4a6177] leading-relaxed">
          {{ section.settings.step2_desc | default: 'The system cools humid air until the moisture turns into liquid water that can be collected.' }}
        </p>
      </div>

      <div class="step-card space-y-3">
        <div class="flex items-center gap-3 mb-1">
          <div class="w-8 h-8 rounded-lg bg-[#eff9fd] text-[#088ae3] flex items-center justify-center shrink-0">
            {% render 'icon', name: 'shield-check', class: 'w-4 h-4' %}
          </div>
          <span class="text-xs font-semibold text-[#4a6177]">Step 3</span>
        </div>
        <h3 class="font-heading font-bold text-base text-[#173b57]">
          {{ section.settings.step3_title | default: 'Water is treated' }}
        </h3>
        <p class="text-sm text-[#4a6177] leading-relaxed">
          {{ section.settings.step3_desc | default: 'The collected water goes through filtration and treatment processes designed to improve its quality.' }}
        </p>
      </div>

      <div class="step-card space-y-3">
        <div class="flex items-center gap-3 mb-1">
          <div class="w-8 h-8 rounded-lg bg-[#eff9fd] text-[#088ae3] flex items-center justify-center shrink-0">
            {% render 'icon', name: 'glass-water', class: 'w-4 h-4' %}
          </div>
          <span class="text-xs font-semibold text-[#4a6177]">Step 4</span>
        </div>
        <h3 class="font-heading font-bold text-base text-[#173b57]">
          {{ section.settings.step4_title | default: 'Ready to drink' }}
        </h3>
        <p class="text-sm text-[#4a6177] leading-relaxed">
          {{ section.settings.step4_desc | default: 'The treated water is stored in a tank, dispensed for use, or connected to another water system.' }}
        </p>
      </div>

    </div>

    <div class="mt-10 p-5 sm:p-6 rounded-xl bg-white border border-[#e2f0f9] flex flex-col md:flex-row items-start md:items-center justify-between gap-5">
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 rounded-lg bg-[#eff9fd] text-[#088ae3] flex items-center justify-center shrink-0">
          {% render 'icon', name: 'shield-check', class: 'w-4 h-4' %}
        </div>
        <div>
          <div class="text-xs font-semibold text-[#088ae3] mb-0.5">EPA validation</div>
          <p class="text-sm text-[#4a6177] leading-relaxed max-w-2xl">
            {{ section.settings.epa_note | default: "The EPA's assessment of AWGs documents systems using combinations of air filtration, condensation, storage, carbon filtration, sediment filtration, UV treatment, mineralization, and other treatment methods." }}
          </p>
        </div>
      </div>

      <a href="{{ section.settings.cta_link | default: '/pages/how-it-works' }}" class="shrink-0 btn-primary">
        {{ section.settings.cta_text | default: 'Explore the technology' }}
      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Air in. Water out." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Atmospheric water generation condenses airborne moisture and purifies it through multiple barrier stages into crisp, fresh water." },
    { "type": "text", "id": "step1_title", "label": "Step 1 Title", "default": "Air enters the system" },
    { "type": "textarea", "id": "step1_desc", "label": "Step 1 Description", "default": "The system pulls in outside air and filters out dust and other particles before collecting moisture." },
    { "type": "text", "id": "step2_title", "label": "Step 2 Title", "default": "Moisture is condensed" },
    { "type": "textarea", "id": "step2_desc", "label": "Step 2 Description", "default": "The system cools humid air until the moisture turns into liquid water that can be collected." },
    { "type": "text", "id": "step3_title", "label": "Step 3 Title", "default": "Water is treated" },
    { "type": "textarea", "id": "step3_desc", "label": "Step 3 Description", "default": "The collected water goes through filtration and treatment processes designed to improve its quality." },
    { "type": "text", "id": "step4_title", "label": "Step 4 Title", "default": "Ready to drink" },
    { "type": "textarea", "id": "step4_desc", "label": "Step 4 Description", "default": "The treated water is stored in a tank, dispensed for use, or connected to another water system." },
    { "type": "textarea", "id": "epa_note", "label": "EPA Note", "default": "The EPA's assessment of AWGs documents systems using combinations of air filtration, condensation, storage, carbon filtration, sediment filtration, UV treatment, mineralization, and other treatment methods." },
    { "type": "text", "id": "cta_text", "label": "CTA Button Text", "default": "Explore the technology" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" }
  ],
  "presets": [{ "name": "How It Works" }]
}
{% endschema %}
