<section id="how-it-works" class="py-16 sm:py-20 lg:py-24 bg-[#f8fcfd] border-t border-[#d9f1fc]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mx-auto text-center mb-14 sm:mb-16">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-widest text-[#088ae3] bg-[#eff9fd] border border-[#d9f1fc] uppercase mb-3 shadow-sm">
        Atmospheric Water Extraction
      </span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#173b57] tracking-tight">
        {{ section.settings.heading | default: 'Air in. Pure water out.' }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="text-[#4a6177] text-sm sm:text-base mt-4 leading-relaxed max-w-2xl mx-auto">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <div class="bg-white rounded-3xl p-6 sm:p-7 border border-[#d9f1fc] shadow-sm hover:shadow-md hover:border-[#088ae3]/50 transition-all space-y-4 relative group">
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-2xl bg-[#eff9fd] text-[#088ae3] group-hover:bg-[#088ae3] group-hover:text-white transition-colors flex items-center justify-center font-bold">
            {% render 'icon', name: 'wind', class: 'w-6 h-6' %}
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#088ae3] bg-[#eff9fd] px-3 py-1 rounded-full">Step 01</span>
        </div>
        <h3 class="font-heading font-bold text-lg text-[#173b57] pt-1">
          {{ section.settings.step1_title | default: 'Air enters the system' }}
        </h3>
        <p class="text-xs sm:text-sm text-[#4a6177] leading-relaxed">
          {{ section.settings.step1_desc | default: 'The system pulls in ambient air and filters out dust before collecting moisture.' }}
        </p>
      </div>

      <div class="bg-white rounded-3xl p-6 sm:p-7 border border-[#d9f1fc] shadow-sm hover:shadow-md hover:border-[#088ae3]/50 transition-all space-y-4 relative group">
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-2xl bg-[#eff9fd] text-[#088ae3] group-hover:bg-[#088ae3] group-hover:text-white transition-colors flex items-center justify-center font-bold">
            {% render 'icon', name: 'droplet', class: 'w-6 h-6' %}
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#088ae3] bg-[#eff9fd] px-3 py-1 rounded-full">Step 02</span>
        </div>
        <h3 class="font-heading font-bold text-lg text-[#173b57] pt-1">
          {{ section.settings.step2_title | default: 'Moisture is condensed' }}
        </h3>
        <p class="text-xs sm:text-sm text-[#4a6177] leading-relaxed">
          {{ section.settings.step2_desc | default: 'Specialized food-grade condensing modules cool humid air to the dew point, transforming vapor into liquid droplets.' }}
        </p>
      </div>

      <div class="bg-white rounded-3xl p-6 sm:p-7 border border-[#d9f1fc] shadow-sm hover:shadow-md hover:border-[#088ae3]/50 transition-all space-y-4 relative group">
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-2xl bg-[#eff9fd] text-[#088ae3] group-hover:bg-[#088ae3] group-hover:text-white transition-colors flex items-center justify-center font-bold">
            {% render 'icon', name: 'shield-check', class: 'w-6 h-6' %}
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#088ae3] bg-[#eff9fd] px-3 py-1 rounded-full">Step 03</span>
        </div>
        <h3 class="font-heading font-bold text-lg text-[#173b57] pt-1">
          {{ section.settings.step3_title | default: '8-Stage Purification' }}
        </h3>
        <p class="text-xs sm:text-sm text-[#4a6177] leading-relaxed">
          {{ section.settings.step3_desc | default: 'The water goes through 8 stages of filtration and UV, then light mineralization for taste.' }}
        </p>
      </div>

      <div class="bg-white rounded-3xl p-6 sm:p-7 border border-[#d9f1fc] shadow-sm hover:shadow-md hover:border-[#088ae3]/50 transition-all space-y-4 relative group">
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-2xl bg-[#eff9fd] text-[#088ae3] group-hover:bg-[#088ae3] group-hover:text-white transition-colors flex items-center justify-center font-bold">
            {% render 'icon', name: 'glass-water', class: 'w-6 h-6' %}
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#088ae3] bg-[#eff9fd] px-3 py-1 rounded-full">Step 04</span>
        </div>
        <h3 class="font-heading font-bold text-lg text-[#173b57] pt-1">
          {{ section.settings.step4_title | default: 'Ready to drink' }}
        </h3>
        <p class="text-xs sm:text-sm text-[#4a6177] leading-relaxed">
          {{ section.settings.step4_desc | default: 'The water is stored in the unit and dispensed hot or cold.' }}
        </p>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Air in. Water out." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Atmospheric water generation condenses airborne moisture and purifies it through multiple barrier stages into crisp, fresh water." },
    { "type": "text", "id": "step1_title", "label": "Step 1 Title", "default": "Air enters the system" },
    { "type": "textarea", "id": "step1_desc", "label": "Step 1 Description", "default": "The system pulls in outside air and filters out dust and other particles before collecting moisture." },
    { "type": "text", "id": "step2_title", "label": "Step 2 Title", "default": "Moisture is condensed" },
    { "type": "textarea", "id": "step2_desc", "label": "Step 2 Description", "default": "The system cools humid air until the moisture turns into liquid water that can be collected." },
    { "type": "text", "id": "step3_title", "label": "Step 3 Title", "default": "Water is treated" },
    { "type": "textarea", "id": "step3_desc", "label": "Step 3 Description", "default": "The collected water goes through filtration and treatment processes designed to improve its quality." },
    { "type": "text", "id": "step4_title", "label": "Step 4 Title", "default": "Ready to drink" },
    { "type": "textarea", "id": "step4_desc", "label": "Step 4 Description", "default": "The treated water is stored in a tank, dispensed for use, or connected to another water system." },
    { "type": "textarea", "id": "epa_note", "label": "EPA Note", "default": "The EPA's assessment of AWGs documents systems using combinations of air filtration, condensation, storage, carbon filtration, sediment filtration, UV treatment, mineralization, and other treatment methods." },
    { "type": "text", "id": "cta_text", "label": "CTA Button Text", "default": "Explore the technology" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" }
  ],
  "presets": [{ "name": "How It Works" }]
}
{% endschema %}
