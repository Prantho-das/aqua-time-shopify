<section id="why-awg" class="section-spacing bg-[#f8fcfd] border-y border-[#e2f0f9]">
  <div class="container">
    
    <div class="max-w-2xl mb-10">
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#173b57]">
        {{ section.settings.heading | default: 'Why atmospheric water generation?' }}
      </h2>

      <h3 class="font-heading text-lg font-semibold text-[#088ae3] mt-2">
        {{ section.settings.subheading | default: 'A different way to think about where water comes from' }}
      </h3>

      <div class="space-y-2 text-[15px] text-[#4a6177] leading-relaxed mt-3 max-w-xl">
        <p>{{ section.settings.paragraph_1 | default: 'Most water systems begin with a remote source. Water may travel through wells, treatment plants, pipelines, trucks, bottles, storage tanks, or distribution infrastructure before reaching the people who use it.' }}</p>
        <p>{{ section.settings.paragraph_2 | default: 'Atmospheric water generation introduces another possibility: produce water closer to the point of use by utilizing moisture already present in the surrounding air.' }}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {% for block in section.blocks %}
        <div class="app-card group" {{ block.shopify_attributes }}>
          <div class="h-48 overflow-hidden relative bg-slate-100">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500" loading="lazy">
            {% elsif block.settings.asset_image != blank %}
              <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title | escape }}" class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500" loading="lazy">
            {% endif %}
          </div>

          <div class="p-6 space-y-2">
            <h3 class="font-heading font-bold text-lg text-[#173b57] group-hover:text-[#088ae3] transition-colors">
              {{ block.settings.title }}
            </h3>
            <p class="text-sm text-[#4a6177] leading-relaxed">
              {{ block.settings.description }}
            </p>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Why AWG",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why atmospheric water generation?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "A different way to think about where water comes from" },
    { "type": "textarea", "id": "paragraph_1", "label": "Paragraph 1", "default": "Most water systems begin with a remote source. Water may travel through wells, treatment plants, pipelines, trucks, bottles, storage tanks, or distribution infrastructure before reaching the people who use it." },
    { "type": "textarea", "id": "paragraph_2", "label": "Paragraph 2", "default": "Atmospheric water generation introduces another possibility: produce water closer to the point of use by utilizing moisture already present in the surrounding air." }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Custom Image" },
        { "type": "text", "id": "asset_image", "label": "Asset Image Filename", "default": "office-02.jpg" },
        { "type": "text", "id": "title", "label": "Title", "default": "Produce water on-site" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Reduce dependence on transporting every gallon of water from somewhere else." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why AWG",
      "blocks": [
        { "type": "feature_card", "settings": { "asset_image": "office-02.jpg", "title": "Produce water on-site", "description": "Reduce dependence on transporting every gallon of water from somewhere else." } },
        { "type": "feature_card", "settings": { "asset_image": "emergency-response-02.jpg", "title": "Build water resilience", "description": "Add another potential water source where interruptions, shortages, or remote locations make water availability more difficult." } },
        { "type": "feature_card", "settings": { "asset_image": "environment-01.jpg", "title": "Reduce bottled water dependence", "description": "For appropriate applications, on-site generation may help decrease dependence on recurring bottled-water purchases and deliveries." } }
      ]
    }
  ]
}
{% endschema %}
