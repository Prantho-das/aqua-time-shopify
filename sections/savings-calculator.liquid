<section id="calculator" class="section-spacing bg-white">
  <div class="container">
    
    <div class="bg-[#f8fcfd] border border-[#e2f0f9] rounded-2xl p-6 sm:p-10 lg:p-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-5">
          <div>
            <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#173b57]">
              {{ section.settings.heading | default: 'Do the math' }}
            </h2>
            <p class="text-[#4a6177] text-[15px] mt-2 leading-relaxed max-w-lg">
              {{ section.settings.description | default: 'Compare your current bottled water and delivery costs against AWG on-site generation at only ≈5 to 9 kWh per gallon plus filters.' }}
            </p>
          </div>

          <div class="space-y-5 bg-white p-5 sm:p-6 rounded-xl border border-[#e2f0f9]">
            <div>
              <div class="flex justify-between items-center mb-2">
                <label for="daily-gallons" class="text-sm font-semibold text-[#173b57]">Daily water usage</label>
                <span id="daily-gallons-val" class="text-sm font-bold text-[#088ae3]">5 gal/day</span>
              </div>
              <input id="daily-gallons" type="range" min="1" max="25" value="5" step="1" class="custom-range">
              <div class="flex justify-between text-[11px] text-[#4a6177] mt-1.5">
                <span>1 gal (solo)</span>
                <span>5 gal (family)</span>
                <span>25 gal (commercial)</span>
              </div>
            </div>

            <div>
              <div class="flex justify-between items-center mb-2">
                <label for="cost-per-gallon" class="text-sm font-semibold text-[#173b57]">Current cost per gallon</label>
                <span id="cost-per-gallon-val" class="text-sm font-bold text-[#088ae3]">$1.50/gal</span>
              </div>
              <input id="cost-per-gallon" type="range" min="0.5" max="3.5" value="1.50" step="0.25" class="custom-range">
              <div class="flex justify-between text-[11px] text-[#4a6177] mt-1.5">
                <span>$0.50 (tap filter)</span>
                <span>$1.50 (delivery)</span>
                <span>$3.50 (single bottles)</span>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="bg-[#173b57] text-white rounded-2xl p-6 sm:p-8 space-y-6 shadow-xl border border-white/10">
            
            <div class="border-b border-white/10 pb-5">
              <div class="text-xs font-semibold uppercase tracking-wider text-slate-300 mb-3">Estimated Annual Cost</div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <div class="text-xs text-slate-400 font-medium">Bottled Water</div>
                  <div id="calc-current-annual" class="font-heading text-xl sm:text-2xl font-bold text-slate-200 mt-1">$2,738/yr</div>
                </div>
                <div>
                  <div class="text-xs text-slate-400 font-medium">AWG Electricity</div>
                  <div id="calc-awg-annual" class="font-heading text-xl sm:text-2xl font-bold text-white mt-1">$146/yr</div>
                </div>
              </div>
            </div>

            <div class="bg-white/[0.07] border border-white/10 rounded-2xl p-5 text-center space-y-2">
              <div class="text-xs font-semibold uppercase tracking-wider text-sky-300">Estimated Net Savings</div>
              <div id="calc-net-savings" class="font-heading text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
                $2,592/yr
              </div>
              <div id="calc-payback" class="inline-block text-xs text-sky-200 bg-sky-500/20 px-3 py-1 rounded-full font-medium">
                Machine pays for itself in ~6.9 months
              </div>
            </div>

            <button class="open-quote-modal w-full bg-[#088ae3] hover:bg-[#0776c4] text-white font-bold py-3.5 px-6 rounded-xl shadow-lg shadow-[#088ae3]/30 transition-all text-sm flex items-center justify-center">
              {{ section.settings.btn_text | default: 'Claim your AWG unit — $1,495' }}
            </button>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  (function() {
    var dailyInput = document.getElementById('daily-gallons');
    var costInput = document.getElementById('cost-per-gallon');
    if (!dailyInput || !costInput) return;
    var dailyVal = document.getElementById('daily-gallons-val');
    var costVal = document.getElementById('cost-per-gallon-val');
    var currentAnnual = document.getElementById('calc-current-annual');
    var awgAnnual = document.getElementById('calc-awg-annual');
    var netSavings = document.getElementById('calc-net-savings');
    var payback = document.getElementById('calc-payback');

    function updateTrack(s) {
      var min = parseFloat(s.min) || 0, max = parseFloat(s.max) || 100, val = parseFloat(s.value) || 0;
      var pct = ((val - min) / (max - min)) * 100;
      s.style.background = 'linear-gradient(to right, #088ae3 0%, #088ae3 ' + pct + '%, #e2e8f0 ' + pct + '%, #e2e8f0 100%)';
    }

    function calc() {
      var g = parseFloat(dailyInput.value) || 5;
      var c = parseFloat(costInput.value) || 1.5;
      dailyVal.textContent = g + ' gal/day';
      costVal.textContent = '$' + c.toFixed(2) + '/gal';
      updateTrack(dailyInput);
      updateTrack(costInput);
      var ab = g * c * 365;
      var aa = g * 0.55 * 0.145 * 365 + 120;
      var sv = Math.max(0, ab - aa);
      currentAnnual.textContent = '$' + Math.round(ab).toLocaleString() + '/yr';
      awgAnnual.textContent = '$' + Math.round(aa).toLocaleString() + '/yr';
      netSavings.textContent = '$' + Math.round(sv).toLocaleString() + '/yr';
      if (sv > 0) {
        payback.textContent = 'Machine pays for itself in ~' + (1495 / (sv / 12)).toFixed(1) + ' months';
      } else {
        payback.textContent = 'AWG gives you independence from bottled supply';
      }
    }

    dailyInput.addEventListener('input', calc);
    costInput.addEventListener('input', calc);
    calc();
  })();
</script>

{% schema %}
{
  "name": "Savings Calculator",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Do the math" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Compare your current bottled water and delivery costs against AWG on-site generation at only ≈5 to 9 kWh per gallon plus filters." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Claim your AWG unit — $1,495" }
  ],
  "presets": [{ "name": "Savings Calculator" }]
}
{% endschema %}
