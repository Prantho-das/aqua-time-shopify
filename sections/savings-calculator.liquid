{%- liquid
  assign hydro_product = all_products['hydrocell-standup']
  assign filter_product = all_products['filter-replacement-kits']
  if filter_product != blank and filter_product.price > 0
    assign filter_kit_cost = filter_product.price | divided_by: 100
  else
    assign filter_kit_cost = 100
  endif
-%}

<section id="calculator" class="section-spacing bg-white">
  <div class="container">
    
    <div class="bg-[#f8fcfd] border border-[#e2f0f9] rounded-2xl p-6 sm:p-10 lg:p-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <div class="lg:col-span-6 space-y-5">
          <div>
            <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#173b57]">
              {{ section.settings.heading | default: 'Do the math' }}
            </h2>
            <p class="text-[#4a6177] text-[15px] mt-2 leading-relaxed max-w-lg">
              {{ section.settings.description | default: 'Compare what you pay for bottled or delivered water with what it costs to make it at home.' }}
            </p>
          </div>

          <div class="space-y-6 bg-white p-5 sm:p-6 rounded-2xl border border-[#e2f0f9] shadow-xs">
            <div>
              <div class="flex justify-between items-center mb-2">
                <label for="daily-usage" class="text-sm font-bold text-[#173b57]">Daily water usage</label>
                <output id="daily-usage-out" for="daily-usage" class="text-sm sm:text-base font-bold text-[#088ae3]">2 gal/day</output>
              </div>
              <input id="daily-usage" type="range" min="0.5" max="5" step="0.5" value="2" class="custom-range w-full accent-[#088ae3] cursor-pointer">
              <div class="flex justify-between text-[11px] sm:text-xs text-[#4a6177] mt-1.5 font-medium">
                <span>1 gal (1 to 2 people)</span>
                <span>2.5 gal (family)</span>
                <span>5 gal (office)</span>
              </div>
            </div>

            <div>
              <div class="flex justify-between items-center mb-2">
                <label for="gallon-price" class="text-sm font-bold text-[#173b57]">Current cost per gallon</label>
                <output id="gallon-price-out" for="gallon-price" class="text-sm sm:text-base font-bold text-[#088ae3]">$1.75 / gal</output>
              </div>
              <input id="gallon-price" type="range" min="0.75" max="3.50" step="0.25" value="1.75" class="custom-range w-full accent-[#088ae3] cursor-pointer">
              <div class="flex justify-between text-[11px] sm:text-xs text-[#4a6177] mt-1.5 font-medium">
                <span>$1.25 (store jugs)</span>
                <span>$1.75 (delivery)</span>
                <span>$2.50 (bottles)</span>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="bg-[#173b57] text-white rounded-3xl p-6 sm:p-8 space-y-6 shadow-xl border border-white/10" aria-live="polite" aria-label="Your estimate">
            
            <div>
              <div class="text-[11px] font-bold uppercase tracking-wider text-sky-200/80 mb-4">Estimated annual cost</div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="bg-white/5 rounded-xl p-3 border border-white/5">
                  <div class="text-xs text-sky-100 font-medium">Bottled water</div>
                  <div id="calc-today-cost" class="font-heading text-lg sm:text-xl font-bold text-white mt-1">$0 / yr</div>
                  <small id="calc-today-note" class="block text-[10px] text-sky-200/70 mt-1">2 gal × $1.75 × 365 days</small>
                </div>
                <div class="bg-white/5 rounded-xl p-3 border border-white/5">
                  <div class="text-xs text-sky-100 font-medium">HydroCell electricity</div>
                  <div id="calc-elec-cost" class="font-heading text-lg sm:text-xl font-bold text-white mt-1">$0 / yr</div>
                  <small class="block text-[10px] text-sky-200/70 mt-1">about 1.6 kWh per gallon at $0.18/kWh</small>
                </div>
                <div class="bg-white/5 rounded-xl p-3 border border-white/5">
                  <div class="text-xs text-sky-100 font-medium">HydroCell filters</div>
                  <div id="calc-filter-cost" class="font-heading text-lg sm:text-xl font-bold text-white mt-1">${{ filter_kit_cost | times: 2 }} / yr</div>
                  <small class="block text-[10px] text-sky-200/70 mt-1">two kits a year</small>
                </div>
              </div>
            </div>

            <hr class="border-white/10">

            <div class="bg-[#223f5c] border border-white/10 rounded-2xl p-5 text-center space-y-1.5">
              <div class="text-[11px] font-bold uppercase tracking-wider text-[#8fc6f0]">Estimated net savings</div>
              <div id="calc-keep-savings" class="font-heading text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
                $0 / yr
              </div>
              <p id="calc-soft-message" class="text-xs text-sky-200 pt-1 hidden leading-relaxed">
                At this usage, HydroCell is about convenience and water quality more than savings.
              </p>
            </div>

            <div>
              <button class="open-quote-modal w-full bg-[#088ae3] hover:bg-[#0776c4] text-white font-bold py-3.5 px-6 rounded-xl shadow-lg shadow-[#088ae3]/30 transition-all text-sm flex items-center justify-center tracking-wide" type="button" aria-haspopup="dialog">
                {%- if hydro_product != blank -%}
                  Order now, {{ hydro_product.price | money_without_trailing_zeros }}
                {%- else -%}
                  {{ section.settings.btn_text | default: 'Order now, $1,495' }}
                {%- endif -%}
              </button>
              <p class="text-[11px] text-sky-200/70 text-center mt-3 leading-normal">
                Estimates at 80°F and 80% humidity. Output depends on temperature and humidity.
              </p>
            </div>

          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  (function() {
    var FILTER_KIT = {{ filter_kit_cost }};
    var WATTS = 300, RATE = 0.18, OUTPUT = 4.45;
    var KWH_PER_GAL = (WATTS * 24 / 1000) / OUTPUT;
    
    var usageInput = document.getElementById('daily-usage');
    var priceInput = document.getElementById('gallon-price');
    if (!usageInput || !priceInput) return;

    var usageOut = document.getElementById('daily-usage-out');
    var priceOut = document.getElementById('gallon-price-out');
    var todayNote = document.getElementById('calc-today-note');
    var todayEl = document.getElementById('calc-today-cost');
    var elecEl = document.getElementById('calc-elec-cost');
    var filtersEl = document.getElementById('calc-filter-cost');
    var keepEl = document.getElementById('calc-keep-savings');
    var softEl = document.getElementById('calc-soft-message');

    function money(n) {
      return '$' + Math.round(n).toLocaleString('en-US');
    }

    function render() {
      var usage = parseFloat(usageInput.value) || 2;
      var price = parseFloat(priceInput.value) || 1.75;
      var galYear = usage * 365;
      var today = galYear * price;
      var elec = galYear * KWH_PER_GAL * RATE;
      var filters = FILTER_KIT * 2;
      var keep = today - elec - filters;

      usageOut.textContent = usage + ' gal/day';
      priceOut.textContent = '$' + price.toFixed(2) + ' / gal';
      todayNote.textContent = usage + ' gal × $' + price.toFixed(2) + ' × 365 days';
      todayEl.textContent = money(today) + ' / yr';
      elecEl.textContent = money(elec) + ' / yr';
      filtersEl.textContent = money(filters) + ' / yr';

      if (keep > 0) {
        keepEl.textContent = money(keep) + ' / yr';
        softEl.classList.add('hidden');
      } else {
        keepEl.textContent = '$0 / yr';
        softEl.classList.remove('hidden');
      }
    }

    usageInput.addEventListener('input', render);
    priceInput.addEventListener('input', render);
    render();
  })();
</script>

{% schema %}
{
  "name": "Savings Calculator",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Do the math" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Compare what you pay for bottled or delivered water with what it costs to make it at home." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Order now, $1,495" }
  ],
  "presets": [{ "name": "Savings Calculator" }]
}
{% endschema %}
