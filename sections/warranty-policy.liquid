<div class="warranty-page bg-white">
  
  <section class="relative bg-gradient-to-b from-[#eff9fd] via-[#f8fcfd] to-white pt-20 pb-12 sm:pt-28 sm:pb-16 text-center border-b border-[#d9f1fc]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-[#088ae3] bg-[#eff9fd] border border-[#d9f1fc] px-4 py-1.5 rounded-full mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-[#088ae3]"></span>
        {{ section.settings.badge | default: 'Protection & Guarantee' }}
      </span>
      <h1 class="font-heading text-3xl sm:text-5xl lg:text-6xl font-extrabold text-[#173b57] tracking-tight leading-[1.08]">
        {{ section.settings.heading | default: 'Warranty & Refund Policy' }}
      </h1>
      <p class="mt-4 sm:mt-5 text-[15px] sm:text-lg text-[#4a6177] leading-relaxed max-w-2xl mx-auto">
        {{ section.settings.subheading | default: 'Our commitment to quality engineering, reliable component coverage, and straightforward customer service.' }}
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16 bg-[#f8fcfd]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        <div class="bg-white rounded-3xl p-7 border border-[#d9f1fc] shadow-sm text-center space-y-2.5 hover:shadow-md hover:border-[#088ae3]/40 transition-all">
          <div class="w-10 h-10 mx-auto rounded-2xl bg-[#eff9fd] text-[#088ae3] flex items-center justify-center font-bold">
            {% render 'icon', name: 'shield-check', class: 'w-5 h-5' %}
          </div>
          <span class="text-xs font-bold text-[#088ae3] uppercase tracking-wider block">Comprehensive Unit</span>
          <span class="font-heading font-extrabold text-2xl text-[#173b57] block">1-Year Warranty</span>
          <p class="text-xs text-[#4a6177] leading-relaxed">
            Covers the complete machine against defects in materials and manufacturing from delivery date.
          </p>
        </div>

        <div class="bg-white rounded-3xl p-7 border border-[#d9f1fc] shadow-sm text-center space-y-2.5 hover:shadow-md hover:border-[#088ae3]/40 transition-all">
          <div class="w-10 h-10 mx-auto rounded-2xl bg-[#eff9fd] text-[#088ae3] flex items-center justify-center font-bold">
            {% render 'icon', name: 'zap', class: 'w-5 h-5' %}
          </div>
          <span class="text-xs font-bold text-[#088ae3] uppercase tracking-wider block">Extended Component Protection</span>
          <span class="font-heading font-extrabold text-2xl text-[#173b57] block">3-Year Core Parts</span>
          <p class="text-xs text-[#4a6177] leading-relaxed">
            Compressor, condenser, evaporator, water tanks, and fans. Defective parts replaced free of charge; labor not included.
          </p>
        </div>

        <div class="bg-white rounded-3xl p-7 border border-[#d9f1fc] shadow-sm text-center space-y-2.5 hover:shadow-md hover:border-[#088ae3]/40 transition-all">
          <div class="w-10 h-10 mx-auto rounded-2xl bg-[#eff9fd] text-[#088ae3] flex items-center justify-center font-bold">
            {% render 'icon', name: 'check-circle', class: 'w-5 h-5' %}
          </div>
          <span class="text-xs font-bold text-[#088ae3] uppercase tracking-wider block">Return Policy</span>
          <span class="font-heading font-extrabold text-2xl text-[#173b57] block">7-Day Returns</span>
          <p class="text-xs text-[#4a6177] leading-relaxed">
            Unopened units in original factory-sealed packaging can be returned within 7 days of delivery.
          </p>
        </div>
      </div>

      <div class="bg-white rounded-3xl border border-[#d9f1fc] p-8 sm:p-12 lg:p-14 shadow-sm space-y-10 mb-16">
        
        <div class="space-y-4">
          <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-[#173b57]">
            1. Warranty Coverage Details
          </h2>
          <p class="text-sm text-[#4a6177] leading-relaxed">
            Air to Water Generators stands behind the craftsmanship of every system. Your HydroCell™ unit is backed by our standard 1-Year Warranty on the whole unit, plus extended 3-Year coverage on core mechanical and refrigeration components.
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
            <div class="bg-[#f8fcfd] p-6 rounded-2xl border border-[#d9f1fc] space-y-2">
              <span class="font-heading font-bold text-base text-[#173b57] block">Whole Unit Coverage (1 Year)</span>
              <p class="text-xs text-[#4a6177] leading-relaxed">
                Applies to all electronics, control panels, sensors, and structural housing against manufacturing flaws when operated under recommended temperature and humidity conditions.
              </p>
            </div>

            <div class="bg-[#f8fcfd] p-6 rounded-2xl border border-[#d9f1fc] space-y-2">
              <span class="font-heading font-bold text-base text-[#173b57] block">Core Parts Coverage (3 Years)</span>
              <p class="text-xs text-[#4a6177] leading-relaxed">
                Covers the compressor, condenser coils, evaporator coils, internal water tanks, and circulating fans. Defective components are replaced free of charge. Diagnostic and installation labor is not included.
              </p>
            </div>
          </div>
        </div>

        <div class="space-y-4 pt-6 border-t border-[#d9f1fc]">
          <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-[#173b57]">
            2. Return & Refund Policy
          </h2>
          <p class="text-sm text-[#4a6177] leading-relaxed">
            We offer a 7-day return period for unopened units. Because atmospheric water generators are precision indoor hygiene and hydration appliances, safety regulations require specific return criteria:
          </p>
          <ul class="space-y-2 text-xs sm:text-sm text-[#4a6177] list-disc pl-5">
            <li>Return requests must be initiated within 7 calendar days of tracked delivery confirmation.</li>
            <li>Units must be unopened, brand new in their original factory packaging with all internal foam, seals, power cords, and accessory kits intact.</li>
            <li>Opened or water-tested units cannot be accepted for return due to sanitary and cross-contamination standards for drinking water appliances.</li>
            <li>To initiate a return, contact our support team at <a href="mailto:contact@airtowatergenerators.com" class="text-[#088ae3] font-bold underline">contact@airtowatergenerators.com</a> or via our <a href="/pages/contact" class="text-[#088ae3] font-bold underline">contact form</a> to receive Return Merchandise Authorization (RMA) instructions.</li>
          </ul>
        </div>

        <div class="space-y-4 pt-6 border-t border-[#d9f1fc]">
          <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-[#173b57]">
            3. Exclusions & Maintenance
          </h2>
          <p class="text-sm text-[#4a6177] leading-relaxed">
            The warranty does not cover:
          </p>
          <ul class="space-y-2 text-xs sm:text-sm text-[#4a6177] list-disc pl-5">
            <li>Routine consumable items, including periodic water filter replacement cartridges and UV lamps.</li>
            <li>Damage caused by accidents, unauthorized modifications, unapproved repair attempts, or outdoor exposure outside specified operating thresholds.</li>
            <li>Failure resulting from improper electrical supply, power surges, or lack of standard filter replacements as guided by on-screen maintenance notifications.</li>
          </ul>
        </div>

      </div>

      <div class="bg-white rounded-3xl p-8 sm:p-10 border border-[#d9f1fc] shadow-sm max-w-4xl mx-auto space-y-4 text-center">
        <h3 class="font-heading text-xl sm:text-2xl font-bold text-[#173b57]">
          Questions About Warranty or Service?
        </h3>
        <p class="text-xs sm:text-sm text-[#4a6177] leading-relaxed max-w-2xl mx-auto">
          Our team is here to assist with parts replacement, return authorizations, and troubleshooting guidance.
        </p>
        <div class="pt-2 flex flex-wrap items-center justify-center gap-4">
          <a href="/pages/contact" class="btn-primary py-2.5 px-6 text-xs font-bold">
            Contact Support Team
          </a>
          <a href="/pages/how-it-works" class="text-xs font-bold text-[#088ae3] hover:text-[#0776c4] flex items-center gap-1.5 py-2">
            Explore System Specifications →
          </a>
        </div>
      </div>

    </div>
  </section>

</div>

{% schema %}
{
  "name": "Warranty Policy",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Protection & Guarantee"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Warranty & Refund Policy"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our commitment to quality engineering, reliable component coverage, and straightforward customer service."
    }
  ],
  "presets": [
    {
      "name": "Warranty Policy"
    }
  ]
}
{% endschema %}
